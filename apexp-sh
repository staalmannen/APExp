#!/bin/rc
# set up a shell running the APExp environment
# APExp must already have been built for $cputype
#
#	./apexp-sh		the environment, with bash as the shell
#	./apexp-sh -r		the same environment, with rc as the shell
#	./apexp-sh -v		the environment, then straight into vts-bash
#
# WHY -v EXISTS.
#
# Starting a vts session took two commands and the first one did
# nothing but set up a namespace: `./apexp-sh' and then `vts-bash'.
# -v does both, and it drops back into the shell afterwards rather
# than exiting -- vts-bash prints the server's whole log on the way
# out, and a window that closes on it makes that log unreadable.
#
# WHY -r EXISTS. IT IS NOW A FALLBACK, NOT A PREFERENCE.
#
# libap's select() does not POLL a descriptor -- it forks a copy
# process that reads it CONTINUOUSLY, into a shared buffer, for as long
# as the process lives (ap/plan9/_buf.c, _startbuf/_copyproc). bash is
# interactive, so readline calls select() on fd 0, so this bash had a
# process of its own permanently reading the window's /dev/cons.
#
# That is invisible while bash is the only thing in the window. It was
# NOT invisible when bash ran a program that reads the console itself:
# both were then blocked in a read on the same file, and the kernel
# handed each keystroke to exactly ONE of them. Under `vts-bash' that
# showed up as characters silently vanishing -- `echo $SHELL' reaching
# the session as `hoLL' -- with vts and libap measured exact and the
# bytes simply never arriving.
#
# rc does not use select(), so `-r' has no copy process and no thief.
# $SHELL stays `bash' either way, so a vts session still runs bash;
# only the LAUNCHING shell changes.
#
# **THE LIBAP BUG IS FIXED** -- terminals are read ON DEMAND now, one
# outstanding read per request instead of one for ever (the
# `ondemand'/`want'/`readwait' fields in Muxbuf; _bufmark() is the
# version marker). CONFIRMED from a plain `apexp-sh': a whole session
# typed clean with no -r anywhere.
#
# So -r is kept for one purpose, and it is a good one: if input ever
# goes missing again, `-r works and plain apexp-sh does not' separates
# the copy process from every other explanation in a single command.
# A workaround that survives as a bisecting tool is worth the eight
# lines.
ip/ipconfig loopback /dev/null 127.1
rfork en
fn sigterm{}
HOME=$home
PATH=/bin
LC_ALL = C.UTF-8
LC_CTYPE = C.UTF-8
LC_NUMERIC = C.UTF-8
LC_COLLATE = C.UTF-8
LC_TIME = C.UTF-8
LC_MESSAGES = C.UTF-8
LC_MONETARY = C.UTF-8
LANG = C.UTF-8
TCLPATH="/sys/lib/tcl"
AWKLIB="/sys/lib/ape/awk"
M4PATH="/sys/lib/ape/m4"
MANPATH="/sys/man"
LOCALEDIR="/sys/lib/ape/locale"
LIBTOOL=slibtool-static
SHELL=bash
LD=pcc
test -d /dev/fd || aux/stub -d /dev/fd && bind /fd /dev/fd
./mount-include
bind -b $cputype/bin /bin
bind -b rc/bin /bin
bind -b rc/bin/ape /bin
bind -b $cputype/bin/ape /bin

# The shell for THIS window. $SHELL above is what vts execs inside a
# session and is deliberately left as bash.
if(~ $1 -v v vts){
	# vts-bash is on the path because of the rc/bin bind above.
	#
	# Run it, THEN fall through to the shell. vts-bash ends by
	# printing the whole of /tmp/vts.log, which is where every
	# answer about a session that misbehaved lives; exec'ing it
	# would close the window on that output the moment vtwin
	# exits, which is the one thing worth reading.
	vts-bash
	echo
	echo 'apexp-sh: vts-bash finished; this is the launching shell.'
	echo 'apexp-sh: run vts-bash again to reattach or start over.'
}
if(~ $1 -r r rc){
	echo 'apexp-sh: rc as the launching shell. This is a FALLBACK --'
	echo 'apexp-sh: the copy-process bug it worked around is fixed, and'
	echo 'apexp-sh: plain ./apexp-sh is confirmed clean. Keep it for'
	echo 'apexp-sh: bisecting: if keystrokes go missing again, -r'
	echo 'apexp-sh: working and plain apexp-sh not is the split.'
	echo 'apexp-sh: $SHELL is still bash, so vts-bash still runs bash.'
	exec rc -i
}
exec bash -l
