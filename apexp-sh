#!/bin/rc
# set up a shell running the APExp environment
# APExp must already have been built for $cputype
rfork en
fn sigterm{}
HOME=$home
# bash does not see rc's $path, and without PATH it falls back to
# whatever was compiled in -- which is why "which" reports "$PATH is not
# set" and why any program that looks a command up by PATH is at the
# mercy of that default. /bin is the union everything below is bound
# into, so it is the whole answer here.
PATH=/bin
LC_ALL = C.UTF-8
LC_CTYPE = C.UTF-8
LC_NUMERIC = C.UTF-8
LC_COLLATE = C.UTF-8
LC_TIME = C.UTF-8
LC_MESSAGES = C.UTF-8
LC_MONETARY = C.UTF-8
LANG = C.UTF-8
TCLPATH="/sys/lib/tcl"
AWKLIB="/sys/lib/ape/awk"
M4PATH="/sys/lib/ape/m4"
MANPATH="/sys/man"
LOCALEDIR="/sys/lib/ape/locale"
LIBTOOL=slibtool-static
SHELL=bash
LD=pcc
test -d /dev/fd || aux/stub -d /dev/fd && bind /fd /dev/fd
./mount-include
bind -b $cputype/bin /bin
bind -b rc/bin /bin
bind -b rc/bin/ape /bin
bind -b $cputype/bin/ape /bin
/bin/bash $*
