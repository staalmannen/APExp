#!/bin/rc
if(! test -e /sys/include/ape/THIS_IS_APExp) {
    bind -b sys/lib /sys/lib
	bind -b sys/man /sys/man
    bind -b sys/include /sys/include
    bind -b $cputype/include/ape /$cputype/include/ape
    bind -b $cputype/include/ape /sys/include/ape
	bind -b $cputype/lib /$cputype/lib
    bind -b $cputype/lib/ape /$cputype/lib/ape
    bind -b sys/include/ape /sys/include/ape
    bind -b $cputype/bin /bin
    bind -a $cputype/bin/ape /bin
    bind -a rc/bin/ape /bin
    echo "APExp mounted"
    }
if not echo "APExp already mounted"

