#!/bin/rc
# vts-bash -- start bash under vts in a vtwin window, or attach to one.
#
# RUN THIS FROM INSIDE apexp-sh. That is not a convenience, it is the
# whole mechanism:
#
#   - apexp-sh does `bind -b $cputype/bin /bin', which is what puts
#     vts, vtwin and vts-attach on the path at all;
#   - and `bind -b $cputype/bin/ape /bin', which is what puts bash
#     there;
#   - and it sets SHELL=bash, which is how vts knows what to exec
#     (sys/src/cmd2/vts/session.c, shellpath()).
#
# vts forks the shell with RFNAMEG and RFENVG, both of which COPY, so
# the shell inherits that namespace and that environment. Started from
# a plain rc, none of the three is true and vts falls back to /bin/rc.
#
# PREFER `./apexp-sh -r' FOR THIS, AND THE REASON IS MEASURED.
#
# An interactive bash calls select() on fd 0, and libap's select()
# forks a copy process that reads that descriptor CONTINUOUSLY for as
# long as the process lives. So a bash window has a second process
# permanently reading its /dev/cons -- and while vtwin is running,
# vtwin and that copy process are both blocked reading the same
# console, with the kernel handing each keystroke to exactly one of
# them. Typing `echo $SHELL' reached the session as `hoLL'; the log
# showed vts and libap exact and the bytes simply never arriving.
#
# `./apexp-sh -r' gives the same environment with rc as the launching
# shell. rc does not use select(), so there is no copy process and no
# competition. $SHELL is still bash, so the SESSION still runs bash.
#
# ------------------------------------------------------------------
# A MOUNT LIVES IN A NAMESPACE, AND THAT IS WHY THIS SCRIPT MOUNTS.
#
# /srv/vts is visible everywhere -- /srv is global -- but what you get
# by MOUNTING it is not. apexp-sh begins with `rfork en', so every
# apexp-sh window has a namespace of its own, and a mount made in one
# is invisible in the next. `lc /n/vts' in another window shows
# nothing, and that is CORRECT rather than a sign the server is broken.
#
# So a session's files are reachable from exactly three places:
#
#   /mnt/<sess>/...    inside the session's own shell -- vts mounts there
#   /n/vts/<sess>/...  in THIS window, because of the mount below
#   /n/vts/<sess>/...  in vtwin's window, which mounts for itself
#
# Asking for `cat /n/vts/1/ctl' without saying which window is asking
# for nothing. That was the instruction, and this is the fix.

fn fail {
	echo 'vts-bash: '^$"* >[1=2]
	exit fail
}

# Where vts's own output goes. See the note beside the start below.
vtslog=/tmp/vts.log

# Turn on vts's terminal tracing. Only the shell touches `tty' -- the
# viewers write `cons' and poll `cells' -- so this is three or four
# lines at startup, not a flood, and it is the difference between
# "the shell exited" and knowing whether it ever read anything.
#
#   1  the terminal trace above
#   2  that plus lib9p's chatty9p, every T- and R-message
#
# ONLY IF IT IS NOT ALREADY SET, and that `if' is the whole point of
# these three lines. `vtsdebug=2 ./vts-bash' was run to turn chatty9p
# on; this script then assigned 1 over it, the trace came back without
# a single 9P message in it, and the one instrument that could answer
# the open question had been switched off by the script written to
# switch it on. *A script that sets the variable its caller passes is
# an instrument that overwrites its own input.*
if(~ $#vtsdebug 0)
	vtsdebug=1
echo 'vts-bash: vtsdebug='^$vtsdebug

# The one readout worth having. `ctl' carries raw= and lined=, which
# together say whether the shell ever reached tcsetattr -- and that is
# the difference between "the terminal works" and "two things are
# echoing into one VT parser".
fn report {
	echo
	echo 'vts-bash: session state ----------------------------------'
	cat /n/vts/1/ctl >[2]/dev/null
	echo -n 'vts-bash:   ttyctl says: '
	cat /n/vts/1/ttyctl >[2]/dev/null
	echo 'vts-bash:   rawon  = the shell reached tcsetattr, so isatty'
	echo 'vts-bash:            was true, readline started, and lined is'
	echo 'vts-bash:            out of the way.'
	echo 'vts-bash:   rawoff = it did not. Look above for a consctl bind'
	echo 'vts-bash:            complaint; without it, expect double echo.'
	echo 'vts-bash: ----------------------------------------------------'
	echo
}

# 1. Inside apexp-sh? The test is the binds, not $SHELL -- a variable
#    can be set by hand and prove nothing, while the binds are what
#    actually decide whether the exec finds anything.
if(! test -e /bin/bash)
	fail 'no /bin/bash -- run this from inside ./apexp-sh'
if(! test -e /bin/vts)
	fail 'no /bin/vts -- run this from inside ./apexp-sh, and build sys/src/cmd2'
if(! test -e /bin/vtwin)
	fail 'no /bin/vtwin -- build sys/src/cmd2'

# 2. $SHELL is what vts reads. Say so rather than letting a session of
#    rc come up looking like a broken bash.
if(~ $#SHELL 0)
	fail 'SHELL is not set, so vts would exec /bin/rc; apexp-sh sets it'
echo 'vts-bash: shell is '^$SHELL

# 3. Already running? ATTACH rather than refuse.
#
#    Posting a second vts under the same name replaces the first, and
#    that looks exactly like the new one having failed -- so this used
#    to stop with an error. But attaching is almost always what was
#    meant, and refusing left no way forward that did not involve
#    knowing which process to kill.
#
#    IT IS STILL WORTH READING. An attached window shows the session as
#    it is, INCLUDING a session started by an older vts: if the binary
#    was rebuilt since, the running server is the old code, and every
#    conclusion drawn from that window is about the old code.
mine=yes
if(test -e /srv/vts){
	mine=no
	echo 'vts-bash: /srv/vts exists -- ATTACHING to the vts already running.'
	echo 'vts-bash: if you rebuilt vts since it started, that server is the'
	echo 'vts-bash: OLD binary, and so is everything you see. To replace it:'
	echo 'vts-bash:     kill vts | rc ; rm -f /srv/vts'
}
if not {
	# vts talks to fd 2 about what it is doing -- which shell it
	# forked, where the tty is, any bind that failed, and (under
	# $vtsdebug) every byte the shell exchanged with its terminal.
	#
	# IT GOES TO A FILE, and that is not tidiness. vtwin's window
	# opens over this one, so the most interesting lines -- the ones
	# printed in the second before the session appears -- were being
	# read off a PHOTOGRAPH of the screen. A log that outlives the
	# window can be read at leisure, twice, and pasted.
	echo 'vts-bash: starting vts, log in '^$vtslog
	vts >[2]$vtslog &
	vtspid=$apid

	# Wait for the post rather than racing it: vtwin exits if
	# /srv/vts is not there yet, and losing that race reads as a
	# vtwin bug.
	#
	# TWO rc FACTS, both learned the hard way in one run:
	#   - `sleep' takes WHOLE SECONDS. `sleep 0.1' sleeps zero and
	#     turns a wait into a spin.
	#   - **rc HAS NO `break'.** It is not a keyword, so rc went
	#     looking for a command called break and printed
	#     "./vts-bash:111: break: file does not exist" once per
	#     iteration. A flag is the way to leave a loop early; the
	#     remaining turns then cost one `test' each.
	got=no
	for(i in 1 2 3 4 5){
		if(~ $got no){
			if(test -e /srv/vts)
				got=yes
			if not
				sleep 1
		}
	}
	if(! test -e /srv/vts)
		fail 'vts did not post /srv/vts within 5s -- read its output above'
	echo 'vts-bash: /srv/vts posted'
}

# 4. Mount it HERE, so this window can read the session's files at all.
#    See the namespace note at the top: without this, /n/vts is empty
#    in every window but vtwin's.
if(! mount -c /srv/vts /n/vts)
	fail 'could not mount /srv/vts on /n/vts'

# 5. Give the shell a moment to reach its first prompt, then say what
#    state the terminal is in. This is the whole point of mounting: the
#    answer arrives without anyone having to know where to look.
sleep 1
report

# 6. And the window. vtwin mounts /srv/vts for itself.
#
#    NOT AT $vtsdebug=2, and that is about what the log would be worth.
#    chatty9p prints every T- and R-message, and vtwin POLLS `cells'
#    several times a second -- so the startup exchange, which is the
#    whole question, would be at the top of a file with thousands of
#    Tread/Rread pairs after it. The shell is forked when vts starts,
#    with or without a viewer, and it has been dying before the window
#    ever mattered; so at level 2 this waits instead, and the log holds
#    exactly the conversation being asked about.
if(~ $vtsdebug 2){
	echo 'vts-bash: $vtsdebug=2 -- NOT starting vtwin.'
	echo 'vts-bash: its cells polling would bury the startup exchange'
	echo 'vts-bash: in chatty9p output. Waiting for the shell instead.'
	sleep 3
}
if not {
	echo 'vts-bash: starting vtwin (close the window to finish)'
	vtwin
}

# 7. Again on the way out -- the interesting state is usually the one
#    after something went wrong, not the one a second after boot --
#    and then the log, which by now has the whole conversation between
#    the shell and its terminal in it.
report
if(test -e $vtslog){
	echo 'vts-bash: ---- '^$vtslog^' ----'
	cat $vtslog
	echo 'vts-bash: ---- end of log ----'
}

if(~ $mine yes){
	# `kill' on Plan 9 PRINTS the commands to do it, for piping into
	# a shell; the note is what actually does it, so write it direct.
	echo 'vts-bash: stopping the vts this script started'
	if(test -e /proc/$vtspid/note)
		echo kill >/proc/$vtspid/note
	rm -f /srv/vts
}
if not
	echo 'vts-bash: vtwin exited; leaving the vts that was already running'
