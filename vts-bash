#!/bin/rc
# vts-bash -- start bash under vts, in a vtwin window.
#
# RUN THIS FROM INSIDE apexp-sh. That is not a convenience, it is the
# whole mechanism:
#
#   - apexp-sh does `bind -b $cputype/bin /bin', which is what puts
#     vts, vtwin and vts-attach on the path at all;
#   - and `bind -b $cputype/bin/ape /bin', which is what puts bash
#     there;
#   - and it sets SHELL=bash, which is how vts knows what to exec
#     (sys/src/cmd2/vts/session.c, shellpath()).
#
# vts forks the shell with RFNAMEG and RFENVG, both of which COPY, so
# the shell inherits that namespace and that environment. Started from
# a plain rc, none of the three is true and vts falls back to /bin/rc.
#
# Every check below is here because its failure is silent or reads as
# something else. Nothing in this script is decoration.

fn fail {
	echo 'vts-bash: '^$"* >[1=2]
	exit fail
}

# 1. Inside apexp-sh? The test is the two binds, not $SHELL -- a
#    variable can be set by hand and prove nothing, while the binds are
#    what actually decides whether the exec finds anything.
if(! test -e /bin/bash)
	fail 'no /bin/bash -- run this from inside ./apexp-sh'
if(! test -e /bin/vts)
	fail 'no /bin/vts -- run this from inside ./apexp-sh, and build sys/src/cmd2'
if(! test -e /bin/vtwin)
	fail 'no /bin/vtwin -- build sys/src/cmd2'

# 2. $SHELL is what vts reads. Say so rather than letting a session of
#    rc come up looking like a broken bash.
if(~ $#SHELL 0)
	fail 'SHELL is not set, so vts would exec /bin/rc; apexp-sh sets it'
echo 'vts-bash: shell is '^$SHELL

# 3. Is a vts already posted? Starting a second one is not an error --
#    it posts under the same name and the first is replaced, which
#    looks exactly like the new one having failed.
if(test -e /srv/vts)
	fail '/srv/vts already exists; `rm /srv/vts'' or attach to it with vtwin'

# 4. Start it. vts talks to fd 2 about what it is doing -- which pipes
#    it made, which shell it forked, where the tty is -- and that is
#    the log to read when a session comes up blank, so it is left
#    pointed at this window rather than /dev/null.
echo 'vts-bash: starting vts...'
vts &
vtspid=$apid

# 5. Wait for the post rather than racing it. vtwin exits if
#    /srv/vts is not there yet, and the race is won often enough that
#    losing it reads as a vtwin bug.
#    (Plan 9's sleep takes WHOLE SECONDS -- `sleep 0.1' sleeps zero and
#    turns this into a spin. Hence five one-second tries rather than
#    fifty tenths.)
for(i in 1 2 3 4 5){
	if(test -e /srv/vts)
		break
	sleep 1
}
if(! test -e /srv/vts)
	fail 'vts did not post /srv/vts within 5s -- read its output above'
echo 'vts-bash: /srv/vts posted'

# 6. And the window. vtwin mounts /srv/vts itself.
echo 'vts-bash: starting vtwin (close the window to finish)'
vtwin

# 7. Tear down, so a second run does not trip check 3.
#    `kill' on Plan 9 PRINTS the commands to do it, for piping into a
#    shell; the note is what actually does it, so write it directly.
echo 'vts-bash: vtwin exited, stopping vts'
if(test -e /proc/$vtspid/note)
	echo kill >/proc/$vtspid/note
rm -f /srv/vts
