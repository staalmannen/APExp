> /*
>  * VLA frame management for i386.
>  *
>  * gvla_prologue – called at function entry when vlanest > 0:
>  *   pushl %ebp
>  *   movl  %esp, %ebp
>  *
>  * gvla_epilogue – called before every RET when vlanest > 0:
>  *   movl  %ebp, %esp
>  *   popl  %ebp
>  *
>  * gret – wrapper for gbranch(ORETURN) that inserts the epilogue first.
>  */
> void
> gvla_prologue(void)
> {
> 	Node nbp, nsp;
> 
> 	nodreg(&nbp, &regnode, D_BP);
> 	nodreg(&nsp, &regnode, D_SP);
> 	reg[D_BP]++;
> 	gins(APUSHL, &nbp, Z);
> 	gmove(&nsp, &nbp);
> }
> 
> void
> gvla_epilogue(void)
> {
> 	Node nbp, nsp;
> 
> 	nodreg(&nbp, &regnode, D_BP);
> 	nodreg(&nsp, &regnode, D_SP);
> 	gmove(&nbp, &nsp);
> 	gins(APOPL, &nbp, Z);
> 	reg[D_BP]--;
> }
> 
> void
> gret(void)
> {
> 	if(vlanest > 0)
> 		gvla_epilogue();
> 	gbranch(ORETURN);
> }
