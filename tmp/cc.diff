> 	if(t->etype == TARRAY)
> 		return typ(TIND, t->link);
> 	/* function decay */
> 	if(t->etype == TFUNC)
> 		return typ(TIND, t);
> 	/* strip qualifiers for matching */
> 	if(t->garb & (GCONSTNT|GVOLATILE)) {
> 		Type *u = copytyp(t);
> 		u->garb &= ~(GCONSTNT|GVOLATILE);
> 		return u;
> 	}
> 	return t;
> }
