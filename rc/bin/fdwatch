#!/bin/rc
# fdwatch -- sample a process's open descriptors while it runs.
#
#	fdwatch -c <command> [args...]	start it, watch it, log it
#	fdwatch <pid>			watch a process already running
#	fdwatch -n <name>		find it by name (see the warning)
#
# $fdwinterval sets the sampling period in seconds (default 2) and
# $fdwlog the log file (default /tmp/fdwatch.log). They are variables
# rather than positional arguments because -c has to swallow the whole
# rest of the line.
#
# **PREFER -c.** It starts the program itself, so there is no race to
# win and no guess about which process is meant:
#
#	THIS_SH=bash fdwatch -c /bin/bash run-all
#
# WHY -c EXISTS, AND WHY -n IS DANGEROUS.
#
# The first version of this script had only -n, and it was wrong twice
# over in one line.
#
#  1. A process that libap has buffered a descriptor for has a COPY
#     PROCESS, forked by _startbuf, and that child has THE SAME NAME.
#     `ps' during a bash session shows
#
#	1709  1080K Rendez  bash      <- the shell
#	1710  1052K Pread   bash      <- its copy process
#
#     -- the parent blocked in a rendezvous, the copy process inside
#     _READ. **The old -n took the LAST match**, which is the copy
#     process: it holds almost nothing, so the count would have been
#     flat and the run would have reported NO LEAK. *A measurement of
#     the wrong process is not a null result, it is a false one.*
#
#  2. Finding a short-lived process by name is a race the user has to
#     win by hand, and the answer is worth nothing if they lose it.
#
# So -n now prints EVERY match with its state and size and stops
# unless there is exactly one. Naming the ambiguity is the whole
# point; picking silently is what went wrong.
#
# WHY /proc/<pid>/fd RATHER THAN COUNTING DEBUG LINES.
#
# The plan recorded for the bash descriptor leak was to run with
# $APEXP_DEBUG=1 and count `select: buffered now fd=' lines. **That
# can only confirm what it assumes**: it counts BUFFERING EVENTS, so
# if the descriptors turn out to be ordinary open()s, or pipes, or
# something of bash's own, it reports zero -- and zero would read as
# exoneration. A check whose negative result has two explanations is
# not a check.
#
# /proc/<pid>/fd lists every open descriptor of a live process WITH
# ITS PATH. It answers *what* rather than *whether*.
#
# READING THE OUTPUT.
#
# Each sample prints the total, then paths grouped and counted,
# commonest first. In order of what to look for:
#
#   - a count that RISES MONOTONICALLY. One that rises and falls is a
#     busy shell, not a leak -- and if the count is flat while the
#     kernel still warns, the warning is about a DIFFERENT process
#     and this is the wrong pid.
#   - ONE path repeated many times: that names the call site.
#   - many DISTINCT paths under one directory ($TMPDIR, say): a
#     create/unlink loop whose descriptors are never closed.
#   - pipes with a large count: pipe(), popen(), or a here-document.
#
# The first line of /proc/<pid>/fd is the process's CWD, not a
# descriptor, which is why the count below subtracts one.
#
# LIMITS, so they are not discovered as surprises.
#
# Sampling is not tracing: a descriptor opened and closed between two
# samples is invisible. That is correct here -- it is not leaking --
# but it means this says WHAT leaks, never WHERE it was opened. Once
# a path is named, `ratrace' on the same program narrows it to the
# call; ratrace on a whole suite is unreadable, which is why this
# comes first.
#
# The process usually dies at the end and takes /proc/<pid> with it,
# so the LOG is the artefact rather than the screen, and the last
# sample before it vanishes is the interesting one.

fn usage {
	echo 'usage: fdwatch -c <command> [args...]   (preferred)' >[1=2]
	echo '       fdwatch <pid>' >[1=2]
	echo '       fdwatch -n <name>' >[1=2]
	echo '$fdwinterval seconds (default 2), $fdwlog file' >[1=2]
	exit usage
}

if(~ $#* 0)
	usage

if(~ $#fdwinterval 0)
	fdwinterval=2
if(~ $#fdwlog 0)
	fdwlog=/tmp/fdwatch.log

cmd=()
pid=()

if(~ $1 -c){
	shift
	if(~ $#* 0)
		usage
	cmd=$*
}
if not if(~ $1 -n){
	if(~ $#* 1)
		usage
	name=$2

	# Every match, with its state and size, and no silent choice.
	# The awk program is built by rc concatenation rather than with
	# -v: `=' is a SYNTAX CHARACTER in rc, so a bare name=value
	# argument is parsed as an assignment and rejected outright
	# (`token '=': syntax error'). Same family as the {} vs () vs ''
	# rule -- rc's quoting is not the shell's.
	pids=`{ps | awk '$NF == "'^$name^'" {print $2}'}
	if(~ $#pids 0){
		echo 'fdwatch: no process called '^$name >[1=2]
		exit nopid
	}
	if(! ~ $#pids 1){
		echo 'fdwatch: '^$#pids^' processes are called '^$name^':' >[1=2]
		ps | awk '$NF == "'^$name^'"' >[1=2]
		echo >[1=2]
		echo 'fdwatch: REFUSING TO GUESS. A buffered descriptor gives' >[1=2]
		echo 'fdwatch: its process a COPY PROCESS of the same name --' >[1=2]
		echo 'fdwatch: the parent sits in Rendez, the copy process in' >[1=2]
		echo 'fdwatch: Pread -- and watching the copy process reports a' >[1=2]
		echo 'fdwatch: flat count, which reads as "no leak".' >[1=2]
		echo 'fdwatch: Pass the pid, or use -c and avoid the question.' >[1=2]
		exit ambiguous
	}
	pid=$pids
	echo 'fdwatch: '^$name^' is pid '^$pid
}
if not {
	pid=$1
}

if(! ~ $#cmd 0){
	# Start it ourselves. No race, and $apid is the pid beyond doubt
	# -- which also means the copy processes it forks later are not
	# candidates, because we never have to search for it.
	echo 'fdwatch: running: '^$"cmd
	$cmd &
	pid=$apid
	echo 'fdwatch: pid '^$pid
	# One second so /proc/<pid> exists before the first sample; the
	# program has barely started, which is the baseline worth having.
	sleep 1
}

if(! test -e /proc/$pid/fd){
	echo 'fdwatch: /proc/'^$pid^'/fd does not exist -- no such process,' >[1=2]
	echo 'fdwatch: or it is not yours to look at' >[1=2]
	exit noproc
}

echo 'fdwatch: watching pid '^$pid^', every '^$fdwinterval^'s, into '^$fdwlog

{
	echo '==== fdwatch pid='^$pid^' started '^`{date}
	# Say WHAT was watched: a log that does not name its subject
	# reads exactly like one that does.
	if(test -e /proc/$pid/args)
		echo 'args: '^`{cat /proc/$pid/args}
	echo
} >> $fdwlog

# rc has no `break', and `sleep' takes whole seconds -- both learned
# the hard way in vts-bash. A flag leaves the loop; the loop ends when
# the process does.
running=yes
while(~ $running yes){
	if(test -e /proc/$pid/fd){
		{
			echo '---- '^`{date}
			# -1 for the cwd line at the top, which is not a
			# descriptor. Getting that wrong would report an
			# off-by-one leak that is not there.
			echo 'total descriptors: '^`{
				sed 1d /proc/$pid/fd | wc -l
			}
			# Field 10 onwards is the name; the earlier fields
			# are the fd number, mode and qid. One repeated path
			# is the whole answer when it appears.
			sed 1d /proc/$pid/fd | awk '{
				name = $10
				for(i = 11; i <= NF; i++)
					name = name " " $i
				if(name == "")
					name = "(unnamed)"
				print name
			}' | sort | uniq -c | sort -nr
			echo
		} >> $fdwlog
		sleep $fdwinterval
	}
	if not {
		running=no
		{
			echo '==== process '^$pid^' is gone, '^`{date}
			echo
		} >> $fdwlog
		echo 'fdwatch: pid '^$pid^' exited; log in '^$fdwlog
	}
}
