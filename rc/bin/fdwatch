#!/bin/rc
# fdwatch -- sample a process's open descriptors while it runs.
#
#	fdwatch -c <command> [args...]	start it, watch it, summarise
#	fdwatch <pid>			watch a process already running
#	fdwatch -n <name>		find it by name (see the warning)
#	fdwatch -s [logfile]		re-summarise a log, watching nothing
#
# $fdwinterval is the sampling period in SECONDS, default **0**, which
# means as fast as the loop goes round. $fdwlog is the log, default
# /tmp/fdwatch.log. They are variables rather than arguments because
# -c has to swallow the rest of the line.
#
#	THIS_SH=bash fdwatch -c /bin/bash run-all
#
# WHY IT DUMPS RAW AND ANALYSES AFTERWARDS.
#
# The first working version slept a second before its first sample and
# then did six forks per sample -- sed, wc, awk, sort, uniq, sort -- to
# group the paths. **bash's test suite exhausts its descriptors and
# dies in well under a second**, so that version's log was empty and
# its only output was
#
#	/proc/4314/fd does not exist -- no such process
#
# Both halves were wrong. Sleeping BEFORE the first sample throws away
# the one moment guaranteed to exist, and analysing inside the loop
# makes the instrument slower than the thing it measures. *An
# instrument whose sampling period exceeds the lifetime of its subject
# measures nothing, and says so in a way that reads like a missing
# process.*
#
# So the loop now does the least it can -- one `cat' per sample,
# appended raw -- and the grouping happens once at the end, over the
# log. `-s' re-runs just that part, so a log can be re-read without
# re-running anything.
#
# WHY -c, AND WHY -n IS DANGEROUS.
#
# A process that libap has buffered a descriptor for has a COPY
# PROCESS, forked by _startbuf, and it has THE SAME NAME. `ps' during
# a bash session shows
#
#	1709  1080K Rendez  bash      <- the shell
#	1710  1052K Pread   bash      <- its copy process
#
# and an earlier -n took the LAST match, which is the copy process: it
# holds almost nothing, so the count would have been flat and the run
# would have reported NO LEAK. *A measurement of the wrong process is
# not a null result, it is a false one.* -n now prints every match and
# refuses to choose. -c avoids the question entirely, and avoids the
# race of finding a short-lived process by hand.
#
# WHY /proc/<pid>/fd RATHER THAN COUNTING DEBUG LINES.
#
# The plan recorded for this leak was $APEXP_DEBUG=1 and counting
# `select: buffered now fd=' lines. That counts BUFFERING EVENTS, so
# it measures the hypothesis: if the descriptors are ordinary open()s,
# pipes, or something of bash's own, it reports zero -- and zero would
# read as exoneration. /proc/<pid>/fd lists every open descriptor WITH
# ITS PATH, so it answers *what* rather than *whether*.
#
# READING THE SUMMARY, in order of what to look for:
#
#   - a count that RISES MONOTONICALLY. Rising and falling is a busy
#     shell. FLAT while the kernel still warns means the descriptors
#     are in the CHILDREN, not here, and `ps | grep bash | wc -l'
#     during the run is the next question.
#   - ONE path repeated many times: that names the call site.
#   - many DISTINCT paths under one directory: a create/unlink loop.
#   - pipes with a large count: pipe(), popen(), or a here-document.
#
# The first line of /proc/<pid>/fd is the CWD, not a descriptor, which
# is why the counts below subtract one.
#
# **IT CANNOT WATCH A PROCESS THAT DIES IN UNDER ~3 FORKS, AND THAT
# IS A PROPERTY OF rc RATHER THAN OF THE TUNING.** Measured: with -c
# and no sleep at all, `bash run-all' was already gone at the first
# `test -e' -- 0 samples, though the pid was right (fdwatch said 5579
# and the kernel's warnings said `bash 5579'). Between the fork and
# the first read this script must run `date', `echo' and `test', each
# a fork and exec, and rc has no way to read a file without one.
#
# So for a subject that lives milliseconds, reach for **ratrace**
# instead -- it runs the command under control from the first
# instruction, so there is no race to lose:
#
#	ratrace /bin/bash run-all >[2] /tmp/rt.log
#	grep -c ' open' /tmp/rt.log
#	grep -c ' close' /tmp/rt.log
#
# The difference between those two counts is the leak, and the `open'
# lines name the paths. ratrace on a long suite is unreadable, which
# is why it was second before -- but *a run that dies in under a
# second is not a long suite*, and that is what changed.
#
# fdwatch remains the right tool for the case it was built for: a
# long-lived process, such as the full `mk install' this leak was
# first seen in.
#
# LIMITS. Sampling is not tracing: this says WHAT is open, never where
# it was opened. Once a path is named, `ratrace' narrows it to the
# call; ratrace on a whole suite is unreadable, which is why it is
# second. And the process usually dies at the end, so the LOG is the
# artefact -- the last sample before it vanishes is the interesting
# one.

fn usage {
	echo 'usage: fdwatch -c <command> [args...]   (preferred)' >[1=2]
	echo '       fdwatch <pid>' >[1=2]
	echo '       fdwatch -n <name>' >[1=2]
	echo '       fdwatch -s [logfile]' >[1=2]
	echo '$fdwinterval seconds (default 0 = flat out), $fdwlog file' >[1=2]
	exit usage
}

if(~ $#* 0)
	usage
if(~ $#fdwinterval 0)
	fdwinterval=0
if(~ $#fdwlog 0)
	fdwlog=/tmp/fdwatch.log

# The summary. Reads the raw log, so it works after the fact and can
# be re-run; the loop above it stays as cheap as possible.
fn summarise {
	if(! test -e $fdwlog){
		echo 'fdwatch: no '^$fdwlog >[1=2]
		return
	}
	echo
	echo 'fdwatch: ---- descriptor count per sample ----'
	# -1 per sample for the cwd line. A sample with 0 descriptors is
	# a process that died mid-read; printed rather than hidden.
	awk '
	/^==== fdwatch sample/ {
		if(n > 0) printf "  sample %d: %d descriptors\n", s, n-1
		s++; n = 0; next
	}
	/^====/ { next }
	{ n++ }
	END { if(n > 0) printf "  sample %d: %d descriptors\n", s, n-1 }
	' $fdwlog

	echo
	echo 'fdwatch: ---- paths in the LAST sample, commonest first ----'
	# The last sample is the one just before the process vanished,
	# which is where a leak is largest and clearest.
	awk '
	/^==== fdwatch sample/ { delete L; k = 0; first = 1; next }
	/^====/ { next }
	{ if(first) { first = 0; next }   # cwd line, not a descriptor
	  L[k++] = $0 }
	END {
		for(i = 0; i < k; i++){
			name = ""
			nf = split(L[i], f, " ")
			for(j = 10; j <= nf; j++)
				name = (name == "" ? f[j] : name " " f[j])
			if(name == "")
				name = "(unnamed)"
			c[name]++
		}
		for(nm in c)
			printf "%6d  %s\n", c[nm], nm
	}
	' $fdwlog | sort -nr
	echo
}

if(~ $1 -s){
	if(! ~ $#* 1)
		fdwlog=$2
	summarise
	exit 0
}

cmd=()
pid=()

if(~ $1 -c){
	shift
	if(~ $#* 0)
		usage
	cmd=$*
}
if not if(~ $1 -n){
	if(~ $#* 1)
		usage
	name=$2
	# Built by concatenation rather than `awk -v name=$name': `=' is
	# a SYNTAX CHARACTER in rc, so a bare name=value argument is
	# parsed as an assignment and rejected -- `token '=': syntax
	# error'. Not the shell's quoting.
	pids=`{ps | awk '$NF == "'^$name^'" {print $2}'}
	if(~ $#pids 0){
		echo 'fdwatch: no process called '^$name >[1=2]
		exit nopid
	}
	if(! ~ $#pids 1){
		echo 'fdwatch: '^$#pids^' processes are called '^$name^':' >[1=2]
		ps | awk '$NF == "'^$name^'"' >[1=2]
		echo 'fdwatch: REFUSING TO GUESS -- a buffered descriptor' >[1=2]
		echo 'fdwatch: gives its process a COPY PROCESS of the same' >[1=2]
		echo 'fdwatch: name (parent in Rendez, copy in Pread), and' >[1=2]
		echo 'fdwatch: watching the copy process reports a flat count,' >[1=2]
		echo 'fdwatch: which reads as "no leak". Pass the pid, or -c.' >[1=2]
		exit ambiguous
	}
	pid=$pids
	echo 'fdwatch: '^$name^' is pid '^$pid
}
if not {
	pid=$1
}

rm -f $fdwlog

if(! ~ $#cmd 0){
	echo 'fdwatch: running: '^$"cmd
	$cmd &
	pid=$apid
	echo 'fdwatch: pid '^$pid
	# **NO SLEEP HERE.** The subject may live well under a second --
	# bash's test suite exhausts its descriptors and dies in less
	# than one -- and a sleep before the first sample throws away the
	# only moment certain to exist.
}

# `^' in rc is a CROSS PRODUCT, not string concatenation:
# 'x'^(a b c) is `xa xb xc'. `{date} is a LIST of six words, so
# '...pid='^$pid^' '^`{date} wrote the whole prefix six times --
# `==== fdwatch pid=5579 Sun ==== fdwatch pid=5579 Sep ...'.
# Separate arguments to echo instead; nothing is concatenated
# with a list.
echo '==== fdwatch pid='^$pid `{date} >> $fdwlog

# rc has no `break', and `sleep' takes whole seconds -- both learned in
# vts-bash. A flag leaves the loop; the loop ends when the process
# does. ONE fork per sample, and nothing else: the analysis is
# summarise(), over the log, afterwards.
running=yes
nsamp=0
while(~ $running yes){
	if(test -e /proc/$pid/fd){
		echo '==== fdwatch sample' >> $fdwlog
		cat /proc/$pid/fd >> $fdwlog >[2]/dev/null
		nsamp=`{echo $nsamp 1 + p | dc}
		if(! ~ $fdwinterval 0)
			sleep $fdwinterval
	}
	if not {
		running=no
	}
}

echo '==== gone' `{date} >> $fdwlog
echo 'fdwatch: pid '^$pid^' exited after '^$nsamp^' samples; log in '^$fdwlog
if(~ $nsamp 0){
	echo 'fdwatch: NO SAMPLES -- the process was gone before the first' >[1=2]
	echo 'fdwatch: read. With -c that should not happen; without it,' >[1=2]
	echo 'fdwatch: the pid was already dead. Use -c.' >[1=2]
}
summarise
