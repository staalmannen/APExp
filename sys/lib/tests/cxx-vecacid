#!/bin/rc
# cxx-vecacid -- crash cpfe on the twelve-line reproducer and ask
# `acid' where.
#
#	./cxx-vecacid
#
# ***WHY NOW AND NOT BEFORE.***  `acid' was tried once on this port
# and gave nothing, and that was correct: the crash then was
# `pc=0x1', and `src()' on an address that is not code cannot answer.
# **This crash has a real code address** (`pc=0x9d98a6'), so `src(pc)'
# can name the line in EDG's generated C -- which is how every other
# crash in this tree was finally read (`acid 6.out' and `src(pc)'
# named `zend_string.h:401' outright).
#
# And the input is now twelve lines instead of 2.9M, so the crash is
# reached in about a second and the stack is short.
#
# WHAT THE LADDER HAS ALREADY RULED OUT, so that the stack is read
# against the right background:
#
#   * NOT the C++ in `<vector>': `g++ -E' over the crashing form and
#     over an absolute-path rebuild gives byte-identical token
#     streams, 6428 lines each.
#   * NOT the include SPELLING: phase C2 CRASHES with every include
#     rewritten absolute.
#   * NOT `niter_base.h' as an envelope: phase D answers `ok' for all
#     five of its own includes.
#   * NOT a self-referential trailing return type:
#     `cxx-niterbase-probe.cpp' answers `ok'.
#   * NOT "a guard plus enough files": `cxx-guardgen' answers `ok' on
#     all four arms -- 300 flat and 150 chained generated headers,
#     with and without the guard.
#
# **What is left is the guard AND the content together**, which is
# why guessing further is worth less than one stack.
#
# ***AND THE STACK ANSWERED, SO THE PARAGRAPH ABOVE IS HISTORY.***
# `free_memory_region+0x21' under `fe_wrapup', `mem_manage.c:1208',
# which is `next_hdr = hdr->next' with `hdr == 0x3f4a1'.  **So this is
# TEARDOWN and not parsing** -- cpfe finishes the translation and dies
# freeing its memory regions -- and *six rounds of narrowing had all
# been looking at the front end*.  Everything in the elimination list
# above is still true and none of it was ever about the right phase.
#
# What the ladder is for NOW is one question: **which entry of the
# chain is bad.**
#
# ***AND A POST-MORTEM WALK CANNOT ANSWER IT, WHICH TOOK A RUN TO
# LEARN.***  `free_mem_block' pushes every visited block onto
# `reusable_blocks_list', overwriting its `next'; the table head is
# cleared only after the loop.  So walking from `mem_region_table[0]'
# after the fault follows the reusable list, and the run that did so
# printed **33 flawless entries** -- `start' exactly `hdr+0x30', each
# `end' equal to the next entry's `hdr', `msize' 0 for a carved
# sub-block and 0x10000 for its parent.  *A healthy chain, about the
# wrong object.*  **The loop destroys its own evidence as it goes**,
# which is why `free_memory_region' now records five globals and this
# script reads them first.
#
# A note on the printing: acid's `\X' is 32-bit hex, so every value
# here is displayed truncated to its low half.  That is harmless
# because the heap and the table are both under 4GB on this platform
# -- but it is the reason not to read a stack address out of this
# output.
#
# READING WHAT IT PRINTS.  This tree's own rule:
# ***`acid's `lstk()' MISREADS ARGUMENTS in an APExp amd64 binary and
# the first one is ALWAYS garbage***, because kencc's `REGARG' is
# `D_BP' and `acid' reads every parameter from the frame.  So trust
# the CALL CHAIN and `regs()`; treat argument values as a hint.  The
# tell that you are looking at a misread is a 4-byte parameter coming
# back as eight.

CXXDIR=/sys/include/ape/c++
VEC=$CXXDIR/vector/vector.h
MIN=/tmp/cxx-vecmin.cpp

# ***IT TAKES AN INPUT FILE NOW, AND THE REASON IS THAT THE CRASH
# MOVED.***  The split_buffer rename fix got cpfe past the three
# errors in `cxx-library-test.cpp', and the run that followed faulted
# at `pc=0x90c3a1 addr=0x3f4cd' -- *a different code address* from
# `free_memory_region's `0x9da331', with `chain-bad-at = -1'.  So the
# twelve-line reproducer is no longer the only crashing input and a
# ladder hardwired to it cannot reach the other one.
#
#	./cxx-vecacid				the minimised <vector> case
#	./cxx-vecacid cxx-library-test.cpp	any other input
#
# With an argument the `-I' is NOT added: the minimum is a copy of
# `vector.h' and needs its own directory on the path, an ordinary
# program does not, and adding it anyway would put a header directory
# ahead of itself.
EXTRA=()
if(! ~ $#* 0){
	MIN=$1
	if(! test -f $MIN){
		echo 'cxx-vecacid: no such file: '^$MIN >[1=2]
		exit usage
	}
	echo 'cxx-vecacid: using the input named on the command line'
}
if(~ $#* 0){
	EXTRA=('-I'^$CXXDIR^/vector)
}

# Prefer the file `cxx-vecsplit' phase C left behind, because that one
# is MEASURED to crash.  Regenerating is a fallback and says so: a
# reproducer rebuilt from a recollection is the mistake phase C itself
# made, one round ago.
if(~ $#* 0 && test -f $MIN){
	echo 'cxx-vecacid: using '^$MIN^' from cxx-vecsplit'
}
if(~ $#* 0 && ! test -f $MIN){
	echo 'cxx-vecacid: no '^$MIN^'; rebuilding the known minimum'
	echo 'cxx-vecacid: (run cxx-vecsplit first if this does not crash)'
	echo '#ifndef PSTL_VECTOR_H' > $MIN
	echo '#define PSTL_VECTOR_H' >> $MIN
	echo '#include "../algorithm/equal.h"' >> $MIN
	echo '#include "../algorithm/fill_n.h"' >> $MIN
	echo '#include "../algorithm/lexicographical_compare.h"' >> $MIN
	echo '#include "../algorithm/min.h"' >> $MIN
	echo '#include "../algorithm/rotate.h"' >> $MIN
	echo '#include "../iterator/niter_base.h"' >> $MIN
	echo '#endif' >> $MIN
	echo 'int main(void){ return 0; }' >> $MIN
}
echo
cat $MIN
echo

tmp=/tmp/cxx-vecacid.$pid
mkdir -p $tmp

echo 'cxx-vecacid: running cpfe'
c++ -F $EXTRA $MIN >$tmp/out >[2]$tmp/err
echo
cat $tmp/err

# `cpfe NNNN: suicide: sys: trap: ...' -- the pid is the second word.
# A faulted Plan 9 process stays BROKEN in /proc, which is what makes
# this work at all.
# **ONE extraction, not two.**  The first draft had a `sed' with
# `([0-9]+)' as a fallback behind this -- which is ERE written into a
# BRE tool, so it matches a literal paren and never fires.  A
# fallback that cannot fire is not a fallback; it is a second thing
# to read wrongly when the first fails.
crashpid=`{grep -E 'suicide|trap:' $tmp/err | sed 1q | awk '{print $2}' | sed 's/://'}
if(~ $#crashpid 0){
	echo
	echo 'cxx-vecacid: NO CRASH.'
	echo 'cxx-vecacid:'
	echo 'cxx-vecacid: ***THAT IS THE EXPERIMENT ANSWERING, NOT A BROKEN'
	echo 'cxx-vecacid: REPRODUCER.***  EDG_DBG_CARVE_PAD moves the carved'
	echo 'cxx-vecacid: header 64 bytes out of the way, and the prediction'
	echo 'cxx-vecacid: written down before the run was that cpfe would then'
	echo 'cxx-vecacid: complete.  It did.'
	echo 'cxx-vecacid:'
	echo 'cxx-vecacid: **The measurement is the `edg-pad:` lines above**,'
	echo 'cxx-vecacid: not the silence.  The pad is dead space owned by'
	echo 'cxx-vecacid: nobody and filled with 0xA5, so a dirty byte in it'
	echo 'cxx-vecacid: is the overrun caught in the act -- with its count,'
	echo 'cxx-vecacid: its offset, and the parent object size that names'
	echo 'cxx-vecacid: what ran past.  *An absence of crashes says only'
	echo 'cxx-vecacid: that nothing landed on a chain link; a dirtied'
	echo 'cxx-vecacid: canary says the write happened.*'
	echo 'cxx-vecacid:'
	echo 'cxx-vecacid: dirty=0 with a nonzero carve count would REFUTE the'
	echo 'cxx-vecacid: overrun reading and say the pad merely moved the'
	echo 'cxx-vecacid: layout -- set EDG_DBG_CARVE_PAD to 0 for upstream.'
	echo 'cxx-vecacid:'
	echo 'cxx-vecacid: ***BUT READ `edg-pad2:` AND `evicted=` FIRST.***  A'
	echo 'cxx-vecacid: ring of 4096 slots cannot report a pad it has already'
	echo 'cxx-vecacid: overwritten, so `dirty=0` beside `carves` over 4096'
	echo 'cxx-vecacid: was an unread window rather than a zero.  The check'
	echo 'cxx-vecacid: now runs on EVICTION too -- and the line says'
	echo 'cxx-vecacid: `edg-pad2:` with an `evicted=` count so that an older'
	echo 'cxx-vecacid: binary cannot answer in the newer one''s format.  A'
	echo 'cxx-vecacid: plain `edg-pad:` line means the edg build predates'
	echo 'cxx-vecacid: the complete scan and its dirty count speaks only'
	echo 'cxx-vecacid: for the last 4096 carves.'
	rm -rf $tmp
	exit nocrash
}

echo
echo 'cxx-vecacid: broken process is '^$crashpid
if(! test -d /proc/$crashpid){
	echo 'cxx-vecacid: but /proc/'^$crashpid^' is gone -- the process did'
	echo 'cxx-vecacid: not stay broken.  Nothing to attach to.'
	rm -rf $tmp
	exit noproc
}

# `regs()' FIRST and `src(pc)' LAST, deliberately: if acid dies on one
# of the later commands the earlier output is already printed.  Every
# crash in this tree that was read at all was read from `regs()'.
echo 'cxx-vecacid: attaching acid'
echo
{
	echo 'regs()'
	echo 'stk()'
	echo 'lstk()'
	echo 'src(*PC)'
} | acid $crashpid


# ---- walk the list the crash was walking -----------------------------
# ***THE STACK NAMES THE LINE AND NOT THE DEFECT.***  `free_memory_region'
# faults at `next_hdr = hdr->next' with `hdr == 0x3f4a1', and `hdr' comes
# from one of exactly two places: `mem_region_table[0]', or a previous
# `hdr->next'.  **Those are different bugs** -- a bad TABLE HEAD means
# whatever wrote the table, a bad LINK at position N means whatever
# allocated or freed block N-1 -- and no amount of reading separates
# them, because both end at the same instruction.
#
# ***`mem_region_table' IS A POINTER, NOT AN ARRAY.***  `mem_manage.c:455'
# declares `a_mem_block_header_ptr *mem_region_table', grown by
# `realloc_buffer' (`:7030'), so entry 0 is `**table' and NOT `*table'.
# **The first version of this walk read `*table' and would have walked
# the table BUFFER's own address as though it were a block header** --
# printing a chain, in the right shape, about the wrong object.  *A
# dereference one level short does not fail, it answers.*  Checked in
# the generated C rather than assumed, which is the only reason it was
# caught.
#
# The first word of `a_mem_block_header' IS `next' (`:4790'), so `*h' is
# the link, and `+8/+24/+32' are `start_of_block', `after_end_of_block'
# and `malloc_size'.  Printing those per entry is what makes a sane
# chain recognisable as one: `start' just above `hdr', `end' above
# `start', `msize' either 0 (a block carved out of another by
# `trim_mem_block') or the whole allocation.
#
# **The heap on this platform is around 0x3c00000** -- `DX' and `BP' in
# the faulting frame hold 0x3cdcd30 and 0x3c9f2a8 -- so `0x3f4a1' is
# three orders of magnitude below it and was never a pointer into it.
# *The earlier note here said 0x400000, from `edgmmap-probe's own
# mappings; that is a different, much smaller process.*  The threshold
# below is deliberately loose for that reason: it only has to separate
# `a quarter of a megabyte' from `a heap address'.
#
# ***AND THE TABLE BUFFER IS PLAIN `malloc'/`realloc' MEMORY***
# (`alloc_general' -> `malloc_with_check', `realloc_with_check' ->
# `realloc'), so if entry 0 is the bad one, the words on either side of
# the buffer are the next thing to look at: a small integer sitting
# exactly at `table[0]' is the shape of allocator bookkeeping written
# one block too far.  That is why the second invocation dumps them.
#
# Each acid command set is its OWN invocation, so a syntax error or a
# faulting read in a later question cannot lose an earlier answer.
# ***THE LAST RUN LOST THE WHOLE WALK TO ONE MISSING SEMICOLON***:
# inside `{ }' acid terminates every statement with `;', the final one
# included, and `n = n+1' without it answers
# `syntax error, near symbol '1''.
# ---- the recorder, which is the only thing that can name the entry ----
# `free_memory_region' now stores five globals as it walks (the APExp
# patch at `mem_manage.c:1191'), because **the walk overwrites every
# link it has passed** -- see the note above the reusable-list dump.
#
#	edg_dbg_cur    the hdr it was about to dereference: the BAD VALUE
#	edg_dbg_prev   the block whose `next' produced it
#	edg_dbg_prev2  the one before that
#	edg_dbg_n      how far down the chain the fault is
#	edg_dbg_rn     which region, MEASURED -- `lstk()' cannot say,
#	               since `region_number' is the first parameter and
#	               the first parameter is always garbage here.
#
# `prev' is the finding: its size, its `msize' (0 means a sub-block
# carved out of another by `trim_mem_block', non-zero a whole
# allocation) and the bytes around it say what kind of block had a
# corrupt link.  Its own `next' has been overwritten by then, so the
# VALUE is gone and only the identity survives -- which is why the raw
# bytes are dumped beside it.
#
# ***A PREDICTION, WRITTEN DOWN BEFORE THE RUN, WITH ITS REFUTATION.***
# The heap in this process runs about 0x01c00000 to 0x03e00000 (the
# table buffer is 0x01c5bb30, the live blocks 0x03d4xxxx-0x03dbxxxx).
# `0x3f4a1' is `0x0003f4a1', and the three values recorded across three
# builds are 0x3f4cd, 0x3f4a9, 0x3f4a1 -- each of which, SHIFTED LEFT BY
# EIGHT, lands at 0x03f4cd00, 0x03f4a900, 0x03f4a100: just above the
# live blocks, exactly where a freshly grown break would be.  Little-
# endian, that is the same byte sequence read ONE BYTE LATE.
#
# So the prediction is: **the bad value is a heap pointer read one byte
# high**, and `edg_dbg_prev' will sit near `edg_dbg_cur << 8'.
#
# *What refutes it*: `edg_dbg_cur << 8` nowhere near the heap, or
# `edg_dbg_prev' far from it, or a `prev' whose raw words show an
# ordinary header with a plainly different value in its first slot.
# **It is a guess from three numbers and is labelled one** -- this
# tree's recorded tally for mechanisms guessed from code alone is about
# one in eight, and this is weaker than that, being guessed from
# arithmetic on the symptom.
#
# ***IT NEEDS A REBUILD TO MEAN ANYTHING.***  Against a cpfe built
# before the patch the names do not resolve and acid says so; against
# one built after, `edg_dbg_n' is non-zero.  **A zero `edg_dbg_n' with
# the names resolving is a cpfe that crashed somewhere else entirely**,
# which is a different finding and not a failed read.
# ---- WHEN did it go bad -----------------------------------------------
# ***THE LINK RING SETTLED WHICH EXPLANATION IT IS.***  Slot 996:
# `hdr=0x03cc32c8 next-read-back=0x03cd0cf0', a valid pointer and
# exactly the block it was pushed on top of (link 995's own hdr).  **The
# store happened and was correct**, so something overwrote it between
# the link and the teardown -- about 650 links later.  The carve ring
# named the parent and it is innocent by its own bookkeeping:
# `avail == end == the sub-block's header address'.
#
# So the question is no longer WHICH explanation but WHEN, and
# `free_memory_region' cannot answer it because the write happens during
# ordinary compilation.  `alloc_mem_block' now walks region 0 every
# sixteenth call and records the first moment a link stops being a
# plausible heap pointer.
#
# **`edg_dbg_checks` is why `bad_at == -1` is readable**: a walk that
# never ran and a chain that never went bad are different answers, and
# without the count they print the same.
echo
echo 'cxx-vecacid: WHEN the chain first went bad'
echo
{
	echo 'print("edg_dbg_checks  = ", *edg_dbg_checks\D, " clean walks\n")'
	echo 'print("edg_dbg_bad_at  = ", *edg_dbg_bad_at\D, "   (-1 = never seen; with 0 clean walks the check never ran)\n")'
	echo 'print("edg_dbg_bad_trim= ", *edg_dbg_bad_trim\D, "\n")'
	echo 'print("edg_dbg_bad_pos = ", *edg_dbg_bad_pos\D, "   (how far down the chain)\n")'
	echo 'print("edg_dbg_bad_hdr = ", *edg_dbg_bad_hdr\X, "\n")'
	echo 'print("edg_dbg_bad_val = ", *edg_dbg_bad_val\X, "\n")'
	echo 'print("edg_dbg_bad_site= ", *edg_dbg_bad_site\D, "   1=alloc entry 2=alloc exit 3=trim 4=free_fe_huge 5=alloc_in_region\n")'
	echo 'print("edg_dbg_bad_allocs = ", *edg_dbg_bad_allocs\D, " of ", *edg_dbg_allocs\D, " alloc_in_region calls\n")'
	echo 'print("link total      = ", *edg_dbg_link_n\D, "   trim total = ", *edg_dbg_trim_n\D, "\n")'
} | acid $crashpid

echo
echo 'cxx-vecacid: the links and carves around that instant'
echo
{
	echo 'b = *edg_dbg_bad_at'
	echo 'if b < 0 then { print("never seen -- nothing to show\n"); }'
	echo 'if b >= 0 then {
		k = b - 8;
		if k < 0 then { k = 0; };
		while k <= b do {
			i = k & 4095;
			print("  link ", k\D, " region=", *(edg_dbg_link_rn+i*4)\D, " size=", *(edg_dbg_link_size+i*4)\D, " hdr=", *(edg_dbg_link_hdr+i*8)\X, " next=", *(edg_dbg_link_next+i*8)\X, "\n");
			k = k+1;
		};
	}'
	echo 't = *edg_dbg_bad_trim'
	echo 'if t >= 0 then {
		k = t - 8;
		if k < 0 then { k = 0; };
		while k <= t do {
			i = k & 4095;
			print("  carve ", k\D, " objsize=", *(edg_dbg_trim_size+i*4)\D, " new=", *(edg_dbg_trim_new+i*8)\X, " parent=", *(edg_dbg_trim_par+i*8)\X, "\n");
			k = k+1;
		};
	}'
} | acid $crashpid

echo
echo 'cxx-vecacid: the recorder (needs an edg rebuild -- see the script)'
echo
{
	echo 'print("edg_dbg_rn    = ", *edg_dbg_rn\D, "\n")'
	echo 'print("edg_dbg_n     = ", *edg_dbg_n\D, "\n")'
	echo 'print("edg_dbg_cur   = ", *edg_dbg_cur\X, "   (the bad value)\n")'
	echo 'print("edg_dbg_prev  = ", *edg_dbg_prev\X, "   (its source)\n")'
	echo 'print("edg_dbg_prev2 = ", *edg_dbg_prev2\X, "\n")'
} | acid $crashpid

echo
echo 'cxx-vecacid: the two blocks before the fault, and the bytes at prev'
echo
{
	echo 'p = *edg_dbg_prev'
	echo 'q = *edg_dbg_prev2'
	echo 'if p != 0 then { print("prev  ", p\X, " next=", *p\X, " start=", *(p+8)\X, " avail=", *(p+16)\X, " end=", *(p+24)\X, " msize=", *(p+32)\X, "\n"); }'
	echo 'if q != 0 then { print("prev2 ", q\X, " next=", *q\X, " start=", *(q+8)\X, " avail=", *(q+16)\X, " end=", *(q+24)\X, " msize=", *(q+32)\X, "\n"); }'
	echo 'print("\nraw words from prev-32 to prev+48:\n")'
	echo 'i = 0-4'
	echo 'if p != 0 then { while i < 6 do { print("  ", (p+i*8)\X, ": ", *(p+i*8)\X, "\n"); i = i+1; }; }'
} | acid $crashpid

# ---- which of the two remaining explanations ------------------------
# ***THE BYTE-SHIFT PREDICTION IS REFUTED, BY `edg_dbg_n' ALONE.***
# It was 13: twelve links were read correctly through the SAME
# instruction before the thirteenth was not.  A load generated one byte
# high would have been wrong on the first.  *A guess from arithmetic on
# the symptom, dead on the first datum it predicted nothing about.*
#
# What the run gave instead: `prev = 0x03c9f2c8`, a CARVED sub-block
# (`msize` 0, `trimmed` 1) whose payload runs to `0x03caccd0` with
# `avail` eight bytes short of it, and whose header is preceded by
# live-looking data -- pointer, 9, pointer, `0x4d1b`.  So `0x3f4a1` is
# the kind of value that memory would hold as STALE FRONT-END DATA, not
# a mangled pointer.
#
# ***AND THE VALUE IS THE SAME IN EVERY RUN WHILE EVERY ADDRESS MOVES.***
# `0x0003f4a1' has now come back from four cpfe binaries whose `pc'
# differs (0x9da331, 0x9da39d, 0x9da451), whose heap sits at a
# different offset each time, and whose `prev' was 0x03c9f2c8 then
# 0x03ca16c8.  **A value that is stable across builds while the
# addresses around it are not is not an address** -- it is something
# computed from the input, which is itself fixed: a count, a length, an
# index.  259233 in decimal.  *That is consistent with "stale
# front-end data" and sharpens it*: the memory was last written by
# something that stores a count there, which is what makes the parent
# ring worth having.
#
# That leaves exactly two explanations, and they are distinguished by
# what the field held at LINK time:
#
#	the store never happened ....... ring_next is also wrong
#	something overwrote it later ... ring_next is correct
#
# `alloc_mem_block` now records every link READING THE FIELD BACK, and
# `trim_mem_block` records which parent each sub-block was carved from.
# **The read-back is the whole design**: recording what was meant to be
# stored would answer neither question.
echo
echo 'cxx-vecacid: what was in prev->next when it was LINKED?'
echo
{
	echo 'p = *edg_dbg_prev'
	echo 'print("link ring: ", *edg_dbg_link_n\D, " links recorded")'
	echo 'if *edg_dbg_link_n > 4096 then { print("  (WRAPPED -- only the last 4096 are present)"); }'
	echo 'print("\ntrim ring: ", *edg_dbg_trim_n\D, " carves recorded")'
	echo 'if *edg_dbg_trim_n > 4096 then { print("  (WRAPPED)"); }'
	echo 'print("\n\n")'
	echo 'i = 0'
	echo 'while i < 4096 do {
		if *(edg_dbg_link_hdr+i*8) == p then {
			print("  LINKED  slot ", i\D, " hdr=", p\X, " next-read-back=", *(edg_dbg_link_next+i*8)\X, " region=", *(edg_dbg_link_rn+i*4)\D, " size=", *(edg_dbg_link_size+i*4)\D, "\n");
		};
		i = i+1;
	}'
	echo 'i = 0'
	echo 'while i < 4096 do {
		if *(edg_dbg_trim_new+i*8) == p then {
			print("  CARVED  slot ", i\D, " parent=", *(edg_dbg_trim_par+i*8)\X, " parent objsize=", *(edg_dbg_trim_size+i*4)\D, "   <-- the object the write ran past\n");
		};
		i = i+1;
	}'
} | acid $crashpid

# ***THE CHAIN AS BUILT, which is the thing the teardown walk destroys.***
# Pushes go at the HEAD, so the Nth entry of the chain is the Nth most
# recent surviving link to that region -- and the fault is at entry 13.
# Printing the last two dozen region-0 links in order therefore
# reconstructs the top of the chain from a record the loop never
# touches, and `prev' should be among them.  **If it is not, prev
# reached that chain by some route other than `alloc_mem_block'**,
# which is a finding in itself and not a failed read.
echo
echo 'cxx-vecacid: the last region-0 links, newest last'
echo
{
	echo 'n = *edg_dbg_link_n'
	echo 'lo = n - 4096'
	echo 'if lo < 0 then { lo = 0; }'
	echo 'k = n - 1'
	echo 'shown = 0'
	echo 'while k >= lo do {
		i = k & 4095;
		if *(edg_dbg_link_rn+i*4) == 0 then {
			if shown < 24 then {
				print("  link ", k\D, " hdr=", *(edg_dbg_link_hdr+i*8)\X, " next-read-back=", *(edg_dbg_link_next+i*8)\X, "\n");
				shown = shown+1;
			};
		};
		k = k-1;
	}'
	echo 'print("printed ", shown\D, " region-0 links, newest first\n")'
} | acid $crashpid

echo
echo 'cxx-vecacid: and the parent that carved prev, if the ring named one'
echo
{
	echo 'p = *edg_dbg_prev'
	echo 'par = 0'
	echo 'i = 0'
	echo 'while i < 4096 do { if *(edg_dbg_trim_new+i*8) == p then { par = *(edg_dbg_trim_par+i*8); }; i = i+1; }'
	echo 'if par == 0 then { print("prev is in no trim slot -- either it was never carved, or the ring wrapped\n"); }'
	echo 'if par != 0 then { print("parent ", par\X, " next=", *par\X, " start=", *(par+8)\X, " avail=", *(par+16)\X, " end=", *(par+24)\X, " msize=", *(par+32)\X, "\n"); }'
	echo 'if par != 0 then { print("prev header at ", p\X, ", parent after_end_of_block ", *(par+24)\X, " -- EQUAL means the carve is still intact\n"); }'
} | acid $crashpid

echo
echo 'cxx-vecacid: the region table itself'
echo
{
	echo 't = *_ZN3edg16mem_region_tableE'
	echo 'print("mem_region_table buffer = ", t\X, "\n")'
	echo 'print("size_of_mem_region_table = ", *_ZN3edg24size_of_mem_region_tableE\D, "\n")'
	echo 'i = 0'
	echo 'while i < 8 do { print("  table[", i\D, "] = ", *(t+i*8)\X, "\n"); i = i+1; }'
} | acid $crashpid

# ***THE WALK BELOW DOES NOT WALK THE REGION CHAIN, AND THE LAST RUN
# PROVED IT BY ANSWERING.***  It printed 33 entries in perfect order --
# `start' exactly `hdr+0x30', each entry's `end' equal to the NEXT
# entry's `hdr', `msize' 0 for a block carved by `trim_mem_block' and
# 0x10000 for its parent -- which is not what a chain containing
# `0x3f4a1' looks like.
#
# **`free_mem_block' OVERWRITES `hdr->next'**: it pushes each visited
# block onto `reusable_blocks_list' (`mem_manage.c:817'), and
# `mem_region_table[rn]' is cleared only AFTER the loop.  So once the
# loop has faulted, the table head still points at block 0 whose `next'
# now points into the REUSABLE LIST.  *The loop destroys its own
# evidence as it goes*, and every entry this prints is a block already
# freed or one that was on the reusable list before the loop started.
#
# It is kept because it is a useful SANITY CHECK on the allocator -- 33
# well-formed headers say the heap is not generally scribbled -- but it
# cannot name the bad entry and is labelled so.  The globals read above
# are what name it.
echo
echo 'cxx-vecacid: the reusable list (NOT the region chain -- see above)'
echo
{
	echo 't = *_ZN3edg16mem_region_tableE'
	echo 'h = *t'
	echo 'n = 0'
	echo 'while h != 0 do {
		if h < 0x100000 then {
			print(n\D, " hdr=", h\X, "   <-- not a heap pointer\n");
			h = 0;
		};
		if h != 0 then {
			print(n\D, " hdr=", h\X, " next=", *h\X, " start=", *(h+8)\X, " end=", *(h+24)\X, " msize=", *(h+32)\X, "\n");
			h = *h;
		};
		n = n+1;
		if n > 12 then {
			print("stopping at 12 entries\n");
			h = 0;
		};
	}'
	echo 'print("walked ", n\D, " entries\n")'
} | acid $crashpid

echo
echo 'cxx-vecacid: ***THE WALK ABOVE IS ONLY MEANINGFUL IF `stk()` NAMED'
echo 'cxx-vecacid: `free_memory_region`.***  Read the stack first.  A crash'
echo 'cxx-vecacid: at any other pc is a different bug reached by a'
echo 'cxx-vecacid: different route, and for it the region chain is just'
echo 'cxx-vecacid: whatever the allocator happens to hold -- a healthy'
echo 'cxx-vecacid: chain printed against the wrong question is exactly'
echo 'cxx-vecacid: what the 33-entry run was.'
echo
echo 'cxx-vecacid: words around the table buffer (allocator bookkeeping?)'
echo
{
	echo 't = *_ZN3edg16mem_region_tableE'
	echo 'i = 0-4'
	echo 'while i < 4 do { print("  ", (t+i*8)\X, ": ", *(t+i*8)\X, "\n"); i = i+1; }'
} | acid $crashpid

echo
echo 'cxx-vecacid: if that printed nothing useful, do it by hand:'
echo 'cxx-vecacid:   acid '^$crashpid
echo 'cxx-vecacid:   acid: regs()'
echo 'cxx-vecacid:   acid: stk()'
echo 'cxx-vecacid:   acid: src(*PC)'
echo 'cxx-vecacid:   acid: print(*edg_dbg_n\D, " ", *edg_dbg_cur\X, " ", *edg_dbg_prev\X)'
echo 'cxx-vecacid:   acid: p = *edg_dbg_prev'
echo 'cxx-vecacid:   acid: print(*p\X, " ", *(p+24)\X, " ", *(p+32)\X)'
echo 'cxx-vecacid: note *table is the BUFFER and **table is entry 0; that'
echo 'cxx-vecacid: chain is the REUSABLE list after a fault, not the region'
echo 'cxx-vecacid: chain; and lstk()''s first argument is garbage here.'
rm -rf $tmp
echo 'cxx-vecacid: done'
