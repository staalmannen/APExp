#!/bin/rc
# cxx-vecsplit -- WHERE in vector/vector.h does cpfe die?
#
#	./cxx-vecsplit
#
# `cxx-bisect' says `34 ok, 0 error, 1 CRASH' and the crash is
# `<vector>'.  This bisects the file.
#
# ***WHAT THE FIRST VERSION GOT WRONG, BECAUSE IT IS THE WHOLE REASON
# THIS ONE LOOKS LIKE IT DOES.***  It cut only at top-level
# `template<' boundaries, so its SHORTEST prefix was the entire
# include block in one step -- and that prefix CRASHED, so the run
# refused with "the shortest prefix already crashes, which
# contradicts cxx-vecnarrow phase 2".  *A ladder whose first rung
# already fails has no rungs.*
#
# **The contradiction was real and `cxx-vecnarrow' was the one that
# was wrong, in two ways at once:**
#
#   1. Its phase 2 tested `~ $k CRASH' and nothing else, so a prefix
#      that ERRORED counted as clean.  cpfe stops at an error, so
#      such a prefix never reaches the code that crashes -- *"no
#      prefix crashes" had two explanations and only one was
#      reported.*
#   2. It derived the include list with `#include' anchored at column
#      0, and **vector.h has 58 include directives, not 56**: two are
#      written `#  include' inside an `#if'.  Neither was ever
#      tested, and their absence is a live reason the cumulative
#      prefixes errored.
#
# Both are fixed in `cxx-vecnarrow' now.  This file cuts across the
# WHOLE file, include block included, so there is always something
# shorter to bisect against.
#
# HOW IT CUTS
# ===========
#
# `cxx-vecsplit.cuts' holds `LINE DEPTH' pairs: the prefix is lines
# 1..LINE, then DEPTH closing braces, then `#endif' and a `main'.
# ***EVERY ONE WAS COMPILED BY g++ BEFORE IT WAS WRITTEN DOWN***
# (`hostkencc/cxxlib-host.sh --vecsplit'), so a rung that ERRORS here
# means cpfe disagrees with g++ -- a finding -- rather than the
# harness cutting in the wrong place, which is noise.  *An instrument
# whose failures have two explanations cannot be read*, which is the
# mistake above, in the harness rather than in the library.
#
# AN `ERROR' RUNG STOPS THE BISECT RATHER THAN COUNTING AS CLEAN.
# cpfe stops at the first error, so an errored prefix says nothing
# about whether the crash is before or after it; treating one as
# "no crash" is exactly what made `cxx-vecnarrow' answer wrongly.
#
# rc notes: `>[2]file' with no space; `=' is a syntax character and
# assignments are tight and leading; `while()' with an empty
# condition is not rc; `} if not {' on one line is a parse error, so
# there is no `if not' here; `grep' is GNU grep.

CXXDIR=/sys/include/ape/c++
VEC=$CXXDIR/vector/vector.h
CUTS=`{dirname $0}^/cxx-vecsplit.cuts

if(! test -f $VEC){
	echo 'cxx-vecsplit: no '^$VEC >/fd/2
	exit nofile
}
if(! test -f $CUTS){
	echo 'cxx-vecsplit: no '^$CUTS >/fd/2
	exit nocuts
}

tmp=/tmp/cxx-vecsplit.$pid
mkdir -p $tmp

# One element per cut, each `LINE:DEPTH' so rc keeps the pair
# together in a list.
cuts=`{grep -v '^#' $CUTS | grep -v '^$' | awk '{print $1 ":" $2}'}
if(~ $#cuts 0){
	echo 'cxx-vecsplit: '^$CUTS^' holds no cut points' >/fd/2
	rm -rf $tmp
	exit nocuts
}
echo 'cxx-vecsplit: '^$#cuts^' cut points, validated on the host'

# **STALENESS GUARD.**  A cut is a LINE NUMBER and rots silently the
# moment the file is edited above it: a wrong cut still produces a
# file and cpfe still answers something.  Each must still be either
# an `#include' line or the line before a top-level `template<'.
stale=()
for(c in $cuts){
	n=`{echo $c | sed 's/:.*//'}
	l=`{sed -n $n^p $VEC}
	m=`{echo $n | awk '{print $1 + 1}'}
	l2=`{sed -n $m^p $VEC}
	ok=''
	if(echo $l | grep -q '^[ 	]*#[ 	]*include')
		ok=1
	if(echo $l2 | grep -q '^template<')
		ok=1
	if(~ $ok '')
		stale=($stale $n)
}
if(! ~ $#stale 0){
	echo 'cxx-vecsplit: STALE -- these cut points no longer land on an'
	echo 'cxx-vecsplit: #include or before a top-level template<:'
	echo 'cxx-vecsplit:   '^$"stale
	echo 'cxx-vecsplit: regenerate with cxxlib-host.sh --vecsplit'
	rm -rf $tmp
	exit stale
}
echo 'cxx-vecsplit: all '^$#cuts^' still land where the generator put them'
echo

# `-I' is NOT optional: vector.h's own includes are QUOTED and
# relative to its directory, and the generated file lives in /tmp.
fn build {	# $1 = LINE:DEPTH
	n=`{echo $1 | sed 's/:.*//'}
	d=`{echo $1 | sed 's/.*://'}
	sed -n '1,'^$n^'p' $VEC > $tmp/p.cpp
	i=0
	while(! ~ $i $d){
		echo '}' >> $tmp/p.cpp
		i=`{echo $i | awk '{print $1 + 1}'}
	}
	echo '#endif' >> $tmp/p.cpp
	echo 'int main(void){ return 0; }' >> $tmp/p.cpp
}

fn try {	# echoes ok / ERROR / CRASH for $tmp/p.cpp
	c++ -F -I$CXXDIR/vector $tmp/p.cpp >$tmp/out >[2]$tmp/err
	st=$status
	kind=ok
	if(! ~ $st '')
		kind=ERROR
	if(grep -qE 'suicide|trap:' $tmp/err)
		kind=CRASH
	echo $kind
}

# ---- rung A: the shortest prefix must NOT crash -------------------
build $cuts(1)
a=`{try}
echo 'cxx-vecsplit: rung A  shortest prefix (through line '^`{echo $cuts(1) | sed 's/:.*//'}^') -> '^$a
if(! ~ $a ok){
	echo 'cxx-vecsplit: REFUSED -- the shortest prefix is already '^$a^'.'
	echo 'cxx-vecsplit: There is nothing shorter to bisect against, so'
	echo 'cxx-vecsplit: the fault is at or before that line and this'
	echo 'cxx-vecsplit: ladder cannot localise it further.'
	sed 3q $tmp/err
	rm -rf $tmp
	exit badlow
}

# ---- rung B: the whole file must crash ----------------------------
echo '#include <vector>' > $tmp/p.cpp
echo 'int main(void){ return 0; }' >> $tmp/p.cpp
b=`{try}
echo 'cxx-vecsplit: rung B  the whole <vector>  -> '^$b
if(! ~ $b CRASH){
	echo 'cxx-vecsplit: REFUSED -- <vector> no longer crashes, so there'
	echo 'cxx-vecsplit: is nothing to bisect.  Re-run cxx-bisect.'
	rm -rf $tmp
	exit nocrash
}
echo

# ---- bisect -------------------------------------------------------
# lo = an index known NOT to crash, hi = one known to.  Index $#cuts+1
# is the virtual end: the whole file, measured by rung B.
lo=1
hi=`{echo $#cuts | awk '{print $1 + 1}'}
echo 'cxx-vecsplit: bisecting '^$#cuts^' cut points'
span=`{echo $lo $hi | awk '{print $2 - $1}'}
stopped=''
while(! ~ $span 1){
	mid=`{echo $lo $hi | awk '{print int(($1 + $2) / 2)}'}
	build $cuts($mid)
	k=`{try}
	echo '  cut '^$mid^' (line '^`{echo $cuts($mid) | sed 's/:.*//'}^') -> '^$k
	if(~ $k ERROR){
		echo
		echo 'cxx-vecsplit: STOPPED -- that rung does not COMPILE under'
		echo 'cxx-vecsplit: cpfe, though g++ accepted it.  An errored'
		echo 'cxx-vecsplit: prefix says nothing about which side the'
		echo 'cxx-vecsplit: crash is on, and counting one as clean is'
		echo 'cxx-vecsplit: what made cxx-vecnarrow answer wrongly.'
		echo 'cxx-vecsplit: **This is itself a finding**: read it.'
		sed 3q $tmp/err
		stopped=1
		span=1
	}
	if(~ $k CRASH)
		hi=$mid
	if(~ $k ok)
		lo=$mid
	if(~ $stopped '')
		span=`{echo $lo $hi | awk '{print $2 - $1}'}
}

if(! ~ $stopped ''){
	rm -rf $tmp
	echo 'cxx-vecsplit: done'
	exit errrung
}

echo
from=`{echo $cuts($lo) | sed 's/:.*//'}
if(~ $hi `{echo $#cuts | awk '{print $1 + 1}'}){
	echo 'cxx-vecsplit: every cut point is clean, so the crash is AFTER'
	echo 'cxx-vecsplit: line '^$from^' -- the last definition in the file.'
	rm -rf $tmp
	echo 'cxx-vecsplit: done'
	exit 0
}
to=`{echo $cuts($hi) | sed 's/:.*//'}
echo 'cxx-vecsplit: ***THE CRASH IS IN vector/vector.h BETWEEN LINE'
echo 'cxx-vecsplit: '^$from^' AND LINE '^$to^'***'
echo
sed -n $from^','^$to^p $VEC | sed 25q

# ---- phase C: minimise, IN PLACE -----------------------------------
# ***THE FIRST VERSION OF THIS PHASE REBUILT THE FILE AND SO TESTED
# SOMETHING ELSE.***  It collected the include PATHS and wrote a fresh
# `#include "<abs>/vector/<path>"' per line -- and that file answered
# `ok', not CRASH.  The honest report ("the includes ALONE answer ok")
# was right and the method was wrong: **a minimiser must SHRINK the
# input, never reconstruct it**, because a reconstruction differs in
# every way you did not think to copy.  Here it dropped the copyright
# block, the `#ifndef'/`#define' guard and the relative include
# spelling, and one of those three is load-bearing.
#
# *Neither of the first two is load-bearing by MEANING*: nothing in
# the library tests `PSTL_VECTOR_H', and lines 1-11 are a `//'
# comment -- both checked.  So the gap is a finding in itself and
# this phase is what attributes it, by deleting from the real file.
#
# Candidates, each deleted as a UNIT and kept deleted if the file
# still CRASHES:
#   * the comment block (everything before the guard)
#   * the guard pair -- and then the trailing `#endif' goes too
#   * each `#include' line
#
# **An include whose removal makes the file merely ERROR is KEPT**:
# that says the prefix stopped compiling, not that it stopped
# crashing, and the two are different answers.
echo
echo 'cxx-vecsplit: phase C -- MINIMISING in place (deleting real lines)'

CUTLAST=$to
CUTDEPTH=`{echo $cuts($hi) | sed 's/.*://'}
GUARD=1
DEL=()
SUBLINE=''
SUBTEXT=''
SUBALL=''

fn buildsel {
	e=''
	for(d in $DEL)
		e=$e^$d^'d;'
	if(! ~ $SUBLINE '')
		e=$e^$SUBLINE^'s|.*|'^$SUBTEXT^'|;'
	if(! ~ $SUBALL '')
		e=$e^'s|^[ 	]*#[ 	]*include "|#include "'^$CXXDIR^'/vector/|;'
	if(~ $e '')
		sed -n '1,'^$CUTLAST^'p' $VEC > $tmp/p.cpp
	if(! ~ $e '')
		sed -n '1,'^$CUTLAST^'p' $VEC | sed $e > $tmp/p.cpp
	i=0
	while(! ~ $i $CUTDEPTH){
		echo '}' >> $tmp/p.cpp
		i=`{echo $i | awk '{print $1 + 1}'}
	}
	if(~ $GUARD 1)
		echo '#endif' >> $tmp/p.cpp
	echo 'int main(void){ return 0; }' >> $tmp/p.cpp
}

# Re-establish the baseline through THIS builder, so that every rung
# below differs from it by exactly one deletion.  A minimiser whose
# baseline was produced by a different path is comparing two things.
buildsel
k=`{try}
echo '  baseline (lines 1..'^$CUTLAST^') -> '^$k
if(! ~ $k CRASH){
	echo '  the builder does not reproduce the crash, so nothing below'
	echo '  would mean anything.  Stopping; the boundary is the finding.'
	rm -rf $tmp
	echo 'cxx-vecsplit: done'
	exit nobase
}

gline=`{grep -n '^#ifndef' $VEC | sed 1q | sed 's/:.*//'}
gnext=`{echo $gline | awk '{print $1 + 1}'}
gprev=`{echo $gline | awk '{print $1 - 1}'}

# the comment block, as one unit
if(! ~ $gprev 0){
	save=$DEL
	i=1
	while(! ~ $i $gline){
		DEL=($DEL $i)
		i=`{echo $i | awk '{print $1 + 1}'}
	}
	buildsel
	k=`{try}
	echo '  without the comment block (1..'^$gprev^') -> '^$k
	if(! ~ $k CRASH)
		DEL=$save
}

# the guard pair
save=$DEL
sg=$GUARD
DEL=($DEL $gline $gnext)
GUARD=0
buildsel
k=`{try}
echo '  without the #ifndef/#define guard -> '^$k
if(! ~ $k CRASH){
	DEL=$save
	GUARD=$sg
}

# each include line
incl=`{sed -n '1,'^$CUTLAST^'p' $VEC | grep -n '^[ 	]*#[ 	]*include' | sed 's/:.*//'}
last=$incl($#incl)
for(n in $incl){
	if(! ~ $n $last){
		save=$DEL
		DEL=($DEL $n)
		buildsel
		k=`{try}
		if(~ $k CRASH)
			echo '  dropped line '^$n
		if(! ~ $k CRASH)
			DEL=$save
	}
}

# ---- C2: does the include SPELLING matter? -------------------------
# ***THE HOST SAYS THE TWO FORMS ARE THE SAME PROGRAM.***  `g++ -E'
# over the crashing prefix and over the rebuilt absolute-path version
# produces **byte-identical token streams**, 6428 lines each -- so
# nothing about the C++ differs and the only things left are the file
# NAMES and the search that found them.
#
# A relative `#include "../algorithm/equal.h"' from a file in /tmp
# misses in the including file's own directory and is then found
# through `-I'; an absolute one is found at once.  *This port's whole
# crash history is about `stat' in `host_envir.c'*, so a failed
# lookup preceding a successful one is not an idle difference.
#
# This rewrites every surviving include to the absolute form -- a
# line-wise substitution on the same file, not a reconstruction -- and
# reports.  CRASH means the spelling is innocent; `ok' means it is the
# whole thing and the C++ is cleared.
SUBALL=1
buildsel
k=`{try}
SUBALL=''
echo
echo 'cxx-vecsplit: phase C2 -- same lines, ABSOLUTE include paths -> '^$k
if(~ $k CRASH)
	echo 'cxx-vecsplit:   so the spelling is innocent; the content is the cause'
if(! ~ $k CRASH){
	echo 'cxx-vecsplit:   ***SO IT IS THE SPELLING, NOT THE C++.***  The two'
	echo 'cxx-vecsplit:   forms preprocess to identical tokens on the host, so'
	echo 'cxx-vecsplit:   this is cpfe''s FILE LOOKUP -- a relative include'
	echo 'cxx-vecsplit:   that misses once and is then found through -I.'
	echo 'cxx-vecsplit:   Read host_envir.c, not the C++ library.'
}

buildsel
k=`{try}
echo
echo 'cxx-vecsplit: ***MINIMAL REPRODUCER -- '^$k^'***'
echo
cat $tmp/p.cpp
cp $tmp/p.cpp /tmp/cxx-vecmin.cpp
echo
echo 'cxx-vecsplit: saved as /tmp/cxx-vecmin.cpp'
echo 'cxx-vecsplit: reproduce with:  c++ -F -I'^$CXXDIR^'/vector /tmp/cxx-vecmin.cpp'

# ---- phase D: decompose the last include ---------------------------
# Phase C never shrinks the last include, so the reproducer ends with
# a header that may be mostly envelope: `niter_base.h' pulls in
# `move_iterator.h', `reverse_iterator.h', `wrap_iter.h' and two
# metaprogramming headers before it declares anything of its own, and
# **`reverse_iterator.h' and `wrap_iter.h' are not among the earlier
# thirteen**.  This REPLACES that one line, in place, with each of the
# culprit's own includes in turn -- one `sed' substitution keyed on
# the same input line number the deletions use, so the two compose.
echo
echo 'cxx-vecsplit: phase D -- replace the last include with each of ITS own'
culprit=`{sed -n $last^p $VEC | sed 's/.*"\(.*\)".*/\1/'}
cdir=`{dirname $culprit}
subs=`{sed -n 's/^[ 	]*#[ 	]*include "\(.*\)"/\1/p' $CXXDIR/vector/$culprit}
if(~ $#subs 0)
	echo '  '^$culprit^' includes nothing; it is already atomic'
SUBLINE=$last
hit=()
for(s in $subs){
	SUBTEXT='#include "'^$cdir^'/'^$s^'"'
	buildsel
	k=`{try}
	echo '  '^$cdir^'/'^$s^' -> '^$k
	if(~ $k CRASH)
		hit=($hit $cdir^'/'^$s)
}
SUBLINE=''
echo
if(~ $#hit 0){
	echo 'cxx-vecsplit: no single include of '^$culprit^' reproduces, so'
	echo 'cxx-vecsplit: the last member is that file''s OWN content.'
}
if(! ~ $#hit 0){
	echo 'cxx-vecsplit: ***'^$culprit^' IS AN ENVELOPE*** -- these of its'
	echo 'cxx-vecsplit: own includes reproduce in its place:'
	for(h in $hit)
		echo 'cxx-vecsplit:   '^$h
}
rm -rf $tmp
echo 'cxx-vecsplit: done'
