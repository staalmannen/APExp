#!/bin/rc
# cxx-vecsplit -- WHERE in vector/vector.h does cpfe die?
#
#	./cxx-vecsplit
#
# `cxx-bisect' says `34 ok, 0 error, 1 CRASH' and the crash is
# `<vector>'.  This bisects the file.
#
# ***WHAT THE FIRST VERSION GOT WRONG, BECAUSE IT IS THE WHOLE REASON
# THIS ONE LOOKS LIKE IT DOES.***  It cut only at top-level
# `template<' boundaries, so its SHORTEST prefix was the entire
# include block in one step -- and that prefix CRASHED, so the run
# refused with "the shortest prefix already crashes, which
# contradicts cxx-vecnarrow phase 2".  *A ladder whose first rung
# already fails has no rungs.*
#
# **The contradiction was real and `cxx-vecnarrow' was the one that
# was wrong, in two ways at once:**
#
#   1. Its phase 2 tested `~ $k CRASH' and nothing else, so a prefix
#      that ERRORED counted as clean.  cpfe stops at an error, so
#      such a prefix never reaches the code that crashes -- *"no
#      prefix crashes" had two explanations and only one was
#      reported.*
#   2. It derived the include list with `#include' anchored at column
#      0, and **vector.h has 58 include directives, not 56**: two are
#      written `#  include' inside an `#if'.  Neither was ever
#      tested, and their absence is a live reason the cumulative
#      prefixes errored.
#
# Both are fixed in `cxx-vecnarrow' now.  This file cuts across the
# WHOLE file, include block included, so there is always something
# shorter to bisect against.
#
# HOW IT CUTS
# ===========
#
# `cxx-vecsplit.cuts' holds `LINE DEPTH' pairs: the prefix is lines
# 1..LINE, then DEPTH closing braces, then `#endif' and a `main'.
# ***EVERY ONE WAS COMPILED BY g++ BEFORE IT WAS WRITTEN DOWN***
# (`hostkencc/cxxlib-host.sh --vecsplit'), so a rung that ERRORS here
# means cpfe disagrees with g++ -- a finding -- rather than the
# harness cutting in the wrong place, which is noise.  *An instrument
# whose failures have two explanations cannot be read*, which is the
# mistake above, in the harness rather than in the library.
#
# AN `ERROR' RUNG STOPS THE BISECT RATHER THAN COUNTING AS CLEAN.
# cpfe stops at the first error, so an errored prefix says nothing
# about whether the crash is before or after it; treating one as
# "no crash" is exactly what made `cxx-vecnarrow' answer wrongly.
#
# rc notes: `>[2]file' with no space; `=' is a syntax character and
# assignments are tight and leading; `while()' with an empty
# condition is not rc; `} if not {' on one line is a parse error, so
# there is no `if not' here; `grep' is GNU grep.

CXXDIR=/sys/include/ape/c++
VEC=$CXXDIR/vector/vector.h
CUTS=`{dirname $0}^/cxx-vecsplit.cuts

if(! test -f $VEC){
	echo 'cxx-vecsplit: no '^$VEC >/fd/2
	exit nofile
}
if(! test -f $CUTS){
	echo 'cxx-vecsplit: no '^$CUTS >/fd/2
	exit nocuts
}

tmp=/tmp/cxx-vecsplit.$pid
mkdir -p $tmp

# One element per cut, each `LINE:DEPTH' so rc keeps the pair
# together in a list.
cuts=`{grep -v '^#' $CUTS | grep -v '^$' | awk '{print $1 ":" $2}'}
if(~ $#cuts 0){
	echo 'cxx-vecsplit: '^$CUTS^' holds no cut points' >/fd/2
	rm -rf $tmp
	exit nocuts
}
echo 'cxx-vecsplit: '^$#cuts^' cut points, validated on the host'

# **STALENESS GUARD.**  A cut is a LINE NUMBER and rots silently the
# moment the file is edited above it: a wrong cut still produces a
# file and cpfe still answers something.  Each must still be either
# an `#include' line or the line before a top-level `template<'.
stale=()
for(c in $cuts){
	n=`{echo $c | sed 's/:.*//'}
	l=`{sed -n $n^p $VEC}
	m=`{echo $n | awk '{print $1 + 1}'}
	l2=`{sed -n $m^p $VEC}
	ok=''
	if(echo $l | grep -q '^[ 	]*#[ 	]*include')
		ok=1
	if(echo $l2 | grep -q '^template<')
		ok=1
	if(~ $ok '')
		stale=($stale $n)
}
if(! ~ $#stale 0){
	echo 'cxx-vecsplit: STALE -- these cut points no longer land on an'
	echo 'cxx-vecsplit: #include or before a top-level template<:'
	echo 'cxx-vecsplit:   '^$"stale
	echo 'cxx-vecsplit: regenerate with cxxlib-host.sh --vecsplit'
	rm -rf $tmp
	exit stale
}
echo 'cxx-vecsplit: all '^$#cuts^' still land where the generator put them'
echo

# `-I' is NOT optional: vector.h's own includes are QUOTED and
# relative to its directory, and the generated file lives in /tmp.
fn build {	# $1 = LINE:DEPTH
	n=`{echo $1 | sed 's/:.*//'}
	d=`{echo $1 | sed 's/.*://'}
	sed -n '1,'^$n^'p' $VEC > $tmp/p.cpp
	i=0
	while(! ~ $i $d){
		echo '}' >> $tmp/p.cpp
		i=`{echo $i | awk '{print $1 + 1}'}
	}
	echo '#endif' >> $tmp/p.cpp
	echo 'int main(void){ return 0; }' >> $tmp/p.cpp
}

fn try {	# echoes ok / ERROR / CRASH for $tmp/p.cpp
	c++ -F -I$CXXDIR/vector $tmp/p.cpp >$tmp/out >[2]$tmp/err
	st=$status
	kind=ok
	if(! ~ $st '')
		kind=ERROR
	if(grep -qE 'suicide|trap:' $tmp/err)
		kind=CRASH
	echo $kind
}

# ---- rung A: the shortest prefix must NOT crash -------------------
build $cuts(1)
a=`{try}
echo 'cxx-vecsplit: rung A  shortest prefix (through line '^`{echo $cuts(1) | sed 's/:.*//'}^') -> '^$a
if(! ~ $a ok){
	echo 'cxx-vecsplit: REFUSED -- the shortest prefix is already '^$a^'.'
	echo 'cxx-vecsplit: There is nothing shorter to bisect against, so'
	echo 'cxx-vecsplit: the fault is at or before that line and this'
	echo 'cxx-vecsplit: ladder cannot localise it further.'
	sed 3q $tmp/err
	rm -rf $tmp
	exit badlow
}

# ---- rung B: the whole file must crash ----------------------------
echo '#include <vector>' > $tmp/p.cpp
echo 'int main(void){ return 0; }' >> $tmp/p.cpp
b=`{try}
echo 'cxx-vecsplit: rung B  the whole <vector>  -> '^$b
if(! ~ $b CRASH){
	echo 'cxx-vecsplit: REFUSED -- <vector> no longer crashes, so there'
	echo 'cxx-vecsplit: is nothing to bisect.  Re-run cxx-bisect.'
	rm -rf $tmp
	exit nocrash
}
echo

# ---- bisect -------------------------------------------------------
# lo = an index known NOT to crash, hi = one known to.  Index $#cuts+1
# is the virtual end: the whole file, measured by rung B.
lo=1
hi=`{echo $#cuts | awk '{print $1 + 1}'}
echo 'cxx-vecsplit: bisecting '^$#cuts^' cut points'
span=`{echo $lo $hi | awk '{print $2 - $1}'}
stopped=''
while(! ~ $span 1){
	mid=`{echo $lo $hi | awk '{print int(($1 + $2) / 2)}'}
	build $cuts($mid)
	k=`{try}
	echo '  cut '^$mid^' (line '^`{echo $cuts($mid) | sed 's/:.*//'}^') -> '^$k
	if(~ $k ERROR){
		echo
		echo 'cxx-vecsplit: STOPPED -- that rung does not COMPILE under'
		echo 'cxx-vecsplit: cpfe, though g++ accepted it.  An errored'
		echo 'cxx-vecsplit: prefix says nothing about which side the'
		echo 'cxx-vecsplit: crash is on, and counting one as clean is'
		echo 'cxx-vecsplit: what made cxx-vecnarrow answer wrongly.'
		echo 'cxx-vecsplit: **This is itself a finding**: read it.'
		sed 3q $tmp/err
		stopped=1
		span=1
	}
	if(~ $k CRASH)
		hi=$mid
	if(~ $k ok)
		lo=$mid
	if(~ $stopped '')
		span=`{echo $lo $hi | awk '{print $2 - $1}'}
}

if(! ~ $stopped ''){
	rm -rf $tmp
	echo 'cxx-vecsplit: done'
	exit errrung
}

echo
from=`{echo $cuts($lo) | sed 's/:.*//'}
if(~ $hi `{echo $#cuts | awk '{print $1 + 1}'}){
	echo 'cxx-vecsplit: every cut point is clean, so the crash is AFTER'
	echo 'cxx-vecsplit: line '^$from^' -- the last definition in the file.'
	rm -rf $tmp
	echo 'cxx-vecsplit: done'
	exit 0
}
to=`{echo $cuts($hi) | sed 's/:.*//'}
echo 'cxx-vecsplit: ***THE CRASH IS IN vector/vector.h BETWEEN LINE'
echo 'cxx-vecsplit: '^$from^' AND LINE '^$to^'***'
echo
sed -n $from^','^$to^p $VEC | sed 25q

# ---- phase C: minimise ---------------------------------------------
# **A BOUNDARY IS NOT A REPRODUCER.**  Knowing that adding one
# `#include' turns `ok' into `CRASH' names the last straw, not the
# bug: `cxx-vecnarrow' phase 1 compiled that same header ALONE and it
# was fine, so what crashes cpfe is a COMBINATION and the boundary
# line is only its final member.
#
# This drops the earlier includes one at a time, greedily, keeping
# every drop that still CRASHES.  What comes out is the smallest set
# that reproduces -- which is the thing to read, to attach to a bug
# report, and to hand to `acid'.  **An include whose removal makes
# the file merely ERROR is KEPT**, because that outcome says the
# prefix stopped compiling rather than stopped crashing, and the two
# are not the same answer.
echo
echo 'cxx-vecsplit: phase C -- MINIMISING the reproducer'
keep=`{sed -n '1,'^$to^'p' $VEC | sed -n 's/^[ 	]*#[ 	]*include "\(.*\)"/\1/p'}
if(~ $#keep 0){
	echo '  no #include lines up to line '^$to^'; nothing to minimise'
	rm -rf $tmp
	echo 'cxx-vecsplit: done'
	exit 0
}
culprit=$keep($#keep)
echo '  last include before the crash: '^$culprit
echo '  starting from '^$#keep^' includes'

fn buildlist {
	rm -f $tmp/p.cpp
	for(f in $*)
		echo '#include "'^$CXXDIR^'/vector/'^$f^'"' >> $tmp/p.cpp
	echo 'int main(void){ return 0; }' >> $tmp/p.cpp
}

buildlist $keep
k=`{try}
if(! ~ $k CRASH){
	echo '  the includes ALONE answer '^$k^', not CRASH -- so the'
	echo '  reproducer needs something else from the file as well'
	echo '  (the guard, the comment block, or a later line).  Not'
	echo '  minimising; the boundary above is the finding.'
	rm -rf $tmp
	echo 'cxx-vecsplit: done'
	exit 0
}
cands=$keep
for(drop in $cands){
	if(! ~ $drop $culprit){
		trial=()
		for(f in $keep){
			if(! ~ $f $drop)
				trial=($trial $f)
		}
		buildlist $trial
		k=`{try}
		if(~ $k CRASH){
			keep=$trial
			echo '  dropped '^$drop
		}
	}
}
buildlist $keep
k=`{try}
echo
echo 'cxx-vecsplit: ***MINIMAL REPRODUCER: '^$#keep^' include(s), '^$k^'***'
echo
cat $tmp/p.cpp
cp $tmp/p.cpp /tmp/cxx-vecmin.cpp
echo
echo 'cxx-vecsplit: saved as /tmp/cxx-vecmin.cpp'
echo 'cxx-vecsplit: reproduce with:  c++ -F -I'^$CXXDIR^'/vector /tmp/cxx-vecmin.cpp'
rm -rf $tmp
echo 'cxx-vecsplit: done'
