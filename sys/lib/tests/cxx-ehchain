#!/bin/rc
# cxx-ehchain -- build and run cxx-ehchain-probe, both halves.
#
#	./cxx-ehchain
#
# ***IT IS A SCRIPT BECAUSE THE INVOCATION WAS GOT WRONG BY HAND, AND
# THE FAILURE READ LIKE A BUG IN THE PROBE.***  The walk lives in a
# separate C file (see `cxx-ehchain-walk.c' for why it MUST), so the
# object has to be on the `eccp' line -- and leaving it off answers
#
#	_ZN39_INTERNAL_21_cxx_ehchain_probe_cpp_main9dumpchainEPKc:
#		undefined: eh_dump
#
# which names the C++ caller and reads like a mangling problem.  *It
# is not*: the undefined name is `eh_dump', UNMANGLED, so the
# `extern "C"' worked and the object was simply absent.
#
# **And the suffix is not `.o'.**  `pcc.c:75' is
# `objext = (strcmp(prog, "cc") == 0) ? "o" : ot->o', so `pcc -c'
# writes `.6' on amd64 and the arch letter everywhere else -- which
# is why this uses `$O' from the environment rather than a literal,
# and why `eccp' has a `*.[1-9kqv]' case at all.
#
# The probe's own header has what the four possible chains mean.

if(~ $O ''){
	echo 'cxx-ehchain: $O is not set -- run this inside apexp-sh' >[1=2]
	exit noO
}

echo 'cxx-ehchain: compiling the walker with pcc'
pcc -c cxx-ehchain-walk.c || exit walk

if(! test -f cxx-ehchain-walk.$O){
	echo 'cxx-ehchain: pcc made no cxx-ehchain-walk.'^$O >[1=2]
	exit noobj
}

echo 'cxx-ehchain: compiling and linking the probe with eccp -fexceptions'
eccp -fexceptions -o cxx-ehchain-probe cxx-ehchain-probe.cpp cxx-ehchain-walk.$O || exit probe

# ***EVERY CASE GETS ITS OWN PROCESS, AND THAT IS NOT TIDINESS.***
# The terminate handler `exit's, so a single process running all the
# throws reports the FIRST failure and nothing about the rest -- which
# is how the ellipsis-only case went unmeasured for a round while
# looking like it had passed.  `mmaptrim-probe' takes an argument for
# the same reason.
#
# `-k' in spirit: a failing case does NOT stop the ones after it,
# because the SHAPE of the matrix is the finding.  Case 0 is the
# control and a run where it fails says nothing about the others.
echo
for(c in 0 1 2 3 4){
	echo '================ case '^$c^' ================'
	./cxx-ehchain-probe $c
	s=$status
	if(~ $s '')
		s=0
	echo 'cxx-ehchain: case '^$c^' exit '^$s
	echo
}
echo 'cxx-ehchain: 0 caught as intended, 3 terminate reached, 4 wrong handler'
