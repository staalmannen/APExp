# mkelves: like mkmany, but produces ELF binaries via 6l -H5 (amd64).
# LDFLAGS defaults to -Wl,-H5 (works with LD=pcc; pcc forwards -H5 to 6l).
# If using LD=6l directly, override: LDFLAGS=-H5
# To append extra linker flags: LDFLAGS=$LDFLAGS -lfoo (after including this file)

LDFLAGS=-Wl,-H5
PROGS=${TARG:%=$O.%.elf}
MANFILES=${TARG:%=%.man}
YFLAGS=-d

none:VQ:
	echo usage: mk all, install, installall, '$O'.cmd.elf, cmd.install, or cmd.installall

all:V:	$PROGS

$O.%.elf:	%.$O $OFILES $LIB
	$LD $LDFLAGS -o $target $prereq

%.$O:	$HFILES		# don't combine with following %.$O rules

%.$O:	%.c
	$CC $CFLAGS $stem.c

%.$O:	%.s
	$AS $AFLAGS $stem.s

y.tab.h y.tab.c:	$YFILES
	$YACC $YFLAGS $prereq

lex.yy.c:	$LFILES
	$LEX $LFLAGS $prereq

<$APEXPROOT/sys/src/cmd/transpilers

%.install:V:	$BIN/%

$BIN/%:	$O.%.elf
	cp $O.$stem.elf $BIN/$stem

%.installall:V:
	for (objtype in $CPUS)
		mk $stem.install

install:V:
	for (i in $TARG)
		mk $MKFLAGS $i.install

installall:V:
	for(objtype in $CPUS)
		mk $MKFLAGS install

%.safeinstall:V:
	mk $O.$stem.elf
	test -e $BIN/$stem && mv $BIN/$stem $BIN/_$stem
	mk $stem.install

%.safeinstallall:V:
	for(objtype in $CPUS)
		mk $MKFLAGS $stem.safeinstall

safeinstall:V:
	for(i in $TARG)
		mk $MKFLAGS $i.safeinstall

safeinstallall:V:
	for (objtype in $CPUS)
		mk safeinstall

update:V:
	update $UPDATEFLAGS $UPDATE

# [$OS].??*.elf avoids file names like 9.h
nuke:V:
	rm -f *.[$OS] y.tab.? lex.yy.c y.debug y.output [$OS].??*.elf *.acid $TARG $CLEANFILES

clean:V:
	test -d ./test && @{cd test && mk $MKFLAGS clean}
	rm -f *.[$OS] *.a[$OS] y.tab.? lex.yy.c y.debug y.output [$OS].??*.elf $TARG $CLEANFILES

%.clean:V:
	rm -f $stem.[$OS] [$OS].$stem.elf $stem.acid $stem

%.acid: %.$O $HFILES
	$CC $CFLAGS -a $stem.c >$target

%.man:	$MAN/$stem
	cp $stem.man $MAN/$stem

man:V:	$MANFILES

test:VQ: $PROGS
	if(test -d ./test)
		cd test && mk $MKFLAGS test
	if not
		status=()
