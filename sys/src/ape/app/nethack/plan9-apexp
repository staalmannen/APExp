#-PRE
# unix hints file
# This hints file provides the legacy configuration that NetHack has shipped
# with historically - this means you will most likely need to hand edit .h
# and Makefiles.
#

WANT_WIN_CURSES=1
WANT_WIN_TTY=0
ARFLAGS=rv

PREFIX=/

# Binaries and supporting data.
HACKDIR=/sys/libexec/nethackdir

# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# Careful, this directory is deleted on install.
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
INSTDIR=$(HACKDIR)

# Save games
VARDIR=/sys/games/nethackdir

# Home for nethask.sh wrapper.  If undefined, no wrapper installed.
# Suggest leaving /usr/games as-is from bsdgames.tgz.
SHELLDIR=/rc/bin/ape

CFLAGS=-O -I../include -I../nhlua/lua/src -USYSV -DBSD -DPLAN9 -DHACKDIR='"$(HACKDIR)"' -DVAR_PLAYGROUND='"$(VARDIR)"'
LINK=$(CC)

WINSRC = $(WINTTYSRC)
WINOBJ = $(WINTTYOBJ)
WINLIB = $(WINTTYLIB)

CHOWN=chown
CHGRP=chgrp

GAMEUID  = games
GAMEGRP  = games

GAMEPERM = 04755
VARFILEPERM = 0644
VARDIRPERM = 0755

MAKEDEFS = ../util/makedefs
NEEDMAKEDEFS = $(MAKEDEFS)

NROFF = /bin/nroff

