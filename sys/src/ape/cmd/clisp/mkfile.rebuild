APEXPROOT=../../../../..
APE=$APEXPROOT/sys/src/ape
<$APE/config
CLISPSRC=$APEXPROOT/sys/src/external/clisp/src
BIN=$APEXPROOT/$objtype/bin/ape
BUILD=build-$objtype

# $CPARTS and $GLPARTS are shared with mkfile.runtime; see that file
# for why they are not copied into both.
<mkfile.cparts

EVERY_INCLUDES=\
	lispbibl fsubr subr pseudofun constsym constobj constobj_tl unix
OTHER_INCLUDES=constpack avl sort subrkw bytecode
SPVW_INCLUDES=\
	spvw_module spvw_debug spvw_alloca spvw_mmap spvw_singlemap\
	spvw_page spvw_heap spvw_global spvw_gcstat spvw_space spvw_mark\
	spvw_objsize spvw_update spvw_fault spvw_sigsegv spvw_sigcld\
	spvw_sigpipe spvw_sigint spvw_sigwinch spvw_sigterm spvw_garcol\
	spvw_garcol_old spvw_genera1 spvw_gcmark spvw_genera2 spvw_weak\
	spvw_genera3 spvw_allocate spvw_typealloc spvw_circ spvw_walk\
	spvw_ctype spvw_language spvw_memfile
LISPARIT_INCLUDES=\
	aridecl arilev0 arilev1 intelem intlog intplus intcomp intbyte\
	intmal intdiv intgcd int2adic intsqrt intprint intread intserial\
	rational sfloat ffloat dfloat lfloat flo_konv flo_rest realelem\
	realrand realtran compelem comptran arilev1c arilev1e arilev1i
DFILES=$CPARTS $EVERY_INCLUDES $OTHER_INCLUDES $SPVW_INCLUDES\
	errunix $LISPARIT_INCLUDES genclisph noreadline

# Stage two: turn CLISP's comment-annotated C in *.d into ordinary C.
# Keep generated files in the per-architecture build directory so the
# configure and GNU-make build use the same sources on 9front.
CLEANFILES=*.c *.tmp

# A COMMENT INSIDE A RECIPE IS rc's, NOT mk's, AND IT IS NOT FREE.
#
# mk passes a recipe to rc verbatim, so every tab-indented line here is
# rc source -- including the comment lines.  They used to carry the whole
# explanation of the `=' rule, apostrophes and backquotes and all, and
# the VM answered
#
#	/rc/lib/rcmain:24 *eval*:13: token '=': syntax error
#
# with the ONLY `=' characters in the recipe being the two inside those
# comments and one leading assignment.  *Which construct it is has not
# been settled* -- `sys/lib/tests/mkrecipe-probe' is one `mk' run that
# names it -- so the recipe below is written to contain no `#', no bare
# `=', and no `} if not {' at all, and the prose lives out here at
# column 0 where mk eats it and rc never sees it.
#
# The rule it is written against is the recorded one: `=' is a SYNTAX
# CHARACTER in rc, legal as a leading per-command assignment or inside
# quotes and nowhere else.  `test $name = lispbibl' is a parse error;
# `~ $name lispbibl' is the rc spelling of the same question.
# `sys/lib/tests/rceq-sweep.py' gates on it.
#
# AND mk NAMES THE WRONG LINE, which is why this is swept for rather
# than read for: mk reports a recipe by its FIRST line, so the failure
# arrived as `mk: mkdir -p build-amd64 ...: exit status=rc: syntax
# error' with nothing in it about the line that failed or even the file.
# *The message names the victim*, after the `lock.h' shadow and
# `cmd/mkfile:96'.

# `End of comment outside comment in line 5699' IS EXPECTED AND IS
# COSMETIC.  It comes from `utils/varbrace.c:1123' on `lispbibl.d's
# `arrayflags_dispoffset_bit', a comment opened inside a `#define' and
# closed two lines later: varbrace's `#' arm takes the raw line with
# `next_line()' and never enters its comment scanner, so the `*/' looks
# orphaned.  It then falls through to `goto separator', which is what a
# `*' does anyway.  **Measured, not argued**: varbrace's input and
# output both balance braces and parens at 0, are 17841 lines each, and
# differ on 8 lines, none near 5699.  `docs/notes/ports.md' has the
# host commands and the two reading errors it cost.
#
# *It also appears in the log AFTER the last `mv', which does not run
# varbrace at all* -- varbrace writes to stderr and the rest goes to
# stdout, so its POSITION in the log is not its position in the run.
all:V: sources

sources:V:
	mkdir -p $BUILD
	for (name in $DFILES) @{
		if (~ $name lispbibl)
			$BIN/comment5 $CLISPSRC/$name.d | sed -e 's/^%% .*//' | $BIN/gctrigger | $BIN/varbrace > $BUILD/$name.c.tmp
		if not
			$BIN/comment5 $CLISPSRC/$name.d | $BIN/gctrigger | $BIN/varbrace > $BUILD/$name.c.tmp
		if (! test -s $BUILD/$name.c.tmp) {
			echo 'clisp: empty generation for' $name
			rm -f $BUILD/$name.c.tmp
			exit clispgen
		}
		mv $BUILD/$name.c.tmp $BUILD/$name.c
	}
	$BIN/comment5 $CLISPSRC/lispbibl.d | sed -e '/^%% /{s///p;d;}' -e '/^#line /!s/.*//' > $BUILD/gen.lispbibl.c.tmp
	if (! test -s $BUILD/gen.lispbibl.c.tmp) {
		echo 'clisp: empty gen.lispbibl.c'
		rm -f $BUILD/gen.lispbibl.c.tmp
		exit clispgen
	}
	mv $BUILD/gen.lispbibl.c.tmp $BUILD/gen.lispbibl.c

clean:V:
	rm -f $BUILD/*.c $BUILD/*.tmp

nuke:V:
	rm -f $BUILD/*.c $BUILD/*.tmp

