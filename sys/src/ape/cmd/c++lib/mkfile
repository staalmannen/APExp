APEXPROOT=../../../../../
APE=$APEXPROOT/sys/src/ape
<$APE/config

LIB=$APEXPROOT/$objtype/lib/ape/libc++.a

OFILES=\
# complex\
	abs.$O arg.$O cos.$O error.$O exp.$O io.$O \
	log.$O oper.$O polar.$O pow.$O sin.$O sqrt.$O\
# generic\
	generic.$O\
# new\
	_arr_map.$O _delete.$O _handler.$O \
	_new.$O _vec.$O placenew.$O\
# static\
	_ctor.$O _dtor.$O pure.$O\
# stream\
	cstreams.$O filebuf.$O flt.$O fstream.$O in.$O \
	intin.$O ios_compat.$O manip.$O oldformat.$O \
	out.$O rawin.$O sbuf.dbp.$O stdiobuf.$O stream.$O \
	streambuf.$O strstream.$O swstdio.$O\
# string\
	string.$O\

<$APEXPROOT/sys/src/cmd/mksyslib

CXXSOURCE=../../../external/cfront-C4/lib
CXXINCL=/sys/include/ape/c++

CC=pcc
CFLAGS= -c -FV -I$CXXSOURCE/complex/complex -I$CXXSOURCE/stream

# **`-o $target', NOT `> $target', AND THAT IS THE WHOLE POINT OF THIS
# BLOCK.** With a redirection the shell CREATES the target before c++
# runs, so a cfront that writes nothing to stdout leaves a zero-byte .c
# behind and mk goes on to compile it. Forty empty translation units
# make a libc++.a with no symbols in it, and the build reports success:
# *a check that cannot fail.* That is exactly the state this directory
# was committed in. The driver's -F arm only `cp's its output once
# cfront has returned, so with -o a failure leaves no target at all and
# mk stops where the fault is.
#
# The driver carries the other half: `c++' now REFUSES an empty cfront
# result, because cfront cannot produce one -- measured on the host, it
# answers a zero-byte input with 409 bytes and exit 0. So nothing empty
# can reach this directory silently any more.

%.c: $CXXSOURCE/complex/complex/%.cpp
	c++ -F -I$CXXINCL -I$CXXSOURCE/complex/complex -o $target $prereq

%.c: $CXXSOURCE/generic/%.cpp
	c++ -F -I$CXXINCL -o $target $prereq

%.c: $CXXSOURCE/new/%.cpp
	c++ -F -I$CXXINCL -o $target $prereq

%.c: $CXXSOURCE/static/%.cpp
	c++ -F -I$CXXINCL -o $target $prereq

%.c: $CXXSOURCE/stream/%.cpp
	c++ -F -I$CXXINCL -I$CXXSOURCE/stream -o $target $prereq

%.c: $CXXSOURCE/string/%.cpp
	c++ -F -I$CXXINCL -o $target $prereq

# `*.c' UNQUOTED. It was `"*.c"', and mk has no special meaning for
# double quotes -- it passes them through, so the recipe ran
#
#	rm -f *.[056789qvt] [056789qvt].out '"*.c"'
#
# and rc looked for one file whose name is literally `"*.c"'. So
# `mk clean' left every generated .c in place, which is how a stale
# or empty generation survives a clean and gets compiled again.
# cmd/perl/mkfile has had it right (`CLEANFILES = *.c') all along.
# mk does not glob in an assignment; rc globs when the recipe runs.
CLEANFILES=*.c
