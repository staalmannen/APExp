install:V:	perllib

# Plan 9's tar, by full path, rather than dircp.
#
# Inside apexp-sh both /bin/tar and /bin/dircp are the APE ones -- it
# binds $cputype/bin/ape and rc/bin/ape with -b -- and rc/bin/ape/dircp
# says so itself: "copy a tree with ape's tar". So an install step that
# says dircp gets GNU tar, and GNU tar does not currently work here:
#
#	tar: suicide: bad address in notify
#	: This does not look like a tar archive
#
# Copying a tree during a build should not depend on which tar the
# session happens to prefer, so this names Plan 9's.
P9TAR=/$cputype/bin/tar

# The trees overlay one another, which is what a real perl install does
# too: every dist and cpan module ends up in the same privlib.
perllib:V:	$BIN/$TARG
	mkdir -p $PERLLIB
	@{cd $PERLSRC/lib && $P9TAR cf /fd/1 .} | @{cd $PERLLIB && $P9TAR xf /fd/0}
	for(d in $PUREDIST)
		@{cd $PERLSRC/$d/lib && $P9TAR cf /fd/1 .} | @{cd $PERLLIB && $P9TAR xf /fd/0}
	@{cd $PERLSRC/dist/PathTools/lib && $P9TAR cf /fd/1 .} | @{cd $PERLLIB && $P9TAR xf /fd/0}
	cp $PERLSRC/dist/PathTools/Cwd.pm $PERLLIB/Cwd.pm
	cp Config.pm $PERLLIB/Config.pm
	# $PERLSRC/lib carries its own tests -- 84 .t files and four
	# directories named t. Nothing else copied above has any. Depth
	# 3 is the deepest a .t sits, checked rather than assumed; an
	# unmatched glob is passed through literally by rc and rm -f
	# says nothing about it.
	rm -f $PERLLIB/*.t $PERLLIB/*/*.t $PERLLIB/*/*/*.t
	rm -rf $PERLLIB/*/t $PERLLIB/*/*/t

nuke:V:	perllibnuke

perllibnuke:V:
	rm -rf $PERLLIB
