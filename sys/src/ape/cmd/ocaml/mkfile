# ---- the runtime: byterun, ocamlrun, and the unix/str stubs it links ----

$OCAMLRUN: byterun/main.$O byterun/libcamlrun.a otherlibs/unix/libunix.a otherlibs/str/libstr.a
	$LD -o $target $prereq

byterun/libcamlrun.a: $BYTEOBJS
	$AR vu $target $newprereq
	$RANLIB $target

byterun/%.$O: $OCSRC/byterun/%.c
	$CC -c -o $target $RUNCFLAGS $OCSRC/byterun/$stem.c

byterun/main.$O: $OCPLAN9/byterun/main.c
	$CC -c -o $target $RUNCFLAGS $prereq

byterun/prims.$O: byterun/prims.c
	$CC -c -o $target $RUNCFLAGS $prereq

byterun/prims.c: byterun/primitives
	$OCPLAN9/tools/make-prims.rc byterun/primitives > $target

byterun/primitives: $OCSRC/byterun/alloc.c $OCSRC/byterun/array.c $OCSRC/byterun/compare.c $OCSRC/byterun/extern.c $OCSRC/byterun/floats.c $OCSRC/byterun/gc_ctrl.c $OCSRC/byterun/hash.c $OCSRC/byterun/intern.c $OCSRC/byterun/interp.c $OCSRC/byterun/ints.c $OCSRC/byterun/io.c $OCSRC/byterun/lexing.c $OCSRC/byterun/md5.c $OCSRC/byterun/meta.c $OCSRC/byterun/obj.c $OCSRC/byterun/parsing.c $OCSRC/byterun/signals.c $OCSRC/byterun/str.c $OCSRC/byterun/sys.c $OCSRC/byterun/terminfo.c $OCSRC/byterun/callback.c $OCSRC/byterun/weak.c $OCSRC/byterun/finalise.c $OCSRC/byterun/stacks.c $OCSRC/byterun/dynlink.c $OCSRC/byterun/backtrace_prim.c $OCSRC/byterun/backtrace.c $OCSRC/byterun/spacetime.c $OCSRC/byterun/afl.c
	sed -n -e 's/CAMLprim value \([a-z_][a-z0-9_]*\).*/\1/p' -e 's/^#define [A-Z_]* \(caml_unix_[a-z0-9_]*\).*/\1/p' $prereq $OCSRC/otherlibs/unix/*.c $OCSRC/otherlibs/str/*.c | sort | uniq > $target

byterun/caml/version.h: $OCSRC/VERSION
	$OCPLAN9/tools/make-version-header.rc $prereq > $target

byterun/caml/jumptbl.h: $OCSRC/byterun/caml/instruct.h
	sed -n '/^enum instructions {/,/^};/p' $prereq | grep -o '[A-Z][A-Z0-9_]*' | sed 's/.*/\&\&lbl_&,/' > $target

# the generated headers and primitives must exist before any byterun object
byterun/prims.$O: byterun/caml/version.h byterun/caml/jumptbl.h

RUNCFLAGS=-I$OCBLD/byterun -I$OCBLD/byterun/caml -I$OCSRC/byterun -I$OCPLAN9/byterun/$objtype -I$OCPLAN9/byterun/caml -D_PLAN9_SOURCE -D_BSD_EXTENSION -D_C99_SNPRINTF_EXTENSION -D_POSIX_SOURCE -DCAML_NAME_SPACE -Bc

# ---- stage 0: ocamlyacc (C), installed into boot/ ----

$OCAMLYACC: $YACCOBJS
	$LD -o $target $prereq

yacc/%.$O: $OCSRC/yacc/%.c yacc/version.h
	$CC -c -o $target -I$OCBLD/yacc -I$OCPLAN9/byterun -D_BSD_EXTENSION -D_C99_SNPRINTF_EXTENSION -D_POSIX_SOURCE -DCAML_NAME_SPACE -Bc $OCSRC/yacc/$stem.c

yacc/version.h: $OCSRC/VERSION
	echo '#define OCAML_VERSION "'^`{sed -e 1q $prereq | tr -d ''}^'"' > $target

# ---- the stdlib, built by its own mkfile, then installed into boot/ ----

$STDLIB: $OCAMLRUN
	cd stdlib
	mk install

# ---- lex: ocamllex, built by its own mkfile ----

lex/ocamllex: $OCAMLRUN $STDLIB
	cd lex
	mk ocamllex

# ---- tools ----

tools/make_opcodes.ml: $OCSRC/tools/make_opcodes.mll
	$OCAMLLEX -o $target $prereq

tools/make_opcodes: tools/make_opcodes.ml
	$OCAMLBOOT -I tools -o $target $prereq

tools/ocamlmklibconfig.ml:
	>$target{
		echo 'let bindir = "/amd64/bin"'
		echo 'let supports_shared_libraries = false'
		echo 'let default_rpath = ""'
		echo 'let mksharedlibrpath = ""'
		echo 'let toolpref = ""'
		echo 'let mklib out files opts = Printf.sprintf "ar r %s %s %s" out opts files;;'
	}

tools/ocamlmklibconfig.cmo: tools/ocamlmklibconfig.ml
	$OCAMLBOOT -c -o $target $prereq

tools/ocamlmklib: tools/ocamlmklibconfig.cmo utils/config.cmo utils/misc.cmo
	$OCAMLBOOT -I utils -I tools -o $target tools/ocamlmklibconfig.cmo utils/config.cmo utils/misc.cmo $OCSRC/tools/ocamlmklib.ml

tools/ocamldep: compilerlibs/ocamlbytecomp.cma
	$OCAMLBOOT -I . -I utils -I parsing -I typing -I bytecomp -I driver -I toplevel -o $target compilerlibs/ocamlbytecomp.cma $OCSRC/tools/ocamldep.ml

