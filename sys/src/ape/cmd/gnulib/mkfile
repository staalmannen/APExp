#during building from scratch, the new pcc is not picked up and compilation
#fails on include_next
CC=$APEXPROOT/$objtype/bin/pcc

CFLAGS=-c -B -I. -I$GNUSRC -DHAVE_CONFIG_H\
	-D_POSIX_SOURCE -D_BSD_EXTENSION -D__USE_GNU\
	-D_REGEX_LARGE_OFFSETS -DREGEX_MALLOC -DO_BINARY=0\
	-DSETLOCALE_NULL_MAX=257\
	-DLOCALEDIR="/sys/lib/ape/locale"

# No two modules share a basename across these directories, so the
# pattern rules cannot collide and mk's rule ordering does not matter.
%.$O: $GNUSRC/%.c
	$CC $CFLAGS $GNUSRC/$stem.c

%.$O: $GNUSRC/malloc/%.c
	$CC $CFLAGS $GNUSRC/malloc/$stem.c

%.$O: $GNUSRC/bitset/%.c
	$CC $CFLAGS $GNUSRC/bitset/$stem.c

%.$O: $GNUSRC/glthread/%.c
	$CC $CFLAGS $GNUSRC/glthread/$stem.c

%.$O: $GNUSRC/unistr/%.c
	$CC $CFLAGS $GNUSRC/unistr/$stem.c

all:V:		$LIB

install:V:	$LIB

installall:V:	$LIB

# Recreate the archive from scratch every time. 'ar vu' only appends, so
# updating in place would leave a member behind after it is dropped from
# OFILES — exactly the stale-member trap that made gnulib's obstack.o
# collide with libap's. Re-archiving is cheap; guessing is not.
$LIB:	$OFILES
	rm -f $LIB
	ar vu $LIB $OFILES

# Rebuilding from scratch matters here. 'ar vu' only ever appends, so a
# member dropped from OFILES survives in a stale archive and keeps
# breaking the link. Always remove the archive, never update in place.
clean:V:
	rm -f *.[$OS] $LIB

nuke:V:
	rm -f *.[$OS] $LIB
