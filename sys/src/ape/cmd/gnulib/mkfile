APEXPROOT=../../../../..

# One shared libgnu.a for every GNU package that needs gnulib.
#
# Sources live in a single consolidated tree, sys/src/external/gnulib,
# built by import.sh from the per-package gnulib copies (newest copy
# wins; coreutils is the base). Because there is exactly one copy of
# each module and one config.h, the object that ends up in the archive
# no longer depends on which package happened to build last.
#
# Do NOT add a module that libap already provides — both archives are on
# every link line, so a module present in both is a duplicate-symbol
# error. See README for the current list and for the obstack case that
# prompted this consolidation.

GNUSRC=$APEXPROOT/sys/src/external/gnulib

LIB=libgnu.a$O

OFILES=\
	acl-internal.$O\
	argmatch.$O\
