#during building from scratch, the new pcc is not picked up and compilation
#fails on include_next
CC=$APEXPROOT/$objtype/bin/pcc

# There is deliberately no -Drpl_xxx=xxx mapping here.
#
# Per-package builds used to carry one, because their config.h renamed
# malloc, free, open and friends to rpl_* and APE supplies the real
# ones. The consolidated tree uses coreutils' config.h, which renames
# none of those, so the mapping is dead weight.
#
# The renames coreutils' config.h does make are fts_* and re_*/reg*,
# and those must be left alone. libap implements regcomp, regexec,
# regfree and fts itself, so it is precisely the rpl_ prefix that keeps
# gnulib's regex.c and fts.c from redefining them -- the same
# duplicate-symbol trap that obstack fell into. Undoing them here, or
# editing them out of config.h, reintroduces it.
CFLAGS=-c -B -I. -I$GNUSRC -DHAVE_CONFIG_H -D_POSIX_SOURCE -D_BSD_EXTENSION\
  -D__USE_GNU -D_REGEX_LARGE_OFFSETS -DREGEX_MALLOC -DO_BINARY=0\
   -DSETLOCALE_NULL_MAX=257 -DLOCALEDIR="/sys/lib/ape/locale"


# No two modules share a basename across these directories, so the
# pattern rules cannot collide and mk rule ordering does not matter.
%.$O: $GNUSRC/%.c
	$CC $CFLAGS $GNUSRC/$stem.c

%.$O: $GNUSRC/malloc/%.c
	$CC $CFLAGS $GNUSRC/malloc/$stem.c

%.$O: $GNUSRC/bitset/%.c
	$CC $CFLAGS $GNUSRC/bitset/$stem.c

%.$O: $GNUSRC/glthread/%.c
	$CC $CFLAGS $GNUSRC/glthread/$stem.c

%.$O: $GNUSRC/unistr/%.c
	$CC $CFLAGS $GNUSRC/unistr/$stem.c

all:V: $LIB

install:V: $LIB

installall:V: $LIB

# Recreate the archive from scratch every time. 'ar vu' only appends, so
# updating in place would leave a member behind after it is dropped from
# OFILES, which is the stale-member trap that made gnulib obstack.o
# collide with the one in libap.
$LIB: $OFILES
	rm -f $LIB
	ar vu $LIB $OFILES

clean:V:
	rm -f *.[$OS] $LIB

nuke:V:
	rm -f *.[$OS] $LIB
