APEXPROOT=../../../../..
APE=$APEXPROOT/sys/src/ape
<$APE/config

LIB=\
	libutil.a$O\
	$APEXPROOT/$objtype/lib/ape/libap.a\

# sbase, for the utilities nothing else in this tree provides.
#
# It used to build 66 programs, 50 of which are now built from a better
# implementation elsewhere and would only have raced to install over the
# same name in $BIN. GNU coreutils covers 49 of them; diffutils covers
# cmp. sed, grep and tar were already off for the same reason.
#
# Removed rather than commented out -- the list of what coreutils builds
# is in sys/src/ape/cmd/core/mkfile, and duplicating it here as 50 dead
# lines would only go stale. What is left is what sbase is actually for.
#
# UTIL_OBJS below is deliberately untouched. libutil.a is a library; an
# object no remaining program calls simply sits in it.
#
# Two of these are worth knowing about:
#   chroot   calls chroot(2), which libap answers with EIO
#            (ap/unistd/chroot.c). Plan 9's equivalent is
#            rfork(RFNAMEG) plus bind, so this cannot work as it stands.
#            coreutils leaves its own chroot out for the same reason.
#   cmp      is gone on the strength of diffutils providing it, and the
#            diff directory is commented out in cmd/mkfile on this
#            branch. Enable it there, or put cmp back here.
#
# kill, hostname, uptime and arch stay with sbase: coreutils has them
# but lists them in no_install__progs, so it builds them and does not
# install them.
TARG= \
		cal\
		chroot\
		cols\
		dc\
		kill\
		rev\
		setsid\
		sponge\
		strings\
		tftp\
		time\
		uudecode\
		uuencode\
		which\
		xargs\
		xinstall

# Off, and sbase's own: bc, cron, ed, find, flock, getconf, hostname,
# logger, nice, renice. No trailing backslashes here -- these are past
# the end of TARG, and a comment line ending in one continues onto the
# next line.

UTIL_OBJS=\
		concat.$O\
		_cp.$O\
		crypt.$O\
		ealloc.$O\
		enmasse.$O\
		eprintf.$O\
		eregcomp.$O\
		estrtod.$O\
		fnck.$O\
		fshut.$O\
		getlines.$O\
		human.$O\
		linecmp.$O\
		md5.$O\
		memmem.$O\
		mkdirp.$O\
		mode.$O\
		parseoffset.$O\
		putword.$O\
		reallocarray.$O\
#		recurse.$O\
#		rm.$O\
		sha1.$O\
#		sha224.$O\
#		sha256.$O\
#		sha384.$O\
#		sha512-224.$O\
		sha512-256.$O\
		sha512.$O\
		strcasestr.$O\
		strlcpy.$O\
		strnsubst.$O\
		strsep.$O\
		strtonum.$O\
		unescape.$O\
		writeall.$O


BIN=$APEXPROOT/$objtype/bin/ape

<$APEXPROOT/sys/src/cmd/mkmany

SBASESRC=../../../external/sbase

CC=pcc
LD=pcc

CFLAGS=-c -D_POSIX_SOURCE

CPPFLAGS =\
	-D_DEFAULT_SOURCE \
	-D_NETBSD_SOURCE \
	-D_BSD_SOURCE \
	-D_XOPEN_SOURCE=700 \
	-D_FILE_OFFSET_BITS=64

# -I$SBASESRC/../gnulib is deliberately absent. It named a directory that
# did not exist until the gnulib consolidation created it, so it had been
# a dangling -I doing nothing. Now it resolves, and the one filename the
# two trees share is regex.h, which sbase reaches through util.h:
#
#   gnulib/regex.h:420 unnamed structure element must be struct/union
#
# sbase must use APE's <regex.h>: it links libutil.a and libap.a and
# nothing else, so regcomp/regexec come from libap, and gnulib's
# struct re_pattern_buffer is not libap's. Compiling against one layout
# and calling into the other would have been the quieter failure.
#
# The layouts differ twice over. gnulib's regex.h picks its field types
# on _REGEX_LARGE_OFFSETS, which config-common.h defines -- so every
# package that includes a config.h agrees with libgnu.a. sbase has no
# config.h, so it would have taken the other branch and disagreed with
# both.
SBASE_CFLAGS=-c $CPPFLAGS -I$SBASESRC -I$SBASESRC/libutil\
	-D_POSIX_SOURCE -D_BSD_EXTENSION \
	-D_LIMITS_EXTENSION -D_RESEARCH_SOURCE

libutil.a$O: $UTIL_OBJS
			ar vu libutil.a$O $UTIL_OBJS

%.$O: $SBASESRC/%.c
	$CC $SBASE_CFLAGS $SBASESRC/$stem.c

%.$O: $SBASESRC/libutf/%.c
	$CC $SBASE_CFLAGS $SBASESRC/libutf/$stem.c

%.$O: $SBASESRC/libutil/%.c
	$CC $SBASE_CFLAGS $SBASESRC/libutil/$stem.c

bc.c: $SBASESRC/bc.y
	yacc $SBASESRC/bc.y -o bc.c


install:V:
	mk all
	for (i in $TARG)
		@{ cp $SBASESRC/$i.1 $APEXPROOT/sys/man/1/$i 
		cp $O.$i $BIN/$i}


