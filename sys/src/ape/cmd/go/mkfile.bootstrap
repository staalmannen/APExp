APEXPROOT=../../../../..
APE=$APEXPROOT/sys/src/ape
<$APE/config

GOSRC=../../../external/go1.4
GODIST=$GOSRC/src/cmd/dist
BIN=$APEXPROOT/$objtype/bin/ape
TARG=go-dist

# Keep this list in sync with src/make.rc: the C bootstrap tool is
# deliberately built from all ten portability and build-driver files.
OFILES=\
	arm.$O\
	buf.$O\
	build.$O\
	buildgc.$O\
	buildgo.$O\
	buildruntime.$O\
	main.$O\
	plan9.$O\
	unix.$O\
	windows.$O\

UPDATE=\
	mkfile\
	${OFILES:%.$O=$GODIST/%.c}\

<$APEXPROOT/sys/src/cmd/mkone

# `pcc -c', NOT bare `pcc'.  Without -c the driver COMPILES AND THEN
# LINKS (pcc.c's `if(!cflag)' arm), so the very first file answered
#
#	_apemain: undefined: main in _apemain
#
# -- a LINK error on `arm.c', which has no `main' and was never meant to
# have one.  *The message is about the second half of a command whose
# first half worked*, which is why it reads like a missing symbol in
# libap rather than a missing flag here.
# `CC=pcc -c' is what every other APE package in this tree says
# (`cmd/tar/mkfile:79', `cmd/core/mkfile:206'); `mkone's own `%.$O: %.c'
# rule is `$CC $CFLAGS $stem.c' with no -c of its own, so the -c has to
# arrive through CC or through CFLAGS and this file had it in neither.
# LD stays bare: the link is the one place pcc should link.
CC=pcc -c
LD=pcc
# -DHAVE_C_BOOL: kencc's `bool' is a keyword, so dist's own
# `typedef int bool;' in a.h is a syntax error and the build stopped on
# the first file.  The guard is upstream-shaped (bash's bashansi.h uses
# this exact name) and the capability is declared HERE rather than sniffed
# from a compiler macro -- see the comment in a.h.
#
# `-V' and `-+' are 6c flags pcc does not name, so it prints
# `cc: flag -V ignored' twice per file and carries on.  They are left in
# because they are upstream's own list from src/make.rc and removing them
# would make this line diverge from the one go documents.
# -DGOROOT_FINAL: the quotes are PLAIN, and the backslashes that used to be
# here are a Makefile idiom that rc and mk do not share.  It read
# `-DGOROOT_FINAL=\\"$APEXPROOT/...\\"', so cpp defined the macro as
# `\"...\"' and `build.c:21', `char *goroot = GOROOT_FINAL;', answered
#
#	build.c:21[stdin:207] syntax error, last name: goroot
#
# -- a C syntax error two files further on, naming the variable rather than
# the flag.  **mk gives double quotes no meaning and passes them through**
# (the same mechanism `cmd/c++lib's `CLEANFILES= "*.c"' paid a round for,
# from the other side), and rc never re-lexes the CONTENTS of an expanded
# variable -- which is why every `-DFOO=1' in this tree is safe through
# $CFLAGS and why a literal `=' in a recipe is not.  So a bare `"' survives
# into the argument exactly as written and no escape is wanted.
CFLAGS=-FTVwp+ -DPLAN9 -DHAVE_C_BOOL -DGOROOT_FINAL="$APEXPROOT/sys/src/external/go1.4"

# make.rc generates the Plan 9 libc declarations before compiling dist.
libc_plan9.h:V:
	cd $GOSRC/src && ../include/plan9/mklibc.rc > ../include/plan9/libc_plan9.h

all: $O.out

$O.out: libc_plan9.h

%.$O: $GODIST/%.c
	$CC $CFLAGS $prereq

nuke:V:
	rm -f *.[$OS] [$OS].out
	rm -f $BIN/go-dist
