APEXPROOT=../../../../..
APE=$APEXPROOT/sys/src/ape
<$APE/config

GOSRC=../../../external/go1.4
GODIST=$GOSRC/src/cmd/dist
BIN=$APEXPROOT/$objtype/bin/ape
TARG=go-dist

# Keep this list in sync with src/make.rc: the C bootstrap tool is
# deliberately built from all ten portability and build-driver files.
OFILES=\
	arm.$O\
	buf.$O\
	build.$O\
	buildgc.$O\
	buildgo.$O\
	buildruntime.$O\
	main.$O\
	plan9.$O\
	unix.$O\
	windows.$O\

UPDATE=\
	mkfile\
	${OFILES:%.$O=$GODIST/%.c}\

<$APEXPROOT/sys/src/cmd/mkone

# `pcc -c', NOT bare `pcc'.  Without -c the driver COMPILES AND THEN
# LINKS (pcc.c's `if(!cflag)' arm), so the very first file answered
#
#	_apemain: undefined: main in _apemain
#
# -- a LINK error on `arm.c', which has no `main' and was never meant to
# have one.  *The message is about the second half of a command whose
# first half worked*, which is why it reads like a missing symbol in
# libap rather than a missing flag here.
# `CC=pcc -c' is what every other APE package in this tree says
# (`cmd/tar/mkfile:79', `cmd/core/mkfile:206'); `mkone's own `%.$O: %.c'
# rule is `$CC $CFLAGS $stem.c' with no -c of its own, so the -c has to
# arrive through CC or through CFLAGS and this file had it in neither.
# LD stays bare: the link is the one place pcc should link.
CC=pcc -c
LD=pcc
# -DHAVE_C_BOOL: kencc's `bool' is a keyword, so dist's own
# `typedef int bool;' in a.h is a syntax error and the build stopped on
# the first file.  The guard is upstream-shaped (bash's bashansi.h uses
# this exact name) and the capability is declared HERE rather than sniffed
# from a compiler macro -- see the comment in a.h.
#
# `-V' and `-+' are 6c flags pcc does not name, so it prints
# `cc: flag -V ignored' twice per file and carries on.  They are left in
# because they are upstream's own list from src/make.rc and removing them
# would make this line diverge from the one go documents.
# -DGOROOT_FINAL: the quotes are PLAIN, and the backslashes that used to be
# here are a Makefile idiom that rc and mk do not share.  It read
# `-DGOROOT_FINAL=\\"$APEXPROOT/...\\"', so cpp defined the macro as
# `\"...\"' and `build.c:21', `char *goroot = GOROOT_FINAL;', answered
#
#	build.c:21[stdin:207] syntax error, last name: goroot
#
# -- a C syntax error two files further on, naming the variable rather than
# the flag.  **mk gives double quotes no meaning and passes them through**
# (the same mechanism `cmd/c++lib's `CLEANFILES= "*.c"' paid a round for,
# from the other side), and rc never re-lexes the CONTENTS of an expanded
# variable -- which is why every `-DFOO=1' in this tree is safe through
# $CFLAGS and why a literal `=' in a recipe is not.  So a bare `"' survives
# into the argument exactly as written and no escape is wanted.
# ***-DAPEXP_PLAN9_HOST AND NOT -DPLAN9, AND THAT WAS THE FOURTH WALL.***
#
# `-DPLAN9' was doing two unrelated jobs and only one of them was
# wrong.  At COMPILE time it is `is this native Plan 9 C?' -- three
# uses, all that question: `plan9.c:10' compiles 764 lines of <u.h>
# and <libc.h> under it, `unix.c:11' switches the POSIX file off under
# it, and `a.h:37' drops `USED' because native <libc.h> has one.
# **Under APE all three answers are NO**, which is why the build died
# at `plan9.c:13 Could not find include file <libc.h>': dist compiles
# all three portability files and the flag had picked the one this
# compiler cannot read, while `unix.c' -- 843 lines of POSIX whose
# nine includes all exist here -- sat switched off.
#
# At RUN time `gohostos' is `which OS is dist BUILDING for?', and
# there the answer is plan9, in seven places in `build.c' including
# the one that emits `-DPLAN9' for the stage-2 toolchain, where it is
# right because the Go runtime's C really is native.
#
# So the flag is renamed rather than removed, and `unix.c' gets one
# `#elif' arm setting `gohostos = "plan9"'.  **Removing it alone would
# have left dist calling `fatal("unknown operating system")'** -- the
# `#elif' chain is compile-time and has no plan9 arm, and keying it on
# `uname()' would not work either, since libap answers sysname `Plan9'
# and that chain never reads it.  *Two macros, one question each.*
#
# Declared here rather than sniffed from a compiler macro, for the same
# reason as -DHAVE_C_BOOL above.
# ***GOROOT HAS TO BE ABSOLUTE, AND `$APEXPROOT' IS NOT.***
#
# `APEXPROOT' is `../../../../..' -- correct relative to THIS
# directory and baked into the binary as a literal.  **dist chdir's
# into each library it builds**, so the moment it enters
# `$GOROOT/src/lib9' that path means something else:
#
#	go tool dist: missing file
#	  .../go1.4/src/lib9/../../../../../sys/src/external/go1.4/include/fmt.h
#
# and `include/fmt.h' is right there.  Count the `..' from `src/lib9'
# -- five levels reaches `APExp/sys', and then `sys/src/...' is
# appended to it, so the path has `sys/' TWICE.  *The file was never
# missing; the root moved under it.*
#
# `pwd' at mk-parse time fixes it once.  The backquote runs where this
# mkfile is, so `cd $APEXPROOT && pwd' is the repository root in
# absolute form, and it contains no `=' and no `!' -- the two things
# `lib/onig/mkfile' hit in consecutive rounds.
GOROOTABS=`{cd $APEXPROOT && pwd}

CFLAGS=-FTVwp+ -DAPEXP_PLAN9_HOST -DHAVE_C_BOOL -DGOROOT_FINAL="$GOROOTABS/sys/src/external/go1.4"

# make.rc generates the Plan 9 libc declarations before compiling dist.
libc_plan9.h:V:
	cd $GOSRC/src && ../include/plan9/mklibc.rc > ../include/plan9/libc_plan9.h

all: $O.out

$O.out: libc_plan9.h

%.$O: $GODIST/%.c
	$CC $CFLAGS $prereq

nuke:V:
	rm -f *.[$OS] [$OS].out
	rm -f $BIN/go-dist
