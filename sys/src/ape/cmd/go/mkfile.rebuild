APEXPROOT=../../../../..
APE=$APEXPROOT/sys/src/ape
<$APE/config

GOSRC=../../../external/go1.4

# ***`GOSRCABS' WAS NOT ABSOLUTE, AND THE NAME SAID IT WAS.***
# `$APEXPROOT' is `../../../../..', so this was a relative path with
# `ABS' in its name -- and `$GOTOOLDIR' below is built from it and
# handed to a program that chdir's.
#
# WHY IT SEEMED TO WORK.  `sys/src/ape/cmd/go' and
# `sys/src/external/go1.4/src' are BOTH five levels below the
# repository root, so `cd $GOSRC/src' leaves every `$APEXPROOT'-
# relative path still resolving -- by coincidence, not by design.
# **It breaks at any other depth**, which is what `src/lib9' (six
# levels) hit:
#
#	go tool dist: missing file .../src/lib9/../../../../../sys/...
#
# with `sys/' appearing twice in the result.  *A path that works
# because two unrelated directories happen to sit at the same depth is
# a coincidence waiting for a third one.*
GOROOTABS=`{cd $APEXPROOT && pwd}
GOSRCABS=$GOROOTABS/sys/src/external/go1.4
BIN=$APEXPROOT/$objtype/bin/ape
GOARCH=$objtype
GOTOOLDIR=$GOSRCABS/pkg/tool/plan9_$GOARCH

# Stage 2 follows src/make.rc. dist bootstrap builds lib9/libbio/liblink,
# the host C compiler tools and go_bootstrap in cmd/dist/build.c's
# buildorder. It also generates architecture tables and runtime source
# files during the build. Go packages are built by ape/lib2/go, after
# this compiler bootstrap has completed.
install:V:
	cd $GOSRC/src && $BIN/go-dist bootstrap -a -v

installall:V:
	mk install

clean:V:
	if(test -x $BIN/go-dist) @{
		cd $GOSRC/src && $BIN/go-dist clean
	}
	rm -f $BIN/go

nuke:V:
	mk clean
	rm -f $BIN/go-dist
