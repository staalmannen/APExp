</$objtype/mkfile
APEXPROOT=../../../../..

BIN=$APEXPROOT/$objtype/bin/ape
TARG=sed

OFILES=	compile.$O\
		debug.$O\
		execute.$O\
		mbcs.$O\
		regexp.$O\
		sed.$O\
		utils.$O\
		version.$O

# lib objs from Makefile
# I think I can comment out a lot of them
LIB_OBJS=\
	copy-acl.$O\
	acl-internal.$O\
	get-permissions.$O\
	set-permissions.$O\
	c-strcasecmp.$O\
	dfa.$O\
	localeinfo.$O\
	exitfail.$O\
	free.$O\
	fwriting.$O\
	getprogname.$O\
	dynarray_at_failure.$O\
	dynarray_emplace_enlarge.$O\
	dynarray_finalize.$O\
	dynarray_resize.$O\
	obstack.$O\
	progname.$O\
	qcopy-acl.$O\
	quotearg.$O\
	regex.$O\
	strerror.$O\
	unistd.$O\
	version-etc.$O\
	version-etc-fsf.$O\
	xmalloc.$O\
	xalloc-die.$O


LIB= libgnu.a$O
BIN=$APEXPROOT/$objtype/bin/ape

<$APEXPROOT/sys/src/cmd/mkone

GSEDSRC=../../../external/gsed

#during building from scratch, the new pcc is not picked up and compilation
#fails on include_next
CC=$APEXPROOT/$objtype/bin/pcc

CFLAGS=-c -I. -I$GSEDSRC -I$GSEDSRC/sed -I$GSEDSRC/lib -B -DHAVE_CONFIG_H\
		-DLOCALEDIR="/sys/lib/ape/locale"

%.$O: $GSEDSRC/sed/%.c
	$CC $CFLAGS $GSEDSRC/sed/$stem.c

%.$O: $GSEDSRC/lib/%.c
	$CC $CFLAGS $GSEDSRC/lib/$stem.c

%.$O: $GSEDSRC/lib/malloc/%.c
	$CC $CFLAGS $GSEDSRC/lib/malloc/$stem.c

%.$O: $GSEDSRC/lib/glthread/%.c
	$CC $CFLAGS $GSEDSRC/lib/glthread/$stem.c

libgnu.a$O: $LIB_OBJS
			ar vu libgnu.a$O $LIB_OBJS

install:V:
		cp $GSEDSRC/doc/sed.1 $APEXPROOT/sys/man/1/sed
