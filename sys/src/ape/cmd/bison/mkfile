LIB_OBJS=\
	liby_a-main.$O \
	liby_a-yyerror.$O

LIB=libbison.a$O ../gnulib/libgnu.a$O

BIN=$APEXPROOT/$objtype/bin/ape

<$APEXPROOT/sys/src/cmd/mkone

BISONSRC=../../../external/bison

#during building from scratch, the new pcc is not picked up and compilation
#fails on include_next
CC=$APEXPROOT/$objtype/bin/pcc

# Include order matters here, and each position is load bearing.
#
#   -I.               ./config.h, which layers bison's package identity
#                     over the shared gnulib one. See that file.
#   -I$BISONSRC/src   bison's own headers. configmake.h is the one that
#                     matters: it is the sole header name bison/src
#                     shares with the gnulib tree, it is hand-edited
#                     here to give PKGDATADIR "/sys/lib/ape", and the
#                     gnulib copy has no PKGDATADIR at all.
#   -I$GNUSRC         shared module headers, ahead of bison's own copies
#                     of the same 203 names. bison's gnulib is from 2021
#                     and libgnu.a is built from 2026 sources, so its
#                     headers would declare an older API than the
#                     objects provide. location.c includes mbchar.h, and
#                     the 2021 one has an inline reading is_basic_table[],
#                     a table the 2026 mbchar.c no longer defines:
#                       _convM2D: is_basic_table: not defined
#   -I$BISONSRC/lib   last, for the headers only bison provides.
GNUSRC=$APEXPROOT/sys/src/external/gnulib
CFLAGS=-c -I. -I$BISONSRC/src -I$BISONSRC -I$GNUSRC -I$BISONSRC/lib\
		-B -DHAVE_CONFIG_H\
		-DLOCALEDIR="/sys/lib/ape/locale"

CLEANFILES=$LIB

bison-%.$O: $BISONSRC/src/%.c
	$CC $CFLAGS -c $prereq -o $target

%.$O: $BISONSRC/lib/%.c
	$CC $CFLAGS $prereq -o $target

%.$O: $BISONSRC/lib/bitset/%.c
	$CC $CFLAGS $prereq -o $target

%.$O: $BISONSRC/lib/malloc/%.c
	$CC $CFLAGS $prereq -o $target

%.$O: $BISONSRC/lib/unistr/%.c
	$CC $CFLAGS $prereq -o $target

%.$O: $BISONSRC/lib/glthread/%.c
	$CC $CFLAGS $prereq -o $target

%.$O: $BISONSRC/lib/uniwidth/%.c
	$CC $CFLAGS $prereq -o $target

liby_a-%.$O: $BISONSRC/lib/%.c
	$CC $CFLAGS $prereq -o $target

libbison.a$O: $LIB_OBJS
		ar vu libbison.a$O $LIB_OBJS

install:V:
		cp $BISONSRC/doc/bison.1 $APEXPROOT/sys/man/1/bison
		cp $BISONSRC/doc/yacc.1 $APEXPROOT/sys/man/1/yacc



