OFILES=\
	bison-AnnotationList.$O \
	bison-InadequacyList.$O \
	bison-Sbitset.$O \
	bison-assoc.$O \
	bison-closure.$O \
	bison-complain.$O \
	bison-conflicts.$O \
	bison-counterexample.$O \
	bison-derivation.$O \
	bison-derives.$O \
	bison-files.$O \
	bison-fixits.$O \
	bison-getargs.$O \
	bison-glyphs.$O \
	bison-gram.$O \
	bison-graphviz.$O \
	bison-ielr.$O \
	bison-lalr.$O \
	bison-location.$O \
	bison-lr0.$O \
	bison-lssi.$O \
	bison-main.$O \
	bison-muscle-tab.$O \
	bison-named-ref.$O \
	bison-nullable.$O \
