LIB_OBJS=\
	liby_a-main.$O \
	liby_a-yyerror.$O

LIB=libbison.a$O ../gnulib/libgnu.a$O

BIN=$APEXPROOT/$objtype/bin/ape

<$APEXPROOT/sys/src/cmd/mkone

BISONSRC=../../../external/bison

#during building from scratch, the new pcc is not picked up and compilation
#fails on include_next
CC=$APEXPROOT/$objtype/bin/pcc

# Include order matters here, and each position is load bearing.
#
#   -I.               ./config.h, which layers bison's package identity
#                     over the shared gnulib one. See that file.
#   -I$BISONSRC/src   bison's own headers. configmake.h is the one that
#                     matters: it is the sole header name bison/src
#                     shares with the gnulib tree, it is hand-edited
#                     here to give PKGDATADIR "/sys/lib/ape", and the
#                     gnulib copy has no PKGDATADIR at all.
#   -I$GNUSRC         shared module headers, ahead of bison's own copies
#                     of the same 203 names. bison's gnulib is from 2021
#                     and libgnu.a is built from 2026 sources, so its
#                     headers would declare an older API than the
#                     objects provide. location.c includes mbchar.h, and
#                     the 2021 one has an inline reading is_basic_table[],
#                     a table the 2026 mbchar.c no longer defines:
#                       _convM2D: is_basic_table: not defined
#   -I$BISONSRC/lib   last, for the headers only bison provides.
GNUSRC=$APEXPROOT/sys/src/external/gnulib
CFLAGS=-c -I. -I$BISONSRC/src -I$BISONSRC -I$GNUSRC -I$BISONSRC/lib\
		-B -DHAVE_CONFIG_H\
		-DLOCALEDIR="/sys/lib/ape/locale"

CLEANFILES=$LIB

bison-%.$O: $BISONSRC/src/%.c
	$CC $CFLAGS -c $prereq -o $target

%.$O: $BISONSRC/lib/%.c
	$CC $CFLAGS $prereq -o $target

%.$O: $BISONSRC/lib/bitset/%.c
	$CC $CFLAGS $prereq -o $target

%.$O: $BISONSRC/lib/malloc/%.c
	$CC $CFLAGS $prereq -o $target

%.$O: $BISONSRC/lib/unistr/%.c
	$CC $CFLAGS $prereq -o $target

%.$O: $BISONSRC/lib/glthread/%.c
	$CC $CFLAGS $prereq -o $target

%.$O: $BISONSRC/lib/uniwidth/%.c
	$CC $CFLAGS $prereq -o $target

liby_a-%.$O: $BISONSRC/lib/%.c
	$CC $CFLAGS $prereq -o $target

libbison.a$O: $LIB_OBJS
		ar vu libbison.a$O $LIB_OBJS

# bison cannot generate a parser from the program alone. It shells out
# to m4 -- config.h says /bin/m4, which mount-include now puts on the
# path -- and feeds it a skeleton and the m4sugar library, both read
# from PKGDATADIR at run time. src/configmake.h sets that to
# /sys/lib/ape/bison; this is what puts the files there.
#
# Until now nothing in the tree had ever run bison, so it had never
# mattered that only the man pages were installed. objc's stage 2 is
# the first, and got no diagnostic at all -- bison read yacc.ym and
# then aborted.
#
# xslt and the css are for bison --html and are small; installing the
# whole data directory keeps this from having to track which skeletons
# upstream adds.
# Plan 9's tar, by full path, rather than dircp.
#
# Inside apexp-sh both /bin/tar and /bin/dircp are the APE ones -- it
# binds $cputype/bin/ape and rc/bin/ape with -b -- and rc/bin/ape/dircp
# says so itself: "copy a tree with ape's tar". So an install step that
# says dircp gets GNU tar, and GNU tar does not currently work here:
#
#	tar: suicide: bad address in notify
#	: This does not look like a tar archive
#
# Copying a tree during a build should not depend on which tar the
# session happens to prefer, so this names Plan 9's.
P9TAR=/$cputype/bin/tar

BISONDATA=$APEXPROOT/sys/lib/ape/bison

install:V:
		cp $BISONSRC/doc/bison.1 $APEXPROOT/sys/man/1/bison
		cp $BISONSRC/doc/yacc.1 $APEXPROOT/sys/man/1/yacc
		mkdir -p $BISONDATA
		@{cd $BISONSRC/data && $P9TAR cf /fd/1 .} | @{cd $BISONDATA && $P9TAR xf /fd/0}

# A prerequisite with no recipe, not a second nuke recipe: mkone's nuke
# carries one and takes no prerequisites, so two recipes would leave mk
# to pick one silently. mkone's install is prerequisite-only, which is
# why adding to it above is safe.
nuke:V:	bisondatanuke

bisondatanuke:V:
		rm -rf $BISONDATA



