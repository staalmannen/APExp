APEXPROOT=../../../../..
APE=$APEXPROOT/sys/src/ape
<$APE/config

BASICSRC=../../../external/BASIC/src

TARG=bacon

BIN=$APEXPROOT/$objtype/bin/ape

OFILES= bacon.bac.$O

# **NO `LIB=' LINE, AND ITS ABSENCE IS THE FIX.** This mkfile used to
# carry `LIB=$APEXPROOT/$objtype/lib/ape/liblua.a', copied from
# cmd/lua. In `mkone' $LIB is a PREREQUISITE of $O.out and is handed
# to $LD with the rest of $prereq -- so bacon was linked against Lua's
# archive and could not be built at all until lua had been. bacon
# needs nothing but libap, which pcc links by itself.

# **$BASICSRC/*.h ARE GENERATED, AND ALL OF THEM BELONG HERE.**
# `bacon.bac.c' includes `bacon.bac.h', which includes the other 78 --
# one per BaCon FUNCTION/SUB -- so a regeneration changes files that
# appear nowhere in OFILES. Nothing in these mkfiles lists a header as
# a dependency unless HFILES does (see CLAUDE.md: *a header not in
# HFILES is a header mk does not rebuild for*, which cost three rounds
# on tclBinary.c and bash's config.h). They are listed out rather than
# globbed because mk fails outright on an HFILES naming a file that is
# not there, and a literal list says exactly which generation this
# tree expects.
HFILES=\
	$BASICSRC/bacon.Assign_To_Number.h \
	$BASICSRC/bacon.Assign_To_String.h \
