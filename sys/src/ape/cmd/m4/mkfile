</$objtype/mkfile
APEXPROOT=../../../../..
TARG=m4
LIB=../gnulib/libgnu.a$O\
	$APEXPROOT/$objtype/lib/ape/libintl.a\
	$APEXPROOT/$objtype/lib/ape/libxml2.a

OFILES=\
	#src\
		builtin.$O\
		debug.$O\
		eval.$O\
		format.$O\
		freeze.$O\
		input.$O\
		m4.$O\
		macro.$O\
		output.$O\
		path.$O\
		symtab.$O

#minimized gnulib
BIN=$APEXPROOT/$objtype/bin/ape
HFILES=config.h

<$APEXPROOT/sys/src/cmd/mkone

M4SRC=../../../external/m4

#during building from scratch, the new pcc is not picked up and compilation
#fails on include_next
CC=$APEXPROOT/$objtype/bin/pcc

UNRPL= -Drpl_readlink=readlink -Drpl_lseek=lseek -Drpl_posix_spawn_file_actions_addopen=posix_spawn_file_actions_addopen\
		-Drpl_open=open -Drpl_free=free -Drpl_malloc=malloc -Drpl_strtod=strtod -Drpl_realloc=realloc -Drpl_calloc=calloc\
		-Drpl_fcntl=fcntl -Drpl_mkstemp=mkstemp


# -I. finds this directory's config.h, which layers package identity
# over config-common.h. -I$GNUSRC comes before the package's own lib
# directory so the shared module headers match the objects in
# libgnu.a; the package's copies are older than the 2026 sources the
# library is built from, and a mismatch shows up at link time as a
# missing symbol rather than at compile time.
GNUSRC=$APEXPROOT/sys/src/external/gnulib
CFLAGS=-c -B -I. -I$GNUSRC -I$M4SRC -I$M4SRC/src -I$M4SRC/lib -DHAVE_CONFIG_H\
	-D__USE_GNU -D_REGEX_LARGE_OFFSETS -D_POSIX_SOURCE -DO_BINARY=0\
	-D_BSD_EXTENSION -DSETLOCALE_NULL_MAX=(256+1) $UNRPL

%.$O: $M4SRC/src/%.c
	$CC $CFLAGS $M4SRC/src/$stem.c

%.$O: $M4SRC/lib/%.c
	$CC $CFLAGS $M4SRC/lib/$stem.c

%.$O: $M4SRC/lib/malloc/%.c
	$CC $CFLAGS $M4SRC/lib/malloc/$stem.c

%.$O: $M4SRC/lib/glthread/%.c
	$CC $CFLAGS $M4SRC/lib/glthread/$stem.c
