</$objtype/mkfile
APEXPROOT=../../../../..

TARG=tar

# argp, and the getopt it is layered on, built here as tar's own objects
# rather than added to the shared libgnu.a. See the note below the
# CFLAGS for why.
ARGP_OBJS=\
	argp-ba.$O\
	argp-eexst.$O\
	argp-fmtstream.$O\
	argp-fs-xinl.$O\
	argp-help.$O\
	argp-parse.$O\
	argp-pin.$O\
	argp-pv.$O\
	argp-pvh.$O\
	argp-version-etc.$O\
	argp-xinl.$O\
	getopt.$O\
	getopt1.$O

OFILES=\
	buffer.$O\
	checkpoint.$O\
	compare.$O\
	create.$O\
	delete.$O\
	exit.$O\
	exclist.$O\
	extract.$O\
	xheader.$O\
	incremen.$O\
	list.$O\
	map.$O\
	misc.$O\
	names.$O\
	sparse.$O\
	suffix.$O\
	system.$O\
	tar.$O\
	transform.$O\
	unlink.$O\
	update.$O\
	utf8.$O\
	warning.$O\
	xattrs.$O\
	version-etc.$O\
	$ARGP_OBJS

# tar's own support library, not gnulib: paxutils, the rmt client and
# the wordsplit parser. These stay.
LIBTAR_OBJS=\
	paxerror.$O\
	paxexit-status.$O\
	paxnames.$O\
	rtapelib.$O\
	wordsplit.$O\
	xattr-at.$O

LIB=libtar.a$O ../gnulib/libgnu.a$O
BIN=$APEXPROOT/$objtype/bin/ape

GTARSRC=$APEXPROOT/sys/src/external/gtar
GNUSRC=$APEXPROOT/sys/src/external/gnulib

# Set before the include: mkone expands "%.$O: $HFILES" where it reads
# it, so a later assignment would come too late and editing a config
# header would rebuild nothing.
HFILES=\
	config.h\
	rmt-command.h\
	$GNUSRC/config-common.h\
	$GNUSRC/apexp-decls.h\

<$APEXPROOT/sys/src/cmd/mkone

CC=pcc -c

# $GTARSRC/gnu is deliberately absent, and so are the rules that built
# from it. That directory is tar's own vendored gnulib, 278 sources of
# it, and the point of the shared libgnu.a is that there is one copy of
# each module. Two symptoms of having both:
#
#   mk: ambiguous recipes for unlink.6:
#       unlink.6 <-(mkfile:46)- .../gtar/src/unlink.c
#       unlink.6 <-(mkfile:52)- .../gtar/gnu/unlink.c
#
# and its obstack.h and time.h shadow APE's, the trap that cost diff a
# round of failures.
#
# -I. finds this directory's config.h, which layers tar's identity over
# config-common.h. -I$GNUSRC comes next so the module headers match the
# objects in libgnu.a. Nothing in $GTARSRC/src or $GTARSRC/lib shadows
# an APE header, so they can follow.
CFLAGS=-B -p -I. -I$GNUSRC -I$GTARSRC -I$GTARSRC/src -I$GTARSRC/lib\
	-DHAVE_CONFIG_H -DLOCALEDIR="/sys/lib/ape/locale"

%.$O: $GTARSRC/src/%.c
	$CC $CFLAGS $GTARSRC/src/$stem.c

%.$O: $GTARSRC/lib/%.c
	$CC $CFLAGS $GTARSRC/lib/$stem.c

# rmt-command.h is generated, not shipped. tar's lib/Makefile.am writes
# it at build time:
#
#   echo "# define DEFAULT_RMT_COMMAND \"$(DEFAULT_RMT_DIR)/rmt\""
#
# and both src/tar.c and lib/rtapelib.c include it. Generated into this
# directory rather than the external tree, as diff's version.c is, so
# the source stays clean.
rmt-command.h:
	echo '#ifndef DEFAULT_RMT_COMMAND' >rmt-command.h
	echo '#define DEFAULT_RMT_COMMAND "/bin/ape/rmt"' >>rmt-command.h
	echo '#endif' >>rmt-command.h

CLEANFILES=rmt-command.h

# argp is tar's option parser, and it is built here rather than added to
# the shared libgnu.a.
#
# argp-parse.c reaches past getopt's public interface into its reentrant
# internals -- <getopt_int.h>, struct _getopt_data, _getopt_long_r and
# _getopt_long_only_r. Those live in gnulib's getopt1.c, which also
# defines getopt_long and getopt_long_only, and gnulib's getopt.c
# defines optarg, optind, opterr and optopt. libap defines all six
# (misc/getopt.c and misc/getopt_long.c), so gnulib's getopt cannot go
# into libgnu.a without every package that links it silently changing
# which getopt it uses.
#
# As tar's own objects they are named on the link line rather than
# waiting in an archive, so they define those six before libap.a is
# searched and libap's members are simply never pulled. That is the
# same precedence that lets libgnu.a's error() win over libap's. It
# holds only while nothing drags libap's getopt in for some other
# symbol: tar calls no plain getopt(), and argp-pin.$O is included so
# that program_invocation_name does not pull libap's stdio/error.c.
#
# The sources come from $GNUSRC, not $GTARSRC/gnu: the shared tree has
# the whole argp family, argp.h, argp-namefrob.h, argp-fmtstream.h and
# getopt_int.h, at a newer vintage, and none of those files includes a
# header that $GTARSRC/gnu would shadow.
%.$O: $GNUSRC/%.c
	$CC $CFLAGS $GNUSRC/$stem.c

# unlink.c is the one basename the shared tree and $GTARSRC/src share,
# so the rule above and the $GTARSRC/src rule both match unlink.$O --
# the same ambiguity $GTARSRC/gnu used to cause. An explicit rule for
# the target settles it: tar's src/unlink.c handles its deferred
# unlinking, while gnulib's is a replacement for the system call that is
# not in libgnu.a and that tar does not want.
unlink.$O: $GTARSRC/src/unlink.c
	$CC $CFLAGS $GTARSRC/src/unlink.c

# version-etc per package, not from the shared archive: it compiles
# PACKAGE_BUGREPORT, PACKAGE_NAME and PACKAGE_URL into the object, so a
# shared copy would report whichever package built it. argp-version-etc.c
# calls version_etc_ar, so tar needs it either way.
version-etc.$O: $GNUSRC/version-etc.c
	$CC $CFLAGS $GNUSRC/version-etc.c

# Anything that must come from tar's own vendored gnulib is built with a
# gnu- prefix on the object, so two sources of the same name in
# $GTARSRC/src and $GTARSRC/gnu cannot produce the same target:
#
#   mk: ambiguous recipes for unlink.6:
#       unlink.6 <-(mkfile:46)- .../gtar/src/unlink.c
#       unlink.6 <-(mkfile:52)- .../gtar/gnu/unlink.c
#
# Nothing uses these at the moment -- everything tar needs is either in
# the shared libgnu.a or built above -- but a module whose 2026 version
# does not suit tar 1.35 can be listed as gnu-<name>.$O without
# disturbing anything else. $GTARSRC/gnu goes last on the include path
# so its obstack.h and time.h cannot shadow APE's for these objects.
gnu-%.$O: $GTARSRC/gnu/%.c
	$CC $CFLAGS -I$GTARSRC/gnu -o gnu-$stem.$O $GTARSRC/gnu/$stem.c

gnu-%.$O: $GTARSRC/gnu/malloc/%.c
	$CC $CFLAGS -I$GTARSRC/gnu -o gnu-$stem.$O $GTARSRC/gnu/malloc/$stem.c

gnu-%.$O: $GTARSRC/gnu/unicase/%.c
	$CC $CFLAGS -I$GTARSRC/gnu -o gnu-$stem.$O $GTARSRC/gnu/unicase/$stem.c

gnu-%.$O: $GTARSRC/gnu/unictype/%.c
	$CC $CFLAGS -I$GTARSRC/gnu -o gnu-$stem.$O $GTARSRC/gnu/unictype/$stem.c

gnu-%.$O: $GTARSRC/gnu/uniwidth/%.c
	$CC $CFLAGS -I$GTARSRC/gnu -o gnu-$stem.$O $GTARSRC/gnu/uniwidth/$stem.c

# There is deliberately no rule here that adds objects to
# ../gnulib/libgnu.a. One used to stand at the end of this file:
#
#   ../gnulib/libgnu.a$O: $GNU_OBJS
#           ar vu ../gnulib/libgnu.a$O $prereq
#
# 'ar vu' only appends, so a package reaching into the shared archive
# leaves members behind that outlive the list that put them there --
# the stale-member trap that made gnulib's obstack collide with libap's.
# The shared archive is built once, by ../gnulib/mkfile, which deletes
# it first. A module tar needs goes in that mkfile's OFILES.
libtar.a$O: $LIBTAR_OBJS
	ar vu libtar.a$O $LIBTAR_OBJS
