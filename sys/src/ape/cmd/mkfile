APE=../../ape
<$APE/config
APEXPROOT=../../../..

# core comes after base on purpose. Both install into $BIN, and sbase's
# TARG has been cut back to what coreutils does not cover, so nothing
# should collide -- but the order is the backstop if one ever creeps
# back in.
#
# Every comment line INSIDE these lists has to end in a backslash, as
# the ones below do: the list is one continued line, and a comment
# without it ends the assignment there.
_CORE_APPS=\
# shared gnulib: must be first, several apps below link ../gnulib/libgnu.a \
	gnulib\
# shell\
	dash\
	bash\
# parsing/editing source etc \
	as\
	lex\
	bison\
	awk\
	sed\
	make\
# often invoked during make \
	m4\
	iconv\
	gettext\
	libtool\
	pkgconf\
# core utilities \
	base\
	grep\
	core\

_OPTIONAL_APPS=\
# archivers \
	bzip2\
	clzip\
	minigzip\
	unace\
	unarj\
	unrar\
	xz\
	zstd\
	tar\
# pax builds one binary and installs it as both pax and cpio; tar is \
# not installed from it, GNU tar above is the one \
	pax\
# languages \
	lua\
	tclsh\
#	perl\
# GUI \
	wish\
# transpilers \
	f2c\
	p2c\
	chicken\
	objc\
	cfront\
#		c++lib\
#	basic\
# dev tools \
	adeb\
	dwarfdump\
	hell\
	pcregrep\
	diff\
	patch\
	mkmk\
	samurai\
# TLS: openssl(1) from LibreSSL, and curl. Both need the libraries \
# built first -- see the _TLS_LIBS note in ../lib/mkfile \
	openssl\
	curl\
# libzip's three tools; needs ../lib/zip, which is built last there \
	zip\

DIRS=\
	$_CORE_APPS\
	$_OPTIONAL_APPS\
# always last :) \
	celebrate_finish

BIN=$APEXPROOT/$objtype/bin/ape
<$APEXPROOT/sys/src/cmd/mkmany

all:V:	$DIRS

install:V:	install.dir

installall:V:	installall.dir

clean:V:	clean.dir

nuke:V:		nuke.dir

%.dir:V:
	for (i in $DIRS) @{
		cd $i
		echo '----'$i'----'
		mk $stem
	}

$DIRS:V:
	for (i in $target) @{
		cd $i
		echo '----'$i'----'
		mk all
	}


