APE=../../ape
<$APE/config
APEXPROOT=../../../..

# core comes after base on purpose. Both install into $BIN, and sbase's
# TARG has been cut back to what coreutils does not cover, so nothing
# should collide -- but the order is the backstop if one ever creeps
# back in.
#
# Every comment line INSIDE these lists has to end in a backslash, as
# the ones below do: the list is one continued line, and a comment
# without it ends the assignment there.
# bash IS sh: cmd/bash/mkfile's install rule does `cp $BIN/bash $BIN/sh',
# and dash is gone from this list and from sys/src/external. One shell in
# the tree rather than two -- see CLAUDE.md for what it cost to get here.

_CORE_APPS=\
# shared gnulib: must be first, several apps below link ../gnulib/libgnu.a \
	gnulib\
# shell\
	bash\
# parsing/editing source etc \
	as\
	lex\
	bison\
	awk\
	sed\
	re2c\
	make\
# often invoked during make \
	m4\
	iconv\
	gettext\
	libtool\
	pkgconf\
# core utilities \
	base\
	grep\
	core\

_OPTIONAL_APPS=\
# archivers \
	bzip2\
	clzip\
	minigzip\
	unace\
	unarj\
	unrar\
	lz4\
	xz\
	zstd\
	zip\
	tar\
	pax\
# languages \
#	go\
	lua\
	sqlite\
	tclsh\
	itclsh\
	perl\
# GUI \
	wish\
# transpilers \
	f2c\
	p2c\
	chicken\
	objc\
	cfront\
# c++lib: cfront emits NOTHING. All 40 `.c' under cmd/c++lib were \
# committed at ZERO BYTES, so the archive built clean and empty and the \
# build "succeeded" -- a check that cannot fail. Leave off until a \
# cfront run produces a non-empty .c. \
#		c++lib\
# basic: the generated C in external/BASIC/src was a TRUNCATED bacon.sh \
# run (276KB against 531KB) and gcc rejected it with 50 errors. It is \
# regenerated now and gcc gives 0, including the classes 6c treats as \
# fatal -- but it has never been through pcc. Build it by hand first \
# (cd basic && mk install); uncomment once that works, because a \
# failing entry here aborts the whole tree's mk. \
#	basic\
# dev tools \
	adeb\
	dwarfdump\
	hell\
	pcregrep\
	diff\
	patch\
	mkmk\
	samurai\
#	muon\
# TLS and curl \
	openssl\
	curl\

DIRS=\
	$_CORE_APPS\
	$_OPTIONAL_APPS\
# always last :) \
	celebrate_finish

BIN=$APEXPROOT/$objtype/bin/ape
<$APEXPROOT/sys/src/cmd/mkmany

all:V:	$DIRS

install:V:	install.dir

installall:V:	installall.dir

clean:V:	clean.dir

nuke:V:		nuke.dir

%.dir:V:
	for (i in $DIRS) @{
		cd $i
		echo '----'$i'----'
		mk $stem
	}

$DIRS:V:
	for (i in $target) @{
		cd $i
		echo '----'$i'----'
		mk all
	}


