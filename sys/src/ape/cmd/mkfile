APE=../../ape
<$APE/config
APEXPROOT=../../../..

# core comes after base on purpose. Both install into $BIN, and sbase's
# TARG has been cut back to what coreutils does not cover, so nothing
# should collide -- but the order is the backstop if one ever creeps
# back in.
#
# Every comment line INSIDE these lists has to end in a backslash, as
# the ones below do: the list is one continued line, and a comment
# without it ends the assignment there.
# bash IS sh: cmd/bash/mkfile's install rule does `cp $BIN/bash $BIN/sh',
# and dash is gone from this list and from sys/src/external. One shell in
# the tree rather than two -- see CLAUDE.md for what it cost to get here.

_CORE_APPS=\
# shared gnulib: must be first, several apps below link ../gnulib/libgnu.a \
	gnulib\
# shell\
	bash\
# parsing/editing source etc \
	as\
	lex\
	bison\
	awk\
	sed\
	re2c\
	make\
# often invoked during make \
	m4\
	iconv\
	gettext\
	libtool\
	pkgconf\
# core utilities \
	base\
	grep\
	core\

_OPTIONAL_APPS=\
# archivers \
	bzip2\
	clzip\
	minigzip\
	unace\
	unarj\
	unrar\
	lz4\
	xz\
	zstd\
	zip\
	tar\
	pax\
# languages \
	go\
	lua\
	sqlite\
	php\
	clisp\
	tclsh\
	itclsh\
# GUI \
	wish\
# transpilers \
	f2c\
	p2c\
	chicken\
	objc\
	edg\
	basic\
# dev tools \
	adeb\
	dwarfdump\
	hell\
	pcregrep\
	diff\
	patch\
	mkmk\
	samurai\
	muon\
# TLS and curl \
	openssl\
	curl\

# perl is gated on the word size: its hand-answered `config.h' says
# `PTRSIZE 8' and `IVSIZE 8', which on an ILP32 target is a lie about
# the machine and more 64-bit arithmetic than `8c' has registers for.
# The reasoning, and the five other files with the same shape, are on
# `../lib/mkfile' and in `docs/releases/0.6.md'.  Deferred, not fixed.
_LLP64_ONLY_APPS=`{if(~ $objtype amd64 arm64 power64) echo perl}

DIRS=\
	$_CORE_APPS\
	$_OPTIONAL_APPS\
	$_LLP64_ONLY_APPS\
# always last :) \
	celebrate_finish

BIN=$APEXPROOT/$objtype/bin/ape
<$APEXPROOT/sys/src/cmd/mkmany

all:V:	$DIRS

install:V:	install.dir

installall:V:	installall.dir

clean:V:	clean.dir

nuke:V:		nuke.dir

%.dir:V:
	for (i in $DIRS) @{
		cd $i
		echo '----'$i'----'
		mk $stem
	}

$DIRS:V:
	for (i in $target) @{
		cd $i
		echo '----'$i'----'
		mk all
	}


