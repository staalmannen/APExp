APEXPROOT=../../../../..
APE=$APEXPROOT/sys/src/ape
<$APE/config

BIN=$APEXPROOT/$objtype/bin/ape
TARG=wish

TKSRC=$APEXPROOT/sys/src/external/tk
TCLSRC=$APEXPROOT/sys/src/external/tcl

# -DWCHAR=char is load-bearing, not a workaround: do not remove it.
# Tcl defines WCHAR only for Windows and Cygwin -- tclUnixPort.h's
# "typedef unsigned short WCHAR" sits inside #ifdef __CYGWIN__ -- yet
# tclClock.c uses WCHAR unguarded, so without this the file does not
# compile at all. char is also what Tcl itself picks elsewhere on
# non-Windows: see "#define WCHAR char" in generic/tclIOUtil.c. And it
# has to be char rather than wchar_t, because tclClock.c assigns
# getenv's char * straight to a const WCHAR *.
#
# The matching wcscmp/wcslen/wcscpy redirection lives in tclClock.c
# itself, under #ifdef PLAN9. It cannot be done with -D here: that would
# rewrite the declarations in wchar.h as well as the calls, leaving
# "extern int strcmp(const wchar_t *, const wchar_t *)" to collide with
# the real one in string.h.
CFLAGS=\
	-c\
	-I$TKSRC/generic\
	-I$TKSRC/xlib\
	-I$TKSRC/plan9\
	-I$TCLSRC/generic\
	-I$APEXPROOT/sys/include/ape\
	-I$APEXPROOT/$objtype/include/ape\
	-I$APEXPROOT/sys/src/ape/lib/tcl\
	-DHAVE_TCL_CONFIG_H\
	-DPLAN9\
	-DMODULE_SCOPE=/***/\
	-DWCHAR=char\
	-DTK_PLATFORM="plan9"\


LIB=\
	$APEXPROOT/$objtype/lib/ape/libtk.a\
	$APEXPROOT/$objtype/lib/ape/libtcl.a\
	$APEXPROOT/$objtype/lib/ape/libdraw.a\
	$APEXPROOT/$objtype/lib/ape/libpng.a\
	$APEXPROOT/$objtype/lib/ape/libz.a\
	$APEXPROOT/$objtype/lib/ape/libap.a\

OFILES=tkAppInit.$O

<$APEXPROOT/sys/src/cmd/mkone


tkAppInit.$O: $TKSRC/unix/tkAppInit.c
	$CC $CFLAGS $TKSRC/unix/tkAppInit.c

# ------------------------------------------------------------------
# tktest -- wish with Tk's own test commands compiled in, the exact
# counterpart of the tcltest target in ../tclsh/mkfile, and here for the
# same reason it is there: it shares every CFLAG and every library with
# the binary beside it. A separate cmd/tktest directory was written
# first and thrown away, because it had to copy this file's whole CFLAGS
# block -- including the -DWCHAR=char note above, which is load-bearing
# -- and a copy of a build rule is a copy that silently stops matching.
#
# It is a ":V:" target and not "default", so "mk" and "mk install" here
# still build and install wish alone; tktest is never installed.
#
#	cd sys/src/ape/cmd/wish && mk tktest
#	./tktest $home/APExp/sys/lib/tests/tk-runall.tcl >/tmp/tk-all.out >[2=1]
#
# The first three objects are upstream's TKTEST_OBJS exactly. The
# $(@TK_WINDOWINGSYSTEM@_TKTEST_OBJS) it appends is empty for X11 in
# this Tk, so there is no fourth, platform-specific object to find or
# write -- worth checking before assuming a test binary needs porting.
# Everything tkTest.c reaches on this side already existed:
# TkplatformtestInit is "TCL_OK" for anything but Windows (tkInt.h:1341),
# TkpTestembedCmd is in plan9/tkPlan9Stubs.c, TkpTesttextCmd is generic
# Tk's in tkText.c.
#
# THE STUB OBJECTS ARE THE WHOLE OF WHY A FIRST ATTEMPT DID NOT LINK.
# tkTest.c and tkSquare.c both open with
#
#	#undef STATIC_BUILD
#	#ifndef USE_TCL_STUBS
#	#   define USE_TCL_STUBS
#
# so they compile as a stub-using EXTENSION whatever the command line
# says -- that #undef exists precisely to stop -DSTATIC_BUILD turning it
# off. Without the two stub objects the link ends
#
#	Tktest_Init: undefined: Tcl_InitStubs
#	Tktest_Init: undefined: Tk_InitStubs
#	_convM2D: tclStubsPtr: not defined
#	_convM2D: tkStubsPtr / tkIntStubsPtr / tkIntPlatStubsPtr: not defined
#
# -- six symbols, all of them in generic/tclStubLib.c and
# generic/tkStubLib.c, which are the CLIENT side of the stub interfaces
# and so are in neither archive: libtcl.a and libtk.a are the core and
# carry the tables, not the things that reach them. ../tclsh/mkfile hit
# exactly this and answers it the same way.
#
# The tempting alternative is to disable the stubs under #ifdef PLAN9 --
# there is no dlopen here, nothing is ever loaded at run time, and the
# mechanism has nothing to do. That works, and it was tried first, and
# it is still the wrong trade: it edits two vendored generic files that
# the next Tk update would silently revert, to avoid compiling two
# vendored files that already exist and already build clean.
#
# AND NONE OF THE FOUR BUILDS WITH THIS FILE'S CFLAGS, which took two
# further attempts to get right. See the TESTCFLAGS block below: the
# short of it is that CFLAGS empties MODULE_SCOPE, which is fine for
# tkAppInit.c and wrong for anything that includes tkInt.h or tclInt.h.
#
# The scope of that was misjudged twice. The first attempt used CFLAGS
# for all four and did not link. The second moved the two STUB files and
# left tkTest.c and tkSquare.c on CFLAGS -- because the link error named
# only the stub symbols, and a link error is a poor guide to which
# objects are wrong: the other two linked and then died at run time,
# before printing anything.
#
# **Check every object built against a library for the flags that
# library was built with, not just the ones the linker complained
# about.** One "nm | wc -l" per object would have shown all four.
#
# WHY IT IS WORTH BUILDING: 448 tests in Tk's suite are SKIPPED for want
# of these commands -- a third as many again as the 268 that fail --
# and none of them has ever been measured here. EXPECT THE FAILURE COUNT
# TO GO UP; a skipped test is not a passing test. See the tktest section
# in CLAUDE.md for the breakdown and for how to read the first run.

TESTOFILES=tkTestInit.$O tkTest.$O tkSquare.$O tclStubLib.$O tkStubLib.$O

tktest:V: $TESTOFILES $LIB
	$LD $LDFLAGS -o $target $prereq

# Named tkTestInit rather than tkAppInit because it is the SAME source
# as wish's above, built with -DTK_TEST. Upstream renames the object for
# the same reason (Makefile.in:992): so that a wish object built without
# the flag is never picked up here, or the other way round.
tkTestInit.$O: $TKSRC/unix/tkAppInit.c
	$CC $CFLAGS -DTK_TEST -o $target $TKSRC/unix/tkAppInit.c

tkTest.$O: $TKSRC/generic/tkTest.c
	$CC $TESTCFLAGS $TKSRC/generic/tkTest.c

tkSquare.$O: $TKSRC/generic/tkSquare.c
	$CC $TESTCFLAGS $TKSRC/generic/tkSquare.c

# EVERY OBJECT THAT INCLUDES tkInt.h OR tclInt.h USES THESE, not CFLAGS
# above, and the difference that matters is MODULE_SCOPE.
#
# -DMODULE_SCOPE=extern is what sys/src/ape/lib/tk/mkfile:198 and
# lib/tcl/mkfile:107 build the libraries with, so it is simply the right
# value; CFLAGS above empties it instead, which turns every
# "MODULE_SCOPE const Tk_ObjType tkFooType;" in tkInt.h from an extern
# DECLARATION into a tentative DEFINITION. Measured on the host with nm:
#
#	object		CFLAGS above	these flags
#	tkTest.o	36 symbols	 1   (Tktest_Init)
#	tkSquare.o	25		 1
#	tclStubLib.o	38		 6
#	tkStubLib.o	30		 6
#
# The 35 extras in tkTest.o are tkMainWindowList, tkPhotoImageType,
# tkImgFmtGIF, tkStateStrings, tkTextCharType and the rest -- every one
# of which libtk.a also defines, initialised. The linker keeps one, and
# when it kept the zeroed one tktest died before printing anything:
#
#	tktest 10315: suicide: sys: trap: fault read addr=0x0 pc=0x5523a1
#	acid: src(0x5523a1)  ->  ap/arch/amd64/strlen.s:11, REPN SCASB
#
# strlen(NULL), which is what a string table that should have been
# initialised and is all zeroes gives you.
#
# CFLAGS above is harmless for the two objects that use it because
# tkAppInit.c includes tk.h and NOT tkInt.h, so it has no MODULE_SCOPE
# variable declarations to turn into definitions -- 2 symbols either way,
# measured. That is exactly why the flag has survived there, and why
# anything else added to this directory must take TESTCFLAGS instead.
#
# The include path differs too, and that half announces itself:
# tclStubLib.c reaches tclInt.h -> tclPort.h -> tclUnixPort.h, and
# neither that nor tclConfig.h is on Tk's path. A stub object is
# compiled against the tree it is the CLIENT of, not the binary it is
# linked into.
TESTCFLAGS=\
	-c\
	-I$TKSRC/generic\
	-I$TKSRC/xlib\
	-I$TKSRC/plan9\
	-I$TCLSRC/generic\
	-I$TCLSRC/plan9\
	-I$TCLSRC/unix\
	-I$TCLSRC/libtommath\
	-I$APEXPROOT/sys/src/ape/lib/tcl\
	-I$APEXPROOT/sys/include/ape\
	-I$APEXPROOT/$objtype/include/ape\
	-DHAVE_TCL_CONFIG_H\
	-DHAVE_TK_CONFIG_H\
	-DPLAN9\
	-DMODULE_SCOPE=extern\
	-DWCHAR=char\
	-DSTATIC_BUILD\

tclStubLib.$O: $TCLSRC/generic/tclStubLib.c
	$CC $TESTCFLAGS $TCLSRC/generic/tclStubLib.c

tkStubLib.$O: $TKSRC/generic/tkStubLib.c
	$CC $TESTCFLAGS $TKSRC/generic/tkStubLib.c

clean:V:
	rm -f *.[$OS] tktest $BIN/$TARG
