# **No bison and no re2c are needed anywhere in this port**, which was
# worth checking rather than assuming: `json_scanner.c' and
# `php_json_scanner_defs.h' are in the tarball too, as are the four
# Zend parsers and scanners and the 4.2MB `zend_vm_execute.h'.  A
# sweep of all 513 objects against the vendored tree found this as the
# ONLY name that does not resolve.
ext/json/json_parser.$O: $PHPSRC/ext/json/json_parser.tab.c
	mkdir -p $OBJDIRS
	$CC $CFLAGS -I$PHPSRC/ext/json $prereq -o $target


# ------------------------------------------------------------------
# ***TWO DIRECTORIES NEED FLAGS THE REST MUST NOT HAVE, AND THE RULES
# ARE EXPLICIT RATHER THAN PATTERNED ON PURPOSE.***
#
# A `ext/pcre/pcre2lib/%.$O:' meta-rule beside the general `%.$O:' one
# would be shorter, and mk probably prefers the more specific stem --
# but *probably* is recollection, and this tree's rule is that a flag
# one letter from another flag is checked rather than recalled.  There
# is no mk here to check it with, and a wrong guess costs a VM round
# trip, so these are 32 explicit rules.  Explicit beats meta-rule in
# every mk, which needs no checking at all.
#
# ***AND THE FLAGS CANNOT SIMPLY GO IN THE GLOBAL CFLAGS, WHICH WAS
# MEASURED RATHER THAN FEARED.***  pcre2 wants `-DHAVE_CONFIG_H' and
# `-I$PHPSRC/ext/pcre/pcre2lib', which holds a `config.h' -- and
# `ext/json/json.c:18', `json_encoder.c:18' and
# `main/php_odbc_utils.c:18' each read
#
#	#ifdef HAVE_CONFIG_H
#	#include <config.h>
#	#endif
#
# so the two flags together would hand three php files **pcre2's**
# config.h.  Not a failure: a different header, silently.  Upstream
# avoids it by giving every extension its own compile line, which is
# what these rules are.
#
# The Keccak `-D..._excluded' flags are why `KeccakP-200-SnP.h' was
# reported missing: it is excluded, and the exclusion is a flag rather
# than a file.
#
# All 32 were found in ONE pass -- `gcc -E' over all 513 sources on
# the host with these include paths, reporting only
