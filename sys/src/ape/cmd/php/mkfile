# The objects live beside their sources in the build directory, so the
# directories have to exist before `pcc -o' can write into them.
#
# ***THE FIRST VERSION SAID ``mkdir -p `{basename -d $target}'' AND
# THAT IS A PLAN 9 IDIOM THIS SHELL DOES NOT HAVE.***  Inside
# `apexp-sh' the union mount puts APExp's own `/bin' first, so
# `basename' is **GNU coreutils'**, which has no `-d':
#
#	basename: invalid option -- d
#	mkdir: missing operand
#
# -- and mk then reported the failure of the compile, not of the
# `mkdir'.  *The same shape as "check which `6l' answers"*: a command
# name inside `apexp-sh' is whatever the union resolves it to, and
# Plan 9's own flags are the ones most likely to be missing.
#
# So no external command at all: the directory list is known
# statically, `mkdir -p' is idempotent, and one exec per compile is
# nothing beside 513 runs of pcc.
%.$O: $PHPSRC/%.c
	mkdir -p $OBJDIRS
	$CC $CFLAGS $prereq -o $target

%.$O: %.c
	$CC $CFLAGS $stem.c

# ***ONE OBJECT IS NOT NAMED AFTER ITS SOURCE.***  `ext/json's parser
# is bison-generated, and the generated file SHIPS IN THE TARBALL as
# `json_parser.tab.c' -- so the object upstream calls
# `ext/json/json_parser.lo' is built from `json_parser.tab.c', not
# from a `json_parser.c' that does not exist.  mk said so plainly:
# `no recipe to make 'ext/json/json_parser.6''.
