# `hostcc', because the recipe below RUNS this. `embedder' reads the
# .meson scripts and PRINTS a C header on stdout -- `{ .name = "...",
# .src = (char []){ 1, 2, 3 ... } }' -- so its output is
# architecture-independent text and nothing of the tool itself ends up
# in muon. **A build-time helper, not a bootstrap stage**, and the
# difference is what makes `hostcc' the whole fix rather than a start.
#
# *These notes called it a bootstrap stage and that was wrong*: the
# claim was that the binary being run IS the product, and `embedder'
# lives in muon's `tools/' and is not muon. `./miniperl' and `objc1'
# are the real ones. **Reading `tools/embedder.c' is what settled it**
# -- it was classified from its position in a list, not from what it
# does.
embedder: $MUSRC/tools/embedder.c
	hostcc -I$MUSRC/include -o $target $MUSRC/tools/embedder.c

embedded_files.h: embedder $EMBED_SCRIPT_FILES
	./embedder \
		$MUSRC/src/script/commands/copyfile.meson commands/copyfile.meson \
		$MUSRC/src/script/commands/coverage.meson commands/coverage.meson \
		$MUSRC/src/script/commands/delete_suffix.meson commands/delete_suffix.meson \
		$MUSRC/src/script/commands/i18n/gettext.meson commands/i18n/gettext.meson \
		$MUSRC/src/script/commands/i18n/itstool.meson commands/i18n/itstool.meson \
		$MUSRC/src/script/commands/i18n/msgfmthelper.meson commands/i18n/msgfmthelper.meson \
		$MUSRC/src/script/commands/vcs_tagger.meson commands/vcs_tagger.meson \
		$MUSRC/src/script/html/docs.html html/docs.html \
		$MUSRC/src/script/html/test_out.html html/test_out.html \
		$MUSRC/src/script/lib/cmake_prelude.meson lib/cmake_prelude.meson \
		$MUSRC/src/script/modules/_test.meson modules/_test.meson \
		$MUSRC/src/script/modules/gnome.meson modules/gnome.meson \
		$MUSRC/src/script/modules/i18n.meson modules/i18n.meson \
		$MUSRC/src/script/options/global.meson options/global.meson \
		$MUSRC/src/script/options/per_project.meson options/per_project.meson \
		$MUSRC/src/script/python/python_info.py python/python_info.py \
		$MUSRC/src/script/runtime/dependencies.meson runtime/dependencies.meson >$target

