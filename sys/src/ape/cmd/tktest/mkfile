APEXPROOT=../../../../..
APE=$APEXPROOT/sys/src/ape
<$APE/config

BIN=$APEXPROOT/$objtype/bin/ape
TARG=tktest

TKSRC=$APEXPROOT/sys/src/external/tk
TCLSRC=$APEXPROOT/sys/src/external/tcl

# tktest is wish with Tk's own test commands compiled in -- the exact
# counterpart of tcltest beside tclsh. It is three extra objects and the
# same libraries:
#
#	tkTestInit.$O	unix/tkAppInit.c, built again with -DTK_TEST so
#			that Tk_AppInit calls Tktest_Init and registers
#			the package for "load {} Tktest"
#	tkTest.$O	the test commands themselves
#	tkSquare.$O	the "square" demo widget several of them use
#
# Upstream's Makefile.in builds exactly this list (TKTEST_OBJS); the
# $(@TK_WINDOWINGSYSTEM@_TKTEST_OBJS) it appends is empty for X11 in
# this Tk, so there is no fourth, platform-specific object to find or
# write. Everything tkTest.c reaches on this side already exists:
# TkplatformtestInit is "TCL_OK" for anything but Windows (tkInt.h:1341),
# TkpTestembedCmd is in plan9/tkPlan9Stubs.c, and TkpTesttextCmd is
# generic Tk's, in tkText.c.
#
# WHY IT IS WORTH BUILDING. 448 tests in Tk's suite are SKIPPED for want
# of these commands, which is a third as many again as the 268 that fail:
#
#	testobjconfig	215	testImageType	154	testtext	31
#	testembed	18	testborder	7	testmakeexist	7
#	testbitmap	5	testcursor	5	testfont	5
#	testprintf	1
#
# plus the fourteen unixEmbed "-3.3a"/"-5.1a" variants that report "no
# library with prefix Tktest is loaded statically", imgListFormat-3.*
# and image-6.2. None of those has ever been measured here.
#
# EXPECT THE FAILURE COUNT TO GO UP, and do not read that as a
# regression. A skipped test is not a passing test: these 448 are
# unmeasured, and measuring them for the first time is the whole point.
# The same thing happened when the suite first reached all 97 files --
# 25 failures became 485, and none of it was new breakage.
#
# tktest is a test binary and is deliberately NOT in cmd/mkfile's list:
# it is built by hand when the suite is to be run, like the tests in
# sys/lib/tests. Building it costs a wish-sized link.

# -DWCHAR=char is load-bearing; see the note in ../wish/mkfile for why.
CFLAGS=\
	-FVp -c\
	-I$TKSRC/generic\
	-I$TKSRC/xlib\
	-I$TKSRC/plan9\
	-I$TCLSRC/generic\
	-I$APEXPROOT/sys/include/ape\
	-I$APEXPROOT/$objtype/include/ape\
	-DHAVE_TCL_CONFIG_H\
	-DPLAN9\
	-DMODULE_SCOPE=/***/\
	-DWCHAR=char\
	-DTK_PLATFORM="plan9"\
	-DTK_TEST\

LIB=\
	$APEXPROOT/$objtype/lib/ape/libtk.a\
	$APEXPROOT/$objtype/lib/ape/libtcl.a\
	$APEXPROOT/$objtype/lib/ape/libdraw.a\
	$APEXPROOT/$objtype/lib/ape/libpng.a\
	$APEXPROOT/$objtype/lib/ape/libz.a\
	$APEXPROOT/$objtype/lib/ape/libap.a\

OFILES=tkTestInit.$O tkTest.$O tkSquare.$O

<$APEXPROOT/sys/src/cmd/mkone

# Named tkTestInit rather than tkAppInit because it is the SAME source as
# wish's, built with -DTK_TEST. Upstream renames the object for the same
# reason (Makefile.in:992), so that a stale wish object is never picked
# up here and vice versa.
tkTestInit.$O: $TKSRC/unix/tkAppInit.c
	$CC $CFLAGS -o $target $TKSRC/unix/tkAppInit.c

tkTest.$O: $TKSRC/generic/tkTest.c
	$CC $CFLAGS $TKSRC/generic/tkTest.c

tkSquare.$O: $TKSRC/generic/tkSquare.c
	$CC $CFLAGS $TKSRC/generic/tkSquare.c

clean:V:
	rm -f *.[$OS] $BIN/$TARG
