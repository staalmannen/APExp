APEXPROOT=../../../../..
APE=$APEXPROOT/sys/src/ape
<$APE/config

# Stage 2: the real Objective-C compiler and libraries, built from the
# .m sources with the stage 1 compiler that ../mkfile just installed.
#
# See ../mkfile for why the two stages are run in order rather than
# chosen between. What matters here is that objc(1) -- the driver at
# rc/bin/ape/objc -- hardcodes
#
#	bindir="/bin"
#	objc1=$bindir/objc1
#	libdir="/$objtype/lib/ape"
#
# apexp-sh binds $cputype/bin/ape over /bin, and mount-include binds
# $cputype/lib/ape over /$cputype/lib/ape and sys/include/ape over
# /sys/include/ape -- so all three resolve into this tree, and to the
# stage 1 compiler and runtime that ../mkfile installed a moment ago.
# Stage 2 therefore has to run inside apexp-sh, after stage 1 is
# installed, which is what ../mkfile arranges.

OBJCSRC=../../../external/Objc/src

TARG=objc1\
	postlink\

BIN=$APEXPROOT/$objtype/bin/ape
LIBDIR=$APEXPROOT/$objtype/lib/ape

OBJCRT=$LIBDIR/objcrt.a
OBJPAK=$LIBDIR/objpak.a
OCLIB=$LIBDIR/oclib.a
CALIB=$LIBDIR/cakit.a

PRELINK=$LIBDIR/_prelink.$O
PREDLL=$LIBDIR/_predll.$O

LIB=objcrt.a$O objpak.a$O oclib.a$O cakit.a$O

# What the two programs actually link, and in what order.
#
# Plan 9's linker makes one pass over the archives it is given, pulling
# only the members that resolve symbols undefined at the time it reaches
# them. So an archive has to come *after* everything that references it,
# and the order above -- which is only a build dependency list -- is the
# wrong way round:
#
#	kill: SortCltn: not defined
#	kill: Dictionary: not defined
#	kill: IdArray: not defined
#
# oclib's classdef.m, def.m, funcall.m and four more use those three
# collection classes, and objpak defines them, so objpak had already
# been passed by the time anything wanted them.
#
# This is upstream's OBJC_BOOTLIBS, configure.in:505-507, verbatim in
# order. cakit is deliberately absent: it belongs to UT_BOOTLIBS, the
# utilities, and objc1 does not use it. It is still built and installed
# here, just not linked into the compiler.
LINKLIBS=oclib.a$O objpak.a$O objcrt.a$O

# The four object lists are upstream's own, from each directory's
# Makefile.in OBJFILES, rather than from the .m files present: objpak
# and oclib each have one .m that is not built.
CRT_OBJS=\
	Object.$O\
	Block.$O\
	Message.$O\
	Exceptn.$O\
	OutOfMem.$O\
	objcrt.$O

PAK_OBJS=\
	ascfiler.$O\
	notfound.$O\
	outofbnd.$O\
	unknownt.$O\
	typeinc.$O\
	badvers.$O\
	cltn.$O\
	ordcltn.$O\
	sortcltn.$O\
	set.$O\
	bag.$O\
	stack.$O\
	runarray.$O\
	dictnary.$O\
	sequence.$O\
	array.$O\
	ocstring.$O\
	idarray.$O\
	intarray.$O\
	rectangl.$O\
	point.$O\
	assoc.$O\
	objgraph.$O\
	cltnseq.$O\
	keyseq.$O\
	valueseq.$O\
	setseq.$O\
	bagseq.$O\
	treeseq.$O\
	octext.$O\
	txtstyle.$O\
	paragrph.$O\
	txtattr.$O

OC_OBJS=\
	node.$O\
	stkframe.$O\
	symbol.$O\
	stclass.$O\
	cppdirec.$O\
	type.$O\
	options.$O\
	stmt.$O\
	ifstmt.$O\
	whilstmt.$O\
	switstmt.$O\
	lblstmt.$O\
	rtrnstmt.$O\
	dfltstmt.$O\
	casestmt.$O\
	compstmt.$O\
	exprstmt.$O\
	gotostmt.$O\
	contstmt.$O\
	forstmt.$O\
	dostmt.$O\
	decl.$O\
	pointer.$O\
	arydecl.$O\
	fundecl.$O\
	precdecl.$O\
	bflddecl.$O\
	pfixdecl.$O\
	initdecl.$O\
	keywdecl.$O\
	namedecl.$O\
	stardecl.$O\
	var.$O\
	aryvar.$O\
	scalar.$O\
	expr.$O\
	listxpr.$O\
	keywxpr.$O\
	condxpr.$O\
	castxpr.$O\
	unyxpr.$O\
	deref.$O\
	addrof.$O\
	sizeof.$O\
	typeof.$O\
	pfixxpr.$O\
	indexxpr.$O\
	binxpr.$O\
	dotxpr.$O\
	arrowxpr.$O\
	msgxpr.$O\
	blockxpr.$O\
	selxpr.$O\
	precxpr.$O\
	commaxpr.$O\
	constxpr.$O\
	identxpr.$O\
	assign.$O\
	relxpr.$O\
	funcall.$O\
	btincall.$O\
	def.$O\
	fundef.$O\
	methdef.$O\
	funbody.$O\
	method.$O\
	selector.$O\
	gasmop.$O\
	gasmstmt.$O\
	dasmstmt.$O\
	gattrib.$O\
	gatrdecl.$O\
	compdef.$O\
	datadef.$O\
	globdef.$O\
	structsp.$O\
	classdef.$O\
	enumtor.$O\
	enumsp.$O\
	parmdef.$O\
	parmlist.$O\
	util.$O\
	trlunit.$O

# cakit's objects carry a ca- prefix because cakit/symbol.m and
# oclib/symbol.m would otherwise produce the same object file from two
# different sources. It is the only collision between the four
# directories, but prefixing one whole directory is clearer than
# prefixing one file, and it is what was done for libressl's ssl and
# tls objects.
CA_OBJS=\
	caccltn.$O\
	caccltnsq.$O\
	caccltnsqr.$O\
	caccomplex.$O\
	cacfloat.$O\
	cafraction.$O\
	cainteger.$O\
	caintmodp.$O\
	camatrix.$O\
	camatsq.$O\
	camatsqsq.$O\
	camonomial.$O\
	camonomc.$O\
	cadmonomc.$O\
	cadmonoms.$O\
	casmonomc.$O\
	cacobject.$O\
	capolynom.$O\
	capolyeseq.$O\
	capolyrseq.$O\
	capolycseq.$O\
	capolc.$O\
	casrspolc.$O\
	caosrspolc.$O\
	cadrspolc.$O\
	caodrspolc.$O\
	caodrspols.$O\
	caidrspolc.$O\
	caidrspols.$O\
	camdrspolc.$O\
	camdrspols.$O\
	cadrdpolc.$O\
	caodrdpolc.$O\
	caodrdpols.$O\
	caidrdpolc.$O\
	caidrdpols.$O\
	camdrdpolc.$O\
	camdrdpols.$O\
	casespolc.$O\
	caosespolc.$O\
	cadespolc.$O\
	caodespolc.$O\
	caodespols.$O\
	caidespolc.$O\
	caidespols.$O\
	camdespolc.$O\
	camdespols.$O\
	cacseq.$O\
	cacseqc.$O\
	casymbol.$O\
	caterm.$O\
	cavector.$O\
	cavectorc.$O\
	caovectorc.$O\
	caovectors.$O\
	camvectorc.$O\
	camvectors.$O\
	caivectorc.$O\
	caivectors.$O

# The real objc1 is not the bootstrap one. util/Makefile.in, which is
# the bootstrap build, links _objc1.o with objc1.o; src/objc/Makefile.in
# links yacc, lex and lexfiltr with it, generated from yacc.ym and
# lex.lm. Likewise postlink here is postlink.$O alone, without _plink.
OBJC1OBJS=yacc.$O\
	lex.$O\
	lexfiltr.$O\
	objc1.$O

PLINKOBJS=postlink.$O

<$APEXPROOT/sys/src/cmd/mkmany

# Name every tool by its path in this tree rather than trusting $path.
# bison and flex install into $objtype/bin/ape and the driver lives in
# rc/bin/ape, and neither of those is on $path unless apexp-sh bound
# them over /bin -- a "mk install" from a plain rc gets
#
#	bison: file does not exist: './bison'
#
# and would silently use the host's tools if it had any. Stage 2 is the
# first thing in the tree to run a program out of $objtype/bin/ape at
# build time, which is why YACC=bison in ../../config has never been
# exercised before now.
#
# OBJCBIN, OBJCLIB and OBJCINC are read by the driver (rc/bin/ape/objc)
# and point it at the stage 1 compiler, the stage 1 runtime and this
# tree's headers. Without them it would look for /bin/objc1.
#
# The driver is named with the shell in front of it rather than run
# through its own "#! /bin/sh": /bin/sh is dash, which this tree
# installs into $objtype/bin/ape, so outside apexp-sh there is no
# /bin/sh either and the shebang would fail before the script began.
# The three files the yacc.$O and lex.$O rules rename into place.
# mkmany's clean removes y.tab.? and lex.yy.c, which are what bison and
# flex write, but not what those rules copy them to -- so a failed build
# left yacc.m and yacc.h behind, and the next one compiled them instead
# of regenerating.
CLEANFILES=yacc.m yacc.h lex.m

OBJC=$APEXPROOT/$objtype/bin/ape/sh $APEXPROOT/rc/bin/ape/objc
OBJCBIN=$APEXPROOT/$objtype/bin/ape
OBJCLIB=$APEXPROOT/$objtype/lib/ape
OBJCINC=$APEXPROOT/sys/include/ape
CC=pcc
LD=pcc
YACC=$APEXPROOT/$objtype/bin/ape/bison
LEX=$APEXPROOT/$objtype/bin/ape/flex
CFLAGS=-c -DNDEBUG -D_POSIX_SOURCE

# Include flags, per directory, from upstream's configure.in:498-502.
# They are not interchangeable and not optional:
#
#   -noI  stops the driver adding its own -I/sys/include/ape/objcrt and
#         friends. Those are the *installed* headers -- stage 1's, here
#         -- and the runtime has to be compiled against the headers
#         beside its own sources, or it is built to one ABI and linked
#         against another. configure.in calls this NOI and passes it to
#         every one of the five.
#
#   Each directory then gets the include/ trees it depends on, its own
#   source directory (its private headers live beside its .m files:
#   src/oclib has 85 headers where include/oclib has the 78 public
#   ones), and -I. for anything generated into the build directory.
#
# yacc.ym is what found this. It includes "options.h", "node.h",
# "util.h" and "stmt.h", all of them oclib's private headers, so
# compiling src/objc without -I$OBJCSRC/src/oclib gives
#
#	cpp: yacc.ym:36 Could not find include file "options.h"
OBJCINCDIR=$OBJCSRC/include
CRTINC=-I$OBJCINCDIR/objcrt
PAKINC=-I$OBJCINCDIR/objpak

CRTFLAGS=-noI $CRTINC -I$OBJCSRC/src/objcrt -I.
PAKFLAGS=-noI $CRTINC $PAKINC -I$OBJCSRC/src/objpak -I.
OCFLAGS=-noI $CRTINC $PAKINC -I$OBJCSRC/src/oclib -I.
CAFLAGS=-noI $CRTINC -I$OBJCSRC/src/cakit -I.
OBJCFLAGS=-noI $CRTINC $PAKINC -I$OBJCSRC/src/oclib -I$OBJCSRC/src/objc -I.

MFLAGS=-c -DNDEBUG

# objc -c compiles straight to an object; there is no separate .c step.
# The driver's .m path writes a copy of the source as $base.c for cpp to
# read, then feeds cpp's output to objc1 and objc1's output to cc, and
# removes both temporaries. So a rule that ran "objc $prereq" and
# expected a .c to be left behind would find nothing -- and would also
# have compiled and linked the file, since the driver links unless told
# -c.
%.$O: $OBJCSRC/src/objcrt/%.m
	$OBJC $MFLAGS $CRTFLAGS $prereq -o $target

%.$O: $OBJCSRC/src/objpak/%.m
	$OBJC $MFLAGS $PAKFLAGS $prereq -o $target

%.$O: $OBJCSRC/src/oclib/%.m
	$OBJC $MFLAGS $OCFLAGS $prereq -o $target

ca%.$O: $OBJCSRC/src/cakit/%.m
	$OBJC $MFLAGS $CAFLAGS $prereq -o $target

%.$O: $OBJCSRC/src/objc/%.m
	$OBJC $MFLAGS $OBJCFLAGS $prereq -o $target

# yacc.ym and lex.lm are Objective-C with grammar and scanner rules
# around it: run bison or flex, rename the C it produces to .m, and
# hand that to objc. Upstream's .ym and .lm rules do the same.
#
# bison needs -y: without it the output is named after the input, so
# yacc.ym would give yacc.tab.c, while upstream's YTABC is y.tab.c.
yacc.$O: $OBJCSRC/src/objc/yacc.ym
	$YACC -y -d $prereq
	cp y.tab.c yacc.m
	cp y.tab.h yacc.h
	$OBJC $MFLAGS $OBJCFLAGS yacc.m -o $target
	rm -f y.tab.c y.tab.h yacc.m

lex.$O: $OBJCSRC/src/objc/lex.lm yacc.$O
	$LEX $OBJCSRC/src/objc/lex.lm
	cp lex.yy.c lex.m
	$OBJC $MFLAGS $OBJCFLAGS lex.m -o $target
	rm -f lex.yy.c lex.m

objcrt.a$O: $CRT_OBJS
	ar vu $target $prereq
	cp $target $OBJCRT

objpak.a$O: $PAK_OBJS
	ar vu $target $prereq
	cp $target $OBJPAK

oclib.a$O: $OC_OBJS
	ar vu $target $prereq
	cp $target $OCLIB

cakit.a$O: $CA_OBJS
	ar vu $target $prereq
	cp $target $CALIB

$O.objc1: $OBJC1OBJS $LIB
	$LD $OBJC1OBJS $LINKLIBS -o $target

$O.postlink: $PLINKOBJS $LIB
	$LD $PLINKOBJS $LINKLIBS -o $target

# _prelink.c and _predll.c are plain C, not Objective-C: they are the
# tables postlink writes into, and the driver looks for _prelink.o in
# libdir when it is asked for -postlink.
$PRELINK: $OBJCSRC/src/objc/_prelink.c
	$CC $CFLAGS $CRTINC -I$OBJCSRC/src/objc $prereq
	cp _prelink.$O $PRELINK

$PREDLL: $OBJCSRC/src/objc/_predll.c
	$CC $CFLAGS $CRTINC -I$OBJCSRC/src/objc $prereq
	cp _predll.$O $PREDLL

install:V: $PRELINK $PREDLL
installall:V: $PRELINK $PREDLL
