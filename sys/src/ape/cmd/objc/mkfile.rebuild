APEXPROOT=../../../../..
APE=$APEXPROOT/sys/src/ape
<$APE/config

OBJCSRC=../../../external/Objc/src

TARG=objc1\
	postlink\

BIN=$APEXPROOT/$objtype/bin/ape
LIBDIR=$APEXPROOT/$objtype/lib/ape

PRELINK=$LIBDIR/_prelink.$O

OBJCRT=$LIBDIR/objcrt.a
OBJPAK=$LIBDIR/objpak.a
OCLIB=$LIBDIR/oclib.a
OCLIB=$LIBDIR/cakit.a

LIB=objcrt.a$O objpak.a$O oclib.a$O cakit.a$O

CRT_OBJS=\
