OBJC1OBJS=_objc1.$O\
	objc1.$O

PLINKOBJS=_plink.$O\
	postlink.$O

<$APEXPROOT/sys/src/cmd/mkmany

OBJC=objc
CC=pcc
LD=pcc
CFLAGS= -c -DNDEBUG -D_POSIX_SOURCE -I$OBJCSRC

%.c: $OBJCSRC/src/objc/%.m
	$OBJC $prereq

%.c: $OBJCSRC/src/oclib/%.m
	$OBJC $prereq

%.c: $OBJCSRC/src/objpak/%.m
	$OBJC $prereq

%.c: $OBJCSRC/src/objcrt/%.m
	$OBJC $prereq

%.c: $OBJCSRC/src/cakit/%.m
	$OBJC $prereq

%.$O: %.c
    $CC $CFLAGS $stem.c

objcrt.a$O: $CRT_OBJS
	ar vu $target $prereq
	cp $target $OBJCRT

objpak.a$O: $PAK_OBJS
	ar vu $target $prereq
	cp $target $OBJPAK

oclib.a$O: $OC_OBJS
	ar vu $target $prereq
	cp $target $OCLIB

cakit.a$O: $CA_OBJS
	ar vu $target $prereq
	cp $target $CALIB


$O.$Objc1: $OBJC1OBJS $LIB
	$LD $prereq -o $target

$O.postlink: $PLINKOBJS $LIB
	$LD $prereq -o $target

$PRELINK: $OBJCSRC/_prelink.c
    $CC $CFLAGS _prelink.c
	cp _prelink.$O $PRELINK
	rm _prelink.c

install installall: $PRELINK



