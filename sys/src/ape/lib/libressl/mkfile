# ssl/ and tls/ objects carry a prefix, and crypto/ objects do not.
#
# Not cosmetic: mk resolves a target against every pattern rule whose
# directory could produce it, not just the rule for the file actually
# listed, so two rules that could both make bs_ber.$O are an error even
# though only one bs_ber.c is in OFILES:
#
#   mk: ambiguous recipes for bs_ber.6:
#       bs_ber.6 <-(mkfile:632)- .../libressl/crypto/bytestring/bs_ber.c
#       bs_ber.6 <-(mkfile:727)- .../libressl/ssl/bs_ber.c
#
# Four basenames are reachable from more than one rule: bs_ber.c,
# bs_cbb.c and bs_cbs.c from crypto/bytestring and ssl, and empty.c from
# all three trees. Every one of them crosses a tree boundary; none of
# crypto's 54 subdirectories collides with another. So prefixing ssl and
# tls is enough, and leaves the 418 crypto objects plain.
#
# To re-check after an import: for each rule directory, list its *.c and
# look for a basename appearing in two of them.
ssl-%.$O: $SSLSRC/ssl/%.c
	$CC $SSLFLAGS -o ssl-$stem.$O $SSLSRC/ssl/$stem.c

tls-%.$O: $SSLSRC/tls/%.c
	$CC $TLSFLAGS -o tls-$stem.$O $SSLSRC/tls/$stem.c
