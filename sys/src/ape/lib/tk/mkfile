	$DRAWIMPL_OBJ\
	$GENERIC_OBJS\
	$TTK_OBJS\
	$UNIX_OBJS\
	$XLIB_OBJS\

CC=pcc

# Flags for generic/ and plan9/ files (APE headers + Tk includes)
# -DWCHAR=char is load-bearing, not a workaround: do not remove it.
# Tcl defines WCHAR only for Windows and Cygwin -- tclUnixPort.h's
# "typedef unsigned short WCHAR" sits inside #ifdef __CYGWIN__ -- yet
# tclClock.c uses WCHAR unguarded, so without this the file does not
# compile at all. char is also what Tcl itself picks elsewhere on
# non-Windows: see "#define WCHAR char" in generic/tclIOUtil.c. And it
# has to be char rather than wchar_t, because tclClock.c assigns
# getenv's char * straight to a const WCHAR *.
#
# The matching wcscmp/wcslen/wcscpy redirection lives in tclClock.c
# itself, under #ifdef PLAN9. It cannot be done with -D here: that would
# rewrite the declarations in wchar.h as well as the calls, leaving
# "extern int strcmp(const wchar_t *, const wchar_t *)" to collide with
# the real one in string.h.
CFLAGS=\
	-c\
	-I.\
	-I$TKSRC/generic\
	-I$TKSRC/generic/ttk\
	-I$TKSRC/xlib\
	-I$TKSRC/bitmaps\
	-I$TKSRC/plan9\
	-I$TCLSRC/generic\
	-I$TCLSRC/plan9\
	-I$APEXPROOT/sys/include/ape\
	-I$APEXPROOT/$objtype/include/ape\
	-DHAVE_TCL_CONFIG_H\
	-DHAVE_TK_CONFIG_H\
	-DPLAN9\
	-DMODULE_SCOPE=extern\
	-DWCHAR=char\
	-DTK_PLATFORM="plan9"\
	-DSTATIC_BUILD\

CC=pcc

# DrawImpl uses APE's Plan 9 extension headers (draw.h, mouse.h, u.h)
# It must NOT include Xlib.h; add -DPLAN9_SOURCE to enable draw.h.
DRAWIMPL_CFLAGS=\
	-c\
	-I$TKSRC/plan9\
	-I$APEXPROOT/sys/include/ape\
	-I$APEXPROOT/$objtype/include/ape\
	-D_PLAN9_SOURCE\

# mklib makes every object depend on HFILES, so a header that is NOT
# listed here changes nothing: mk rebuilds only the .c files that
# themselves changed, and everything else keeps the layout it was
# compiled against.
#
# THIS COST A WHOLE RUN. Two int fields were added to P9DisplayState in
# tkPlan9Int.h -- the struct behind the single global gP9 that all seven
# files in plan9/ share -- and only tkPlan9Init.c was rebuilt, because
# only its .c had changed. The other six went on reading evqueue,
# focuswin and lastmouse at the old offsets of the same object. Key
# events stopped arriving (bind.test 3 failures -> 116) and the suite
# died in cmds.test, none of which mentions a header.
#
# So the port's own headers belong here. They are the ones that change;
# the vendored generic/ and xlib/ headers do not, and listing several
# hundred of them would make every build walk the tree.
HFILES=\
	tkConfig.h\
	$TKSRC/plan9/tkPlan9Int.h\
	$TKSRC/plan9/tkPlan9Port.h\
	$TKSRC/plan9/tkPlan9Default.h\
	$TKSRC/plan9/tkP9Draw.h\

<$APEXPROOT/sys/src/cmd/mklib

$DRAWIMPL_OBJ: $TKSRC/plan9/tkPlan9DrawImpl.c
	$CC $DRAWIMPL_CFLAGS $TKSRC/plan9/tkPlan9DrawImpl.c

%.$O: $TKSRC/plan9/%.c
	$CC $CFLAGS $TKSRC/plan9/$stem.c

%.$O: $TKSRC/xlib/%.c
	$CC $CFLAGS $TKSRC/xlib/$stem.c

tkImgPhInstance.$O: $TKSRC/generic/tkImgPhInstance.c
	$CC $CFLAGS -N $TKSRC/generic/tkImgPhInstance.c

%.$O: $TKSRC/generic/%.c
	$CC $CFLAGS $TKSRC/generic/$stem.c

%.$O: $TKSRC/generic/ttk/%.c
	$CC $CFLAGS $TKSRC/generic/ttk/$stem.c

%.$O: $TKSRC/unix/%.c
	$CC $CFLAGS $TKSRC/unix/$stem.c

clean:V:
	rm -f $LIB
	rm -f *.$O
