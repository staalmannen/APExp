APEXPROOT=../../../../../../..
X11=$APEXPROOT/sys/src/external/equis_X11
<$X11/config
BIN=$X11BIN
TARG=sxpm
OFILES=sxpm.$O
</sys/src/cmd/mkone
CFLAGS=-c $X11CFLAGS -B

# mkone's own %.$O rule reads %.c from THIS directory, and the source is
# in the import, so the source directory is named here.
%.$O: $X11/lib/Xpm/sxpm/%.c
	pcc $CFLAGS -o $stem.$O $prereq
