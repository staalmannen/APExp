#DIRS=FS Xau Xdmcp Xext Xfont Xi fontenc pixman
# XTrap is left out: its sources need <X11/extensions/xtraplib.h> and
# xtraplibp.h, which are in no imported tree and in no Debian or Ubuntu
# package currently published, and nothing built here links libXTrap.
DIRS=`{ls -l | sed '/^d/!d; s/.* //; /\./d; /^XTrap$/d'}

APEXPROOT=../../../../..

default:V:	all

all clean nuke install installall:V:
	for (i in $DIRS) @{
		cd $i
		mk $target
	}
