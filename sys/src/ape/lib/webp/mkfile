WEBPSOURCE=../../../external/libwebp

# ONE `-I', and it is the libwebp ROOT rather than `src': every source
# here spells its own includes from the root (`#include
# "src/dsp/dsp.h"'), and so does sharpyuv (`"src/webp/types.h"').
CFLAGS=-c -I$WEBPSOURCE -D_POSIX_SOURCE

%.$O: $WEBPSOURCE/src/dec/%.c
	$CC $CFLAGS $WEBPSOURCE/src/dec/$stem.c

%.$O: $WEBPSOURCE/src/demux/%.c
	$CC $CFLAGS $WEBPSOURCE/src/demux/$stem.c

%.$O: $WEBPSOURCE/src/dsp/%.c
	$CC $CFLAGS $WEBPSOURCE/src/dsp/$stem.c

%.$O: $WEBPSOURCE/src/enc/%.c
	$CC $CFLAGS $WEBPSOURCE/src/enc/$stem.c

%.$O: $WEBPSOURCE/src/mux/%.c
	$CC $CFLAGS $WEBPSOURCE/src/mux/$stem.c

%.$O: $WEBPSOURCE/src/utils/%.c
	$CC $CFLAGS $WEBPSOURCE/src/utils/$stem.c

%.$O: $WEBPSOURCE/sharpyuv/%.c
	$CC $CFLAGS $WEBPSOURCE/sharpyuv/$stem.c
