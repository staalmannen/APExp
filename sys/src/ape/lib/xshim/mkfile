APEXPROOT=../../../../../
APE=$APEXPROOT/sys/src/ape
<$APE/config

LIB=$APEXPROOT/$objtype/lib/ape/libxshim.a

OFILES=\
	display.$O\
	window.$O\
	xs_gc.$O\
	xs_win.$O\
	xs_xdisplay.$O\
	xs_clip.$O\
	draw.$O\
	event.$O\
	xs_atom.$O\
	xs_region.$O\
	xs_arc.$O\
	xs_font.$O\

# the public API is the standard X11 headers in sys/include/ape/X11; the shared
# types the library uses are xshim_types.h
HFILES=\
	$APEXPROOT/sys/include/ape/xshim_types.h\
	$APEXPROOT/sys/include/ape/X11/Xlib.h\

UPDATE=\
	mkfile\
	$HFILES\
	${OFILES:%.$O=%.c}\
	xshim_p.h\
	${LIB:/$objtype/%=/386/%}\

<$APEXPROOT/sys/src/cmd/mksyslib

CFLAGS=-c $CFLAGS -D_POSIX_SOURCE -D_PLAN9_SOURCE -I../ap/include

# every object includes the private header, so it is a prerequisite;
# the recipe is mksyslib's own %.$O rule, not a second one
$OFILES: xshim_p.h
