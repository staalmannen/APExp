# -I. first: config.h, zipconf.h and the generated zip_err_str.c live
# here, and lib/zipint.h includes "config.h" expecting the build
# directory's copy rather than anything upstream ships.
CFLAGS=-c -I. -I$ZIPSRC/lib\
	-I$APEXPROOT/sys/src/external/libressl/include

%.$O: $ZIPSRC/lib/%.c
	$CC $CFLAGS $ZIPSRC/lib/$stem.c

zip_err_str.$O: zip_err_str.c
	$CC $CFLAGS zip_err_str.c

# zip.h and zipconf.h are the public interface and are committed under
# sys/include/ape rather than copied here at install time, because each
# carries a #pragma lib that upstream's does not -- the same arrangement
# as the libressl and curl headers. A program that includes <zip.h> then
# links libzip.a without saying so, and libz.a, libbz2.a, liblzma.a,
# libzstd.a and libressl.a with it, since the compression and crypto
# backends above are compiled in and every caller needs them.
#
# If libzip is ever updated, sys/include/ape/zip.h has to be refreshed
# from lib/zip.h and the pragmas put back.
