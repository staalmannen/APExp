APEXPROOT=../../../../..
APE=$APEXPROOT/sys/src/ape
<$APE/config

LIB=$APEXPROOT/$objtype/lib/ape/libperl.a
PERLSRC=../../../external/perl

OFILES=\
	av.$O builtin.$O caretx.$O class.$O \
	deb.$O doio.$O doop.$O dquote.$O \
	dump.$O globals.$O gv.$O hv.$O \
	keywords.$O locale.$O mathoms.$O mg.$O \
	mro_core.$O numeric.$O pad.$O peep.$O \
	perlio.$O perly.$O pp.$O pp_ctl.$O \
	pp_hot.$O pp_pack.$O pp_sort.$O pp_sys.$O \
	reentr.$O regcomp.$O regcomp_debug.$O \
	regcomp_invlist.$O regcomp_study.$O regcomp_trie.$O \
	regexec.$O run.$O scope.$O sv.$O \
	taint.$O time64.$O toke.$O utf8.$O \
	util.$O

# config.h here is HAND-MAINTAINED, and mk does not scan #includes --
# so WITHOUT this line, editing it rebuilds NOTHING and the next run
# measures the old binary. That is how HELP_BUILTIN was turned on and
# did not reach bash; see CLAUDE.md.
HFILES=../../../external/perl/config.h

<$APEXPROOT/sys/src/cmd/mksyslib

CFLAGS=-c -I$PERLSRC -D_POSIX_SOURCE -DHAVE_CONFIG_H -D_PLAN9_SOURCE -D_BSD_EXTENSION -DPERL_CORE

%.$O: $PERLSRC/%.c
	$CC $CFLAGS $prereq -o $target





