# As for libressl: copies of $CRLSRC/include/curl with a "#pragma lib"
# added inside the include guard.
#
# curl's headers name TWO libraries, libcurl first and libressl second,
# and the order is the link order -- 6l's loadlib() walks the list in
# order, appending as it goes. libcurl.a's own members cannot carry the
# libressl pragma, because libcurl is compiled against $SSLSRC/include
# rather than the installed copy, so a program that includes
# <curl/curl.h> would otherwise link libcurl and never reach libressl.
HFILES=\
	/sys/include/ape/curl/curl.h\
	/sys/include/ape/curl/curlver.h\
	/sys/include/ape/curl/easy.h\
	/sys/include/ape/curl/header.h\
	/sys/include/ape/curl/mprintf.h\
	/sys/include/ape/curl/multi.h\
	/sys/include/ape/curl/options.h\
	/sys/include/ape/curl/stdcheaders.h\
	/sys/include/ape/curl/system.h\
	/sys/include/ape/curl/typecheck-gcc.h\
	/sys/include/ape/curl/urlapi.h\
	/sys/include/ape/curl/websockets.h\

<$APEXPROOT/sys/src/cmd/mksyslib

CRLSRC=$APEXPROOT/sys/src/external/curl
SSLSRC=$APEXPROOT/sys/src/external/libressl

# -I. first, for curl_config.h. BUILDING_LIBCURL and CURL_STATICLIB are
# what the Makefile.am passes; without the second, the headers declare
# the entry points dllimport on the platforms that care and curl_setup.h
# takes a shared-library path this tree has no use for.
CFLAGS=-c -I. -I$CRLSRC/include -I$CRLSRC/lib -I$SSLSRC/include\
	-DHAVE_CONFIG_H -DBUILDING_LIBCURL -DCURL_STATICLIB

%.$O: $CRLSRC/lib/%.c
	$CC $CFLAGS $CRLSRC/lib/$stem.c
%.$O: $CRLSRC/lib/curlx/%.c
	$CC $CFLAGS $CRLSRC/lib/curlx/$stem.c
%.$O: $CRLSRC/lib/vauth/%.c
	$CC $CFLAGS $CRLSRC/lib/vauth/$stem.c
%.$O: $CRLSRC/lib/vquic/%.c
	$CC $CFLAGS $CRLSRC/lib/vquic/$stem.c
%.$O: $CRLSRC/lib/vssh/%.c
	$CC $CFLAGS $CRLSRC/lib/vssh/$stem.c
%.$O: $CRLSRC/lib/vtls/%.c
	$CC $CFLAGS $CRLSRC/lib/vtls/$stem.c
