APEXPROOT=../../../../../..
APE=$APEXPROOT/sys/src/ape
<$APE/config
LIB=$APEXPROOT/$objtype/lib/ape/libap.a

# split malloc into malloc, free and realloc

# mksyslib makes every object depend on $HFILES AND NOTHING ELSE -- mk
# does not scan #includes -- so a header left out of this list is a
# header that changes nothing. malloc_impl.h carries the block layout
# shared by malloc.c, free.c and realloc.c, which is precisely the kind
# of edit that must not reach only one of them.
HFILES=\
	malloc_impl.h\
	malloc_align.h\

OFILES=\
	calloc.$O\
	malloc.$O\
	free.$O\
	realloc.$O\
	setmalloctag.$O\
	setrealloctag.$O\
# claude ported from musl / APE malloc internals\
	posix_memalign.$O\
	reallocarray.$O\
	memalign.$O\
	aligned_alloc.$O\
# GNU xalloc family\
	xmalloc.$O\
# xalloc_die is replaceable, so it gets an object of its own\
	xalloc_die.$O\
	exitfail.$O\

<$APEXPROOT/sys/src/cmd/mksyslib

CFLAGS=$CFLAGS -c -D_POSIX_SOURCE -D_PLAN9_SOURCE -I../include
