APEXPROOT=../../../../../
APE=$APEXPROOT/sys/src/ape
<$APE/config

DIRS=\
	aio\
	complex\
	conf\
	ctype\
	dirent\
	env\
	errno\
	exit\
	fcntl\
	fenv\
	fmt\
	legacy\
	locale\
	malloc\
	math\
	misc\
	mp\
	multibyte\
	network\
	passwd\
	plan9\
	prng\
	process\
	regex\
	search\
	sched\
	select\
	signal\
	stat\
	stdio\
	stdlib\
	string\
	syscall\
	temp\
	termcap\
	termios\
	thread\
	time\
	unistd\

default:V:	all

install all:V:
	for(i in $DIRS)@{
		echo $i
		cd $i
		mk $MKFLAGS $target
	}
	for(j in $objtype)@{
		echo arch/$j
		cd arch/$j
		mk $MKFLAGS $target
	}


installall:V:
	for(objtype in $CPUS)@{
		# NOT `mk objtype=$objtype install'.  `=' is a syntax
		# character in rc, so that spelling is a parse error
		# (`token '=': syntax error') -- MEASURED on the VM, where
		# clisp's `test $name = lispbibl' answered exactly that.
		# This line sits in `installall:V:', which a normal
		# `mk install' never reaches, so it has never been run and
		# nothing has ever reported it.
		mk 'objtype='^$objtype install
	}


clean nuke:V:
	for(i in $DIRS)@{
		echo $i
		cd $i
		mk $MKFLAGS $target
	}
	for(j in $objtype)@{
		echo arch/$j
		cd arch/$j
		mk $MKFLAGS $target
	}
