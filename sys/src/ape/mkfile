none:VQ:
	echo usage: mk all, install, installall, cmd, cmd.install, lib, lib.install, lib2, lib2.install

all clean nuke install installall:V:
	chmod +x mount-include
	./mount-include
	mk lib.$target
	mk 9src.$target
	mk cmd.$target
	mk lib2.$target

lib.%:V:
	cd lib
	mk $stem

lib2.%:V:
	cd lib2
	mk $stem

lib.clean:V:
	cd lib
	rm -f .mk.$objtype
	mk clean

lib.nuke:V:
	cd lib
	rm -f .mk.$objtype
	mk nuke

cmd.%:V:
	cd cmd
	mk $stem

9src.%:V:
	cd 9src
	mk $stem

test:VQ:
	# nothing
