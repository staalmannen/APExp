# full freetype checkout - useful for bisecting:
#
{
	v=VER-2-13-3
	mk freetype-$v
	bind -c freetype-$v freetype-$v
	bind -a port freetype-$v
	bind -a port/builds freetype-$v/builds
	mk 'LIBDIR=freetype-'$v nuke
	mk 'LIBDIR=freetype-'$v
}

