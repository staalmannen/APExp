</$objtype/mkfile
APEXPROOT=../../../..

TARG=fontsrv
OFILES=\
	fontsrv.$O \
	freetype.$O \
	fc.$O\
	pjw.$O\

BIN=$APEXPROOT/$objtype/bin
LIBDIR=libfreetype
LIB=$LIBDIR/libfreetype.a$O
LIBHFILES=$APEXPROOT/sys/src/external/libfreetype/builds/plan9/p9ftopt.h
HFILES=dat.h $LIBHFILES
CLEANFILES=pax_global_header

CFLAGS=$CFLAGS -p -I$LIBDIR/builds/plan9 -I$LIBDIR/include \
	-D'FT_CONFIG_OPTIONS_H=<p9ftopt.h>' \
	-D'FT_CONFIG_STANDARD_LIBRARY_H=<p9lib.h>' \

</sys/src/cmd/mkone

$LIB $LIBHFILES: $LIBDIR
	cd $LIBDIR; mk install

install:V:	$BIN/$TARG $APEXPROOT/sys/lib/fontsrv.map $APEXPROOT/sys/man/4/fontsrv
$APEXPROOT/sys/lib/fontsrv.map:
	cp lib/fontsrv $APEXPROOT/sys/lib/fontsrv.map
$APEXPROOT/sys/man/4/fontsrv: man/4/fontsrv
	cp man/4/fontsrv $APEXPROOT/sys/man/4/fontsrv

clean nuke:V:
	@{ cd $LIBDIR; mk $target }
	rm -f *.[$OS] [$OS].out $TARG $CLEANFILES

release:V:
	mk nuke
	rm -rf freetype-*


