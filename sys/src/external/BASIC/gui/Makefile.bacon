bacongui-tk: bacongui-tk.bac.o
	cc -o bacongui-tk bacongui-tk.bac.o   `pkg-config --libs tk tcl`  -lm
bacongui-tk.bac.o: bacongui-tk.bac.c
	cc  `pkg-config --cflags tk tcl` -c bacongui-tk.bac.c

.PHONY: clean
clean:
	rm -f *.o *.c bacongui-tk bacongui-tk.*.* Makefile.bacon
