#------------------------------------------------------------- -*- makefile -*-
#
# Makefile for TkTable Extension
#
# Basic build, test and install
#   nmake /f makefile.vc INSTALLDIR=c:\path\to\tcl TCLDIR=c:\path\to\tcl\sources
#   nmake /f makefile.vc INSTALLDIR=c:\path\to\tcl TCLDIR=c:\path\to\tcl\sources test
#   nmake /f makefile.vc INSTALLDIR=c:\path\to\tcl TCLDIR=c:\path\to\tcl\sources install
#
# For other build options (debug, static etc.),
# See TIP 477 (https://core.tcl-lang.org/tips/doc/main/tip/477.md) for
# detailed documentation.
#
# See the file "license.terms" for information on usage and redistribution
# of this file, and for a DISCLAIMER OF ALL WARRANTIES.
#
#------------------------------------------------------------------------------

#-------------------------------------------------------------------------
# Project specific information
#-------------------------------------------------------------------------

# The name of the package
PROJECT = tkcon

!include "rules-ext.vc"


# Define the object files and resource file that make up the extension.
# Note the resource file does not makes sense if doing a static library build
# hence it is under that condition. TMP_DIR is the output directory
# defined by rules for object files.
PRJ_OBJS = 

# Define any additional project include flags
PRJ_INCLUDES =

# Define any additional compiler flags that might be required for the project
PRJ_DEFINES = 

# Define any additional project needed libraries
PRJ_LIBS = 

# Define the standard targets which calls rules.vc
#!include "targets.vc"

.SUFFIXES: .c .obj .res .man

#---------------------------------------------------------------------
# Project specific targets
#---------------------------------------------------------------------

# Implicit rule to generate html from man files
# NOTE: this requires doctools from tcllib hence it is not intended
# to be run during install. Rather, use it to generate a new version
# of HTML docs to be stored in the repository.
DTPLITE = "$(_INSTALLDIR)\..\bin\dtplite.tcl"

make-docs-html:
!IF EXIST($(DTPLITE))
	"$(TCLSH_NATIVE)" "$(DTPLITE)" -o "$(DOCDIR)\dump.html" html "$(DOCDIR)\dump.n.man"
	"$(TCLSH_NATIVE)" "$(DTPLITE)" -o "$(DOCDIR)\idebug.html" html "$(DOCDIR)\idebug.n.man"
	"$(TCLSH_NATIVE)" "$(DTPLITE)" -o "$(DOCDIR)\observe.html" html "$(DOCDIR)\observe.n.man"
	"$(TCLSH_NATIVE)" "$(DTPLITE)" -o "$(DOCDIR)\tkcon.html" html "$(DOCDIR)\tkcon.n.man"
	"$(TCLSH_NATIVE)" "$(DTPLITE)" -o "$(DOCDIR)\tkcon.1.html" html "$(DOCDIR)\tkcon.1.man"
	"$(TCLSH_NATIVE)" "$(DTPLITE)" -o "$(DOCDIR)\tkconrc.html" html "$(DOCDIR)\tkconrc.5.man"
!ENDIF

make-docs-n:
!IF EXIST($(DTPLITE))
	"$(TCLSH_NATIVE)" "$(DTPLITE)" -o "$(DOCDIR)\dump.n" nroff "$(DOCDIR)\dump.n.man"
	"$(TCLSH_NATIVE)" "$(DTPLITE)" -o "$(DOCDIR)\idebug.n" nroff "$(DOCDIR)\idebug.n.man"
	"$(TCLSH_NATIVE)" "$(DTPLITE)" -o "$(DOCDIR)\observe.n" nroff "$(DOCDIR)\observe.n.man"
	"$(TCLSH_NATIVE)" "$(DTPLITE)" -o "$(DOCDIR)\tkcon.n" nroff "$(DOCDIR)\tkcon.n.man"
	"$(TCLSH_NATIVE)" "$(DTPLITE)" -o "$(DOCDIR)\tkcon.1" nroff "$(DOCDIR)\tkcon.1.man"
	"$(TCLSH_NATIVE)" "$(DTPLITE)" -o "$(DOCDIR)\tkconrc.5" nroff "$(DOCDIR)\tkconrc.5.man"
!ENDIF

make-docs:
!IF EXIST($(DTPLITE))
	"$(TCLSH_NATIVE)" "$(DTPLITE)" -o "$DOCDIR" html "$(ROOT)\doc"
	"$(TCLSH_NATIVE)" "$(DTPLITE)" -o "$DOCDIR" nroff "$(ROOT)\doc"
!ENDIF

docs: make-docs-n make-docs-html

# Build targets

$(PROJECT): setup pkgindex

all: default-setup default-pkgindex-tea

setup: default-setup

pkgindex: default-pkgindex-tea


# Install targets

install-scripts:
	echo Installing libraries to '$(SCRIPT_INSTALL_DIR)'
	if not exist "$(SCRIPT_INSTALL_DIR)" mkdir "$(SCRIPT_INSTALL_DIR)"
	$(CPY) $(ROOT)\*.tcl "$(SCRIPT_INSTALL_DIR)"
	echo Installing package index in '$(SCRIPT_INSTALL_DIR)'
	$(CPY) $(OUT_DIR)\pkgIndex.tcl $(SCRIPT_INSTALL_DIR)
	echo Installing binaries to '$(BIN_INSTALL_DIR)\..\..\bin'
	if not exist "$(BIN_INSTALL_DIR)\..\..\bin" mkdir "$(BIN_INSTALL_DIR)\..\..\bin"
	$(CPY) $(ROOT)\*.tcl "$(BIN_INSTALL_DIR)\..\..\bin"


install-docs-html:
	echo Installing documentation files to '$(DOC_INSTALL_DIR)\doc'
	if not exist "$(DOC_INSTALL_DIR)\doc" mkdir "$(DOC_INSTALL_DIR)\doc"
	if exist $(DOCDIR) for %f in ("$(DOCDIR)\*.html" "$(DOCDIR)\*.*.html" "$(DOCDIR)\*.css" "$(DOCDIR)\*.png" "$(DOCDIR)\license.terms") do @$(COPY) %f "$(DOC_INSTALL_DIR)\doc"

install: setup pkgindex install-scripts install-docs-html


# Clean up targets

clean: default-clean

realclean: default-hose
