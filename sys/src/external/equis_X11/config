# APEXPROOT is NOT set here. mk evaluates a relative value against the
# directory the mkfile runs in, and the mkfiles that include this file
# sit at different depths below the root, so a value assigned here
# overrode each mkfile's own and pointed every -I path at the wrong tree.
# Each mkfile sets APEXPROOT for its own depth before including this.
APE=$APEXPROOT/sys/src/ape
<$APE/config
X11BIN=$APEXPROOT/$objtype/bin/ape/X11
X11LIB=$APEXPROOT/$objtype/lib/ape/X11
X11CFLAGS=-B -D_POSIX_SOURCE -D_BSD_EXTENSION -D_REENTRANT_SOURCE -DHAVE_SOCK_OPTS -D_C99_SNPRINTF_EXTENSION -DPLAN9 -DT$objtype -DHAVE_CONFIG_H -I$APEXPROOT/sys/src/external/equis_X11
