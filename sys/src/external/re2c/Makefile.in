maintainer-clean-am: distclean-am maintainer-clean-generic

mostlyclean: mostlyclean-recursive

mostlyclean-am: mostlyclean-compile mostlyclean-generic \
	mostlyclean-libtool

pdf: pdf-recursive

pdf-am:

ps: ps-recursive

ps-am:

uninstall-am: uninstall-binPROGRAMS uninstall-dist_stdlibDATA \
	uninstall-libLTLIBRARIES uninstall-man

uninstall-man: uninstall-man1

.MAKE: $(am__recursive_targets) all check check-am install install-am \
	install-exec install-strip

.PHONY: $(am__recursive_targets) CTAGS GTAGS TAGS all all-am all-local \
	am--depfiles am--refresh check check-TESTS check-am clean \
	clean-binPROGRAMS clean-checkPROGRAMS clean-cscope \
	clean-generic clean-libLTLIBRARIES clean-libtool \
	clean-noinstPROGRAMS cscope cscopelist-am ctags ctags-am dist \
	dist-all dist-bzip2 dist-bzip3 dist-gzip dist-lzip dist-shar \
	dist-tarZ dist-xz dist-zip dist-zstd distcheck distclean \
	distclean-compile distclean-generic distclean-hdr \
	distclean-libtool distclean-tags distcleancheck distdir \
	distuninstallcheck dvi dvi-am html html-am info info-am \
	install install-am install-binPROGRAMS install-data \
	install-data-am install-dist_stdlibDATA install-dvi \
	install-dvi-am install-exec install-exec-am install-html \
	install-html-am install-info install-info-am \
	install-libLTLIBRARIES install-man install-man1 install-pdf \
	install-pdf-am install-ps install-ps-am install-strip \
	installcheck installcheck-am installdirs installdirs-am \
	maintainer-clean maintainer-clean-generic mostlyclean \
	mostlyclean-compile mostlyclean-generic mostlyclean-libtool \
	pdf pdf-am ps ps-am recheck tags tags-am uninstall \
	uninstall-am uninstall-binPROGRAMS uninstall-dist_stdlibDATA \
	uninstall-libLTLIBRARIES uninstall-man uninstall-man1

.PRECIOUS: Makefile

# generate C++ sources from syntax configs and update bootstrap files
@REBUILD_SYNTAX_TRUE@.stx.h:
@REBUILD_SYNTAX_TRUE@	$(AM_V_at)$(MKDIR_P) $(@D)
@REBUILD_SYNTAX_TRUE@	$(AM_V_GEN)$(PYTHON) $(STX2CPP) $< $@
@REBUILD_SYNTAX_TRUE@	$(AM_V_GEN)cp -f $@ $(top_srcdir)/bootstrap/$@
# copy bootstrap files
@REBUILD_SYNTAX_FALSE@.stx.h:
@REBUILD_SYNTAX_FALSE@	$(AM_V_at)$(MKDIR_P) $(@D)
@REBUILD_SYNTAX_FALSE@	$(AM_V_GEN)cp $(top_srcdir)/bootstrap/$@ $(@D)
@REBUILD_SYNTAX_FALSE@	$(AM_V_at)echo "Reconfigure with --enable-syntax to regenerate $@"

# generate lexer and update bootstrap files
@REBUILD_LEXERS_TRUE@.re.cc:
@REBUILD_LEXERS_TRUE@	$(AM_V_at)$(MKDIR_P) $(@D)
@REBUILD_LEXERS_TRUE@	$(AM_V_GEN)$(RE2C_FOR_BUILD) $(RE2CFLAGS) -o $@ $<
@REBUILD_LEXERS_TRUE@	$(AM_V_GEN)cp $(@:cc=[ch]*) $(top_srcdir)/bootstrap/$(@D)
# copy bootstrap files
@REBUILD_LEXERS_FALSE@.re.cc:
@REBUILD_LEXERS_FALSE@	$(AM_V_at)$(MKDIR_P) $(@D)
@REBUILD_LEXERS_FALSE@	$(AM_V_GEN)cp $(top_srcdir)/bootstrap/$(@:cc=*) $(@D)
@REBUILD_LEXERS_FALSE@	$(AM_V_at)echo "Reconfigure with --enable-lexers to regenerate $@"

# generate lexer and update bootstrap files
@REBUILD_PARSERS_TRUE@.ypp.cc:
@REBUILD_PARSERS_TRUE@	$(AM_V_at)$(MKDIR_P) $(@D)
@REBUILD_PARSERS_TRUE@	$(AM_V_GEN)$(BISON) --warnings --output=$@ --defines=$(@:cc=h) $<
@REBUILD_PARSERS_TRUE@	$(AM_V_GEN)cp $@ $(@:cc=h) $(top_srcdir)/bootstrap/$(@D)
# copy bootstrap files
@REBUILD_PARSERS_FALSE@.ypp.cc:
@REBUILD_PARSERS_FALSE@	$(AM_V_at)$(MKDIR_P) $(@D)
@REBUILD_PARSERS_FALSE@	$(AM_V_GEN)cp $(top_srcdir)/bootstrap/$(@:cc=*) $(@D)
@REBUILD_PARSERS_FALSE@	$(AM_V_at)echo "Reconfigure with --enable-parsers to regenerate $@"

# re2c-generated lexer depends on bison-generated parser header (generated by the parser rule)
src/parse/lexer.cc : src/parse/parser.cc
src/parse/conf_lexer.cc : src/parse/conf_parser.cc

# rebuild all re2c sources using newly built re2c
.PHONY: bootstrap
bootstrap: all
	rm $(re2c_GEN)
	$(MAKE) all

.PHONY: docs
@REBUILD_DOCS_TRUE@docs: $(DOCS) $(HELP)
@REBUILD_DOCS_TRUE@$(DOCS) $(HELP) : $(re2c_SRC_DOC_EXT) $(SPLITMAN) $(RST2MAN) $(RST2TXT)
# generate manpage
@REBUILD_DOCS_TRUE@.rst.1:
@REBUILD_DOCS_TRUE@	$(AM_V_at)$(MKDIR_P) $(@D)
@REBUILD_DOCS_TRUE@	$(AM_V_GEN)$(PYTHON) $(SPLITMAN) $(top_builddir)/$< $(top_builddir)/$< \
@REBUILD_DOCS_TRUE@		&& $(PYTHON) $(RST2MAN) --tab-width=4 $(top_builddir)/$< > $@ \
@REBUILD_DOCS_TRUE@		&& cp $@ $(top_srcdir)/bootstrap/$@
# generate help
@REBUILD_DOCS_TRUE@.rst.cc:
@REBUILD_DOCS_TRUE@	$(AM_V_at)$(MKDIR_P) $(@D)
@REBUILD_DOCS_TRUE@	$(AM_V_GEN)$(PYTHON) $(SPLITMAN) $(top_builddir)/$< $(top_builddir)/$< \
@REBUILD_DOCS_TRUE@		&& $(PYTHON) $(RST2TXT) --variable-name=help $(top_builddir)/$< $@ \
@REBUILD_DOCS_TRUE@		&& cp $@ $(top_srcdir)/bootstrap/$@
@REBUILD_DOCS_FALSE@docs: $(DOCS) $(HELP)
@REBUILD_DOCS_FALSE@	$(AM_V_at)echo "Reconfigure with --enable-docs to rebuild docs"
# copy bootstrap manpage
@REBUILD_DOCS_FALSE@.rst.1:
@REBUILD_DOCS_FALSE@	$(AM_V_at)$(MKDIR_P) $(@D)
@REBUILD_DOCS_FALSE@	$(AM_V_GEN)cp $(top_srcdir)/bootstrap/$@ $@
# copy bootstrap help
@REBUILD_DOCS_FALSE@.rst.cc:
@REBUILD_DOCS_FALSE@	$(AM_V_at)$(MKDIR_P) $(@D)
@REBUILD_DOCS_FALSE@	$(AM_V_GEN)cp $(top_srcdir)/bootstrap/$@ $@

all-local: docs $(re2c_BOOT_PARSER)
.PHONY: tests
tests: all $(re2c_TESTSUITE)
	$(PYTHON) $(top_builddir)/$(re2c_TESTSUITE)
.PHONY: vtests
vtests: all $(re2c_TESTSUITE)
	$(PYTHON) $(top_builddir)/$(re2c_TESTSUITE) --valgrind
.PHONY: wtests
wtests: all $(re2c_TESTSUITE)
	$(PYTHON) $(top_builddir)/$(re2c_TESTSUITE) --wine -j1

# lexer depends on bison-generated header
@WITH_LIBS_TRUE@lib/lex.cc: lib/parse.cc

# Tell versions [3.59,3.63) of GNU make to not export all variables.
# Otherwise a system limit (for SysV at least) may be exceeded.
.NOEXPORT:

# Tell GNU make to disable its built-in pattern rules.
%:: %,v
%:: RCS/%,v
%:: RCS/%
%:: s.%
%:: SCCS/s.%
