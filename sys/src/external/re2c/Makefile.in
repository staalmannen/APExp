all: $(BUILT_SOURCES) config.h
	$(MAKE) $(AM_MAKEFLAGS) all-recursive

.SUFFIXES:
.SUFFIXES: .1 .cc .h .lo .log .o .obj .re .rst .stx .test .test$(EXEEXT) .trs .ypp
am--refresh: Makefile
	@:
$(srcdir)/Makefile.in:  $(srcdir)/Makefile.am $(top_srcdir)/Makefile.lib.am $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      echo ' cd $(srcdir) && $(AUTOMAKE) --foreign'; \
	      $(am__cd) $(srcdir) && $(AUTOMAKE) --foreign \
		&& exit 0; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --foreign Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --foreign Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    echo ' $(SHELL) ./config.status'; \
	    $(SHELL) ./config.status;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $@ $(am__maybe_remake_depfiles);; \
	esac;
$(top_srcdir)/Makefile.lib.am $(am__empty):

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	$(SHELL) ./config.status --recheck

$(top_srcdir)/configure:  $(am__configure_deps)
	$(am__cd) $(srcdir) && $(AUTOCONF)
$(ACLOCAL_M4):  $(am__aclocal_m4_deps)
	$(am__cd) $(srcdir) && $(ACLOCAL) $(ACLOCAL_AMFLAGS)
$(am__aclocal_m4_deps):

config.h: stamp-h1
	@test -f $@ || rm -f stamp-h1
	@test -f $@ || $(MAKE) $(AM_MAKEFLAGS) stamp-h1

stamp-h1: $(srcdir)/config.h.in $(top_builddir)/config.status
	$(AM_V_at)rm -f stamp-h1
	$(AM_V_GEN)cd $(top_builddir) && $(SHELL) ./config.status config.h
$(srcdir)/config.h.in:  $(am__configure_deps) 
	$(AM_V_GEN)($(am__cd) $(top_srcdir) && $(AUTOHEADER))
	$(AM_V_at)rm -f stamp-h1
	$(AM_V_at)touch $@

distclean-hdr:
	-rm -f config.h stamp-h1
run_tests.py: $(top_builddir)/config.status $(srcdir)/run_tests.py.in
	cd $(top_builddir) && $(SHELL) ./config.status $@
src/msg/help_re2c.rst: $(top_builddir)/config.status $(top_srcdir)/doc/help.rst.in
	cd $(top_builddir) && $(SHELL) ./config.status $@
src/msg/help_re2d.rst: $(top_builddir)/config.status $(top_srcdir)/doc/help.rst.in
	cd $(top_builddir) && $(SHELL) ./config.status $@
src/msg/help_re2go.rst: $(top_builddir)/config.status $(top_srcdir)/doc/help.rst.in
	cd $(top_builddir) && $(SHELL) ./config.status $@
src/msg/help_re2hs.rst: $(top_builddir)/config.status $(top_srcdir)/doc/help.rst.in
	cd $(top_builddir) && $(SHELL) ./config.status $@
src/msg/help_re2java.rst: $(top_builddir)/config.status $(top_srcdir)/doc/help.rst.in
	cd $(top_builddir) && $(SHELL) ./config.status $@
src/msg/help_re2js.rst: $(top_builddir)/config.status $(top_srcdir)/doc/help.rst.in
	cd $(top_builddir) && $(SHELL) ./config.status $@
